<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- Root Context: defines shared resources visible to all other web components -->

	<bean id="propertyConfigurer"
		class="org.springframework.beans.factory.config.PropertyPlaceholderConfigurer">
		<property name="location" value="classpath:sdrocrest.properties" />
	</bean>

	<bean id="serviceRepository" class="org.springframework.jndi.JndiTemplate">
		<property name="environment">
			<props>
				<prop key="java.naming.factory.initial">weblogic.jndi.WLInitialContextFactory</prop>
				<prop key="java.naming.provider.url">${service.provider.url}</prop>
				<prop key="java.naming.security.principal">${service.security.principal}</prop>
				<prop key="java.naming.security.credentials">${service.security.credentials}</prop>
			</props>
		</property>
	</bean>

	<bean id="tipoObraServiceEjb"
		class="org.springframework.ejb.access.SimpleRemoteStatelessSessionProxyFactoryBean">
		<property name="jndiName"
			value="ejb/TipoObraServiceEJB#mx.gob.imss.csdiss.sdroc.service.interfaces.TipoObraService" />
		<property name="businessInterface"
			value="mx.gob.imss.csdiss.sdroc.service.interfaces.TipoObraService" />
		<property name="jndiTemplate" ref="serviceRepository" />
	</bean>

