		</dependency>

		<dependency>
			<groupId>mx.gob.imss.ctirss.delta.derechohabientes</groupId>
			<artifactId>gestionDerechohabientes-interfaces-negocio</artifactId>
			<version>${delta.derechohabientes}</version>
		</dependency>
