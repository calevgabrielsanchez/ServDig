			<groupId>mx.gob.imss.csdiss.sdroc</groupId>
			<artifactId>sdroc-interfaces</artifactId>
			<version>1.1</version>
		</dependency>
	</dependencies>

	<build>
		<finalName>${project.artifactId}-${project.version}</finalName>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.3</version>
					<configuration>
						<source>1.6</source>
						<target>1.6</target>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>2.14.1</version>
					<configuration>
						<includes>
							<include>**/*Tests.java</include>
						</includes>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<profiles>
		<!-- Perfil para aplicacion externa -->
		<profile>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<id>sin_seguridad</id>
			<properties>
				<mvn.web.app.security.start>&lt;!--</mvn.web.app.security.start>
				<mvn.web.app.security.end>--&gt;</mvn.web.app.security.end>
			</properties>
			<build>
				<finalName>sdroc_web</finalName>
			</build>
		</profile>
		<!-- Perfil para aplicacion externa - PORTAL CIUDADANO -->
		<profile>
			<id>con_seguridad</id>
			<properties>
				<mvn.web.app.security.start>
				</mvn.web.app.security.start>
				<mvn.web.app.security.end>
				</mvn.web.app.security.end>
			</properties>
			<build>
				<finalName>sdroc_web_seguridad</finalName>
			</build>
		</profile>
		<profile>
			<id>desarrollo</id>
			<activation>
				<property>
					<name>env</name>
					<value>dev</value>
				</property>
				<activeByDefault>true</activeByDefault>
			</activation>
			<properties>
				<log4j.level>ALL</log4j.level>
				<endpoint.rest.services>localhost:7001</endpoint.rest.services>
			</properties>
		</profile>
		<profile>
			<id>calidad</id>
			<activation>
				<property>
					<name>env</name>
					<value>qa</value>
				</property>
			</activation>
			<properties>
				<log4j.level>DEBBUG</log4j.level>
				<endpoint.rest.services>serviciosdigitales-stage.imss.gob.mx</endpoint.rest.services>
			</properties>
		</profile>
		<profile>
			<id>produccion</id>
			<activation>
				<property>
					<name>env</name>
					<value>prod</value>
				</property>
			</activation>
			<properties>
				<log4j.level>ERROR</log4j.level>
				<endpoint.rest.services>serviciosdigitales.imss.gob.mx</endpoint.rest.services>
			</properties>
		</profile>

	</profiles>
</project>
