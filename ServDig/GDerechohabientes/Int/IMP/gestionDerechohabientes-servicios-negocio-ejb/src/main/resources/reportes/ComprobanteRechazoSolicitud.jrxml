				<reportElement x="32" y="153" width="500" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<text><![CDATA[INFORMACIÓN GENERAL]]></text>
			</staticText>
			<staticText>
				<reportElement x="32" y="190" width="480" height="68">
					<printWhenExpression><![CDATA[$F{tipoRechazo}.equals( "otro" )]]></printWhenExpression>
				</reportElement>
				<textElement textAlignment="Justified"/>
				<text><![CDATA[Cuando el asegurado manifieste en forma directa que sus beneficiarios padres no cumplan con el requisito de convivencia o bien se determine lo anterior como resultado de la evaluación del cuestionario, se le orientará para que elabore un escrito libre dirigido al H. Consejo Consultivo Delegacional solicitando la autorización para que éstos reciban las prestaciones en especie que marca el Artículo 84 de la Ley del Seguro Social.
]]></text>
			</staticText>
			<textField>
				<reportElement x="230" y="48" width="187" height="14"/>
				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{nss} != null  ? $F{nss}.format("%s - %s", $F{nss}.substring(0, $F{nss}.length()-1), $F{nss}.charAt($F{nss}.length()-1)) : ""]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="105" y="73" width="312" height="14"/>
				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{nombre}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="32" y="190" width="479" height="73">
					<printWhenExpression><![CDATA[$F{tipoRechazo}.equals( "registro_padres" )]]></printWhenExpression>
				</reportElement>
				<textElement/>
				<text><![CDATA[Señor(a) derechohabiente los registros no fueron aceptados no pasaron el  cuestionario de requerirse deberá ser solicitado ante el H. Consejo Consultivo Delegacional. ]]></text>
			</staticText>
			<staticText>
				<reportElement x="33" y="190" width="479" height="80">
					<printWhenExpression><![CDATA[$F{tipoRechazo}.equals( "registro_concubina" )]]></printWhenExpression>
				</reportElement>
				<textElement/>
				<text><![CDATA[Señor(a) derechohabiente el registro no fue aceptado por no reunir lo que establece el artículo 84 fracción III de la LSS]]></text>
