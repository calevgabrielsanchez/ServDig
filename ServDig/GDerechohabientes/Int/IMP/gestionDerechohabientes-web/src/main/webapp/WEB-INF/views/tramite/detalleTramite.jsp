<%@ include file="../general/taglibs.jsp"%>
<jsp:include page="../general/llenaTipoTramite.jsp"></jsp:include>
<c:choose>
	<c:when test="${empty errores}">
		<script type="text/javascript" src="<spring:url value="/static/resources/derechohabiente/js/tramites.js" htmlEscape="true" />"></script>
		<script type="text/javascript" src="<spring:url value="/static/resources/js/delta/fileRead/fileRead.js" htmlEscape="true" />"></script>
		
		<c:forEach items="${solicitud.tramites}" var="tramite">
		<fieldset><legend><strong><spring:message code="label.tituloTramite" /></strong></legend>
		<div align="center">
		<table>
			<tr>
				<td align="left"><spring:message code="label.fechaTramite" />: </td>
				<td><input type="text" readonly="readonly" value="<fmt:formatDate pattern="dd/MM/yyyy" value="${tramite.fechaTramite}"/>" style="width: 180px" /></td>
				<td><br></td>
				<td align="left"><spring:message code="label.estadoTramite" />: </td>
				<td colspan="5"><input type="text" readonly="readonly" value="${tramite.estadoTramite.descripcion}" style="width: 180px" /></td>
				

			</tr>
			<tr>
				<td align="left"><spring:message code="label.tipoTramite" />: </td>
				<td colspan="4"><input type="text" readonly="readonly" value="${tramite.tipoTramite.descripcion}" style="width: 640px" /><br></td>
			</tr>
			<tr>
				<td align="left"><spring:message code="label.obsevacionTramte" />: </td>
				<td colspan="4">
					<input type="text" readonly="readonly" style="width: 640px" value="${tramite.observacion}" />
				</td>
			</tr>
			<tr>
				<td align="left"><spring:message code="label.resultadoTramite" />: </td>
				<td><input type="text" readonly="readonly" value="${tramite.resultado != null ? (tramite.resultado ? "ACEPTADO": "CANCELADO") : ""}" style="width: 180px" /></td>
				<td><br></td>
				<td align="left"><spring:message code="label.detalleResultadoTramite" />: </td>
				<td><input type="text" readonly="readonly" value="${tramite.razonResultado.descripcion}" style="width: 180px" /></td>
			</tr>
			<tr>
				<td align="left"><spring:message code="label.delegacionTramite" />: </td>
				<td><input type="text" readonly="readonly" value="${solicitud.citaSolicitud.umf.subdelegacion.delegacion.descripcion}" style="width: 180px" /></td>
				<td><br></td>
				<td align="left"><spring:message code="label.umfTramite" />: </td>
				<td colspan="3"><input type="text" readonly="readonly" value="${solicitud.citaSolicitud.umf.descripcion} - ${solicitud.citaSolicitud.umf.nombreCorto}" style="width: 180px" /></td>
			</tr>
			<tr>
				<td colspan =6>
					<input type="hidden" value="${tramite.persona.idPersona}" id="idPersona" name="idPersona">
					<input type="hidden" value="${solicitud.solicitudId}" id="idSolicitud" name="idSolicitud">
					<input type="hidden" value="${tramite.tipoTramite.idTipoTramite}" id="idTipoTramite" name="idTipoTramite">
					<input type="hidden" value="${tramite.tramiteId}" id="idTramite" name="idTramite">
					<input type="hidden" value="${solicitud.citaSolicitud.umf.idUMF}" id="umfSolicitud">
					<input type="hidden" value="${usuarioObj.idUmf}" id="umfUsuario">
					<br>
					<div id="tramite${solicitud.solicitudId}${tramite.persona.idPersona}" align="center"></div>
					<script>
						var detalleTram = new detalleTramite(${tramite.tramiteId},"tramite${solicitud.solicitudId}${tramite.persona.idPersona}",${tramite.tipoTramite.idTipoTramite},"${tramite.persona.idPersona}");
						$(document).ready(
							function() {
								detalleTram.mostrar();
							}
						);
					</script>
					<br>
					<div id="docProbTramDiv"></div>
					<script type="text/javascript">
						$(document).ready(
							function() {
								initMuestraDocumentosTramite(${tramite.tramiteId});
							}
						);
					</script>
				</td>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       