                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     			</tr>
			<tr>
				<td colspan="6" align="center">
					<br>
					<c:if test="${usuarioObj.perfilUsuario.idPerfilUsuario == 1 && tramite.estadoTramite.idEstadoTramitePersona != 2 && tramite.estadoTramite.idEstadoTramitePersona != 7  && tramite.estadoTramite.idEstadoTramitePersona != 3}">
						<c:if test="${usuarioObj.idUmf == solicitud.citaSolicitud.umf.idUMF}">
							<input id="cancelar" type="button" class="mboton" value="Cancelar Tr&aacute;mite" onclick="confirmarCancelacion(${solicitud.solicitudId});"/>
							<input id="validar" type="button" class="mboton" value="Validar Tr&aacute;mite" onclick="validarTramite(${tramite.tramiteId},${solicitud.solicitudId},${tramite.persona.idPersona != null ? tramite.persona.idPersona : 0},${tramite.tipoTramite.idTipoTramite});" />
						</c:if>
					</c:if> 
					
					<c:if test="${tramite.tipoTramite.idTipoTramite == 177 and empty solicitud.subdelegacion.id}">
						<input id="cancelar" type="button" class="mboton" value="Cancelar Tr&aacute;mite" onclick="confirmarCancelacion(${solicitud.solicitudId});" />
					</c:if>
					<c:if test="${tramite.tipoTramite.idTipoTramite == 177 && usuarioObj.cveIdSubdelegacion == solicitud.subdelegacion.id }">
						<input id="cancelar" type="button" class="mboton" value="Cancelar Tr&aacute;mite" onclick="confirmarCancelacion(${solicitud.solicitudId});" />
					</c:if>
				</td>
			</tr>
		</table>
		</div>
		</fieldset>
		</c:forEach>
	</c:when>
	<c:otherwise>
		<div class="ui-widget-content ui-corner-all">
		<div class="ui-state-error ui-corner-all" align="center">
		<p class="ui-helper-reset ui-state-error-text">
			<div class="ui-icon ui-icon-alert"></div>
			<spring:message code="${errores}" />
		</p>
		</div>
		</div>
	</c:otherwise>
</c:choose>
