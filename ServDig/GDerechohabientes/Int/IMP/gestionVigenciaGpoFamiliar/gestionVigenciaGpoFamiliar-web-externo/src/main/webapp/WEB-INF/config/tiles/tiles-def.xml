		<put-attribute name="pie" value="/WEB-INF/views/layout/pie.jsp" />
	</definition>

	<!-- Definicion de la pantalla HOME de la aplicacion -->
	<definition name="home" extends="base.definition">
		<put-attribute name="menu" value="" />
