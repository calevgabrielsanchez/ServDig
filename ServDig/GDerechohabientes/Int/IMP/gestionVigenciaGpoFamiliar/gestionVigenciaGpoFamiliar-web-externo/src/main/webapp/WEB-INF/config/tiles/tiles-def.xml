	<definition name="wizard.base.definition" template="/WEB-INF/views/layout/main-wizard.jsp">
		<put-attribute name="title" value="Consulta de 2do y 3er nivel" />
		<put-attribute name="pie"
			value="/WEB-INF/views/layout/pie-empty.jsp" />
	</definition>

	<definition name="tramiteDummyInicio" extends="wizard.base.definition">
		<put-attribute name="contenido" value="/WEB-INF/views/wizard/dummy/inicial.jsp" />
	</definition>

	<definition name="tramiteDummyContenido" extends="wizard.base.definition">
		<put-attribute name="contenido" value="/WEB-INF/views/wizard/dummy/contenido.jsp" />
	</definition>

	<!-- Definiciones de los errores en genertal -->
	<definition name="error" extends="base.definition">
		<put-attribute name="contenido" value="/WEB-INF/views/error/error.jsp" />
	</definition>

	<definition name="databaseError" extends="base.definition">
