		<put-attribute name="subencabezado" value="/WEB-INF/views/layout/sub-encabezado.jsp" />
		<put-attribute name="pie" value="/WEB-INF/views/layout/pie.jsp" />
	</definition>

	<definition name="base.definition" template="/WEB-INF/views/layout/main.jsp">
		<put-attribute name="title" value="Consulta de 2do y 3er nivel" />
