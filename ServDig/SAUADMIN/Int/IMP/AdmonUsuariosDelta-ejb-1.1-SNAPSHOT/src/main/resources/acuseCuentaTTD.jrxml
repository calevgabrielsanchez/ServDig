	<columnHeader>
		<band height="897" splitType="Stretch">
			<textField>
				<reportElement x="0" y="97" width="512" height="83"/>
				<textElement textAlignment="Justified">
					<font fontName="SansSerif"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["El que suscribe "+ $P{nombreUsuario} + ",  CURP "+ $P{curp} +" y adscrito a "+ $P{deptodesc} +" por este conducto manifiesto la aceptación, recepción y conocimiento de la responsabilidad, salvaguarda y uso correcto de la Clave de Usuario "+ $P{user} +", asignados a mi persona, la cual tiene acceso a sistemas institucionales e información confidencial. Misma que fue autorizada por "+ $P{aprobador}+"."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="112" y="53" width="292" height="18"/>
