				<textFieldExpression class="java.lang.String"><![CDATA[$P{lugarFecha}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="16" y="525" width="212" height="20"/>
				<box>
					<topPen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Center"/>
				<text><![CDATA[Firma del Trabajador]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="593" width="94" height="17"/>
