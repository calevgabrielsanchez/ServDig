<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd">

<log4j:configuration xmlns:log4j="http://jakarta.apache.org/log4j/" debug="false">

    <appender name="console" class="org.apache.log4j.ConsoleAppender">
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern"
                value="[%p] [%d{dd-MM-yy HH:mm:ss}] %c{2}.%M(%L): %m%n"/>
        </layout>
    </appender>
    
    <logger name="cliente.webservices">
        <level value="${mvn.log.level.info}"/>
        <appender-ref ref="console"/>        
    </logger>

    <logger name="org.apache">
        <level value="${mvn.log.level.warn}"/>
    </logger>

	<logger name="org.eclipse.jetty">
		<level value="${mvn.log.level.warn}" />
	</logger>

	<logger name="org.cometd">
		<level value="${mvn.log.level.warn}" />
	</logger>
    
    <logger name="javax">
        <level value="${mvn.log.level.info}"/>
    </logger>
    
    <logger name="org.hibernate">
        <level value="${mvn.log.level.warn}"/>
    </logger>
    
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder">
        <level value="${mvn.log.level.trace}"/>
    </logger>
    
    <logger name="gob.imss">
        <level value="${mvn.log.level.debug}"/>
    </logger>
    
    <root>
        <level value="${mvn.log.level.warn}"/>
        <appender-ref ref="console"/>
    </root>

</log4j:configuration>
