<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>


	<groupId>mx.gob.imss.ctirss.delta.ietc</groupId>
	<artifactId>ietc-packing</artifactId>
	<version>2.0</version>
	
	<name>Modulo Empaquetador de Servicios de gestionCobranza DELTA</name>
	<url>http://deltadev.imss.gob.mx/gestionCobranza-web</url>
	<packaging>ear</packaging>


	<dependencies>
		<!-- INICIO DE LAS DEPENDENCIAS DEL FRAMEWORK DELTA -->
		
		
		<dependency>
			<groupId>mx.gob.imss.ctirss.delta.ietc</groupId>
			<artifactId>ietc-servicios-negocio-ejb</artifactId>
			<version>1.0</version>
			<type>ejb</type>
		</dependency>
		<!-- FIN DE LAS DEPENDENCIAS DEL FRAMEWORK DELTA -->

			</dependencies>

	<repositories>
		<repository>
			<id>ctirss</id>
			<name>CTIRSS repository</name>
			<layout>default</layout>
			<url>http://172.16.5.134:8080/repository/repo/</url>
			<snapshots>
			</snapshots>
		</repository>
	</repositories>

	<pluginRepositories>
		<pluginRepository>
			<id>ctirss</id>
			<name>CTIRSS repository</name>
			<url>http://172.16.5.134:8080/repository/repo/</url>
			<layout>default</layout>
			<snapshots>
			</snapshots>
			<releases>
				<updatePolicy>never</updatePolicy>
			</releases>
		</pluginRepository>
	</pluginRepositories>
	
	<distributionManagement>
		<!-- use the following if you're not using a snapshot version. -->
		<repository>
			<id>ctirss-archiva</id>
			<name>CTIRSS Repository Name</name>
			<url>dav:http://172.16.5.134:8080/repository/repo/</url>
		</repository>
		<snapshotRepository>
			<id>ctirss-archiva</id>
			<name>CTIRSS Repository Name</name>
			<url>dav:http://172.16.5.134:8080/repository/repo/</url>
		</snapshotRepository>
	</distributionManagement>

	<scm>
		<connection>scm:svn:http://11.254.16.21/svn/base_arquitectura_delta/codigo/trunk/gestion_domicilios/</connection>
		<developerConnection>scm:svn:http://11.254.16.21/svn/base_arquitectura_delta/codigo/trunk/gestion_domicilios/</developerConnection>
		<url>http://11.254.16.21/svn/base_arquitectura_delta/codigo/trunk/gestion_domicilios/</url>
	</scm>
	

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>2.3.2</version>
				<configuration>
					<source>1.6</source>
					<target>1.6</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-ear-plugin</artifactId>
				<version>2.6</version>
				<configuration>
					<version>5</version>
					<defaultLibBundleDir>lib</defaultLibBundleDir>
				</configuration>
			</plugin>

			<!-- Habilita los facets y natures para que el eclipse reconoza el proyecto 
				como de tipo de EAR. -->
			<plugin>
				<artifactId>maven-eclipse-plugin</artifactId>
				<configuration>
					<additionalBuildcommands>
						<buildCommand>
							<name>org.eclipse.jdt.core.javabuilder</name>
						</buildCommand>
						<buildCommand>
							<name>org.eclipse.wst.common.project.facet.core.builder</name>
						</buildCommand>
						<buildCommand>
							<name>org.eclipse.wst.validation.validationbuilder</name>
						</buildCommand>
			
					</additionalBuildcommands>
					<additionalProjectnatures>
						<projectnature>org.eclipse.wst.common.project.facet.core.nature</projectnature>
						<projectnature>org.eclipse.jdt.core.javanature</projectnature>
						<projectnature>org.eclipse.wst.common.modulecore.ModuleCoreNature</projectnature>
						<projectnature>org.eclipse.jem.workbench.JavaEMFNature</projectnature>
					</additionalProjectnatures>
					<additionalConfig>
						<file>
							<name>.settings/org.eclipse.wst.common.project.facet.core.xml</name>
							<content>&lt;faceted-project&gt;
									&lt;runtime name="Weblogic Runtime" /&gt;
									&lt;fixed facet="jst.ear" /&gt;
									
									
									&lt;installed facet="jst.ear" version="5.0" /&gt;
									&lt;installed facet="wls.ear" version="10.3.4" /&gt;
								&lt;/faceted-project&gt;</content>
						</file>
						<file>
							<name>.settings/org.eclipse.wst.common.component</name>
							<content>&lt;project-modules id="moduleCoreId" project-version="1.5.0"&gt;
									&lt;wb-module deploy-name="${project.artifactId}"&gt;
										&lt;wb-resource deploy-path="/" source-path="/src/main/java" /&gt;
										&lt;wb-resource deploy-path="/" source-path="/src/main/resources" /&gt;
										&lt;property name="java-output-path" value="target/classes" /&gt;
									&lt;/wb-module&gt;
								&lt;/project-modules&gt;</content>
						</file>
					</additionalConfig>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
