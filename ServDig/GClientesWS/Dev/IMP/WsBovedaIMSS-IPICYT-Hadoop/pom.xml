 <repositories>

	<repository>
		      <id>ctirss</id>
		      <name>CTIRSS repository</name>
		      <layout>default</layout>
		      <url>http://172.16.5.134:8080/repository/repo/</url>
		      <snapshots>
		        <enabled>true</enabled>
		      </snapshots>
	</repository>
	
	<repository>
		<id>maven2-repository.dev.java.net</id>
		<name>Java.net Repository for Maven</name>
		<url>http://download.java.net/maven/2</url>
	</repository>
</repositories>

<pluginRepositories>
  	  <pluginRepository>
    	  <id>ctirss</id>
    	  <name>CTIRSS repository</name>
    	  <url>http://172.16.5.134:8080/repository/repo/</url>
    	  <layout>default</layout>
    	  <snapshots> </snapshots>
    	  <releases>
    	    <updatePolicy>never</updatePolicy>
    	  </releases>
   	 </pluginRepository>
</pluginRepositories>

	<profiles>
		<profile>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
			<id>compile-qa</id>
			<properties>
				<mvn.ws.client.version>1.0-QA</mvn.ws.client.version>
				<mvn.servicios.externos.rest.timeOut.connection>5000</mvn.servicios.externos.rest.timeOut.connection>
				<mvn.servicios.externos.rest.timeOut.response>30000</mvn.servicios.externos.rest.timeOut.response>
				<mvn.servicios.externos.rest.url.consulta.boveda>http://msbhimss-alfrescofacade.apps.qaocp.imss.gob.mx/alfresco-ws-1.0/consultaEstatusDoc</mvn.servicios.externos.rest.url.consulta.boveda>
			</properties>
			<build>
				<plugins>
					<plugin>
						<artifactId>maven-antrun-plugin</artifactId>
						<executions>
							<execution>
								<phase>prepare-package</phase>
								<configuration>
									<tasks>
										<replace token="${mvn.url.ws}" value="http://msbhimss-alfrescofacade.apps.qaocp.imss.gob.mx" dir="target/classes">
											<include name="**/*.wsdl" />
										</replace>
									</tasks>
								</configuration>
								<goals>
									<goal>run</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>compile-prod</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<properties>
				<mvn.ws.client.version>1.0</mvn.ws.client.version>
				<mvn.servicios.externos.rest.timeOut.connection>5000</mvn.servicios.externos.rest.timeOut.connection>
				<mvn.servicios.externos.rest.timeOut.response>30000</mvn.servicios.externos.rest.timeOut.response>
				<mvn.servicios.externos.rest.url.consulta.boveda>http://msbhimss-alfrescofacade.apps.ocp.imss.gob.mx/alfresco-ws-1.0/consultaEstatusDoc</mvn.servicios.externos.rest.url.consulta.boveda>
			</properties>
			<build>
				<plugins>
					<plugin>
						<artifactId>maven-antrun-plugin</artifactId>
						<executions>
							<execution>
								<phase>prepare-package</phase>
								<configuration>
									<tasks>
										<replace token="${mvn.url.ws}" value="http://msbhimss-alfrescofacade.apps.ocp.imss.gob.mx" dir="target/classes">
											<include name="**/*.wsdl" />
										</replace>
									</tasks>
								</configuration>
								<goals>
									<goal>run</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>