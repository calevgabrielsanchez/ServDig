<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
 
 <groupId>mx.gob.imss.ctirss.delta.gestion.medio.contacto</groupId>
 <artifactId>gestionMediosContacto</artifactId>
 <packaging>pom</packaging>
 <version>2.3-SNAPSHOT</version> 
 <name>Modulo  Delta de Gestion de Medios de contacto  IMSS</name>
  <url>http://11.254.14.212/gestionMedios</url>
  
  
  <properties>
		<project.build.sourceEncoding>iso-8859-1</project.build.sourceEncoding>
		<mx.gob.imss.ctirss.version.parent>1.0.5</mx.gob.imss.ctirss.version.parent>
		<org.slf4j.version>1.6.1</org.slf4j.version>
		<org.springframework.version>3.1.0.RELEASE</org.springframework.version>
		<org.hibernate.version>3.6.9.Final</org.hibernate.version>

		<delta.framework.version>2.6-SNAPSHOT</delta.framework.version>
		<delta.framework.comboSelect>2.0-SNAPSHOT</delta.framework.comboSelect>
		<delta.medioscontacto>2.3-SNAPSHOT</delta.medioscontacto>
		<delta.domicilios>2.4-SNAPSHOT</delta.domicilios>
		<delta.solicitud>2.2-SNAPSHOT</delta.solicitud>
		<imssdigital.modelo>2.6-SNAPSHOT</imssdigital.modelo>
	</properties>
  
  
  <build>
  
  
  
  
  <!-- To define the plugin version in your parent POM -->
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>3.0</version>
        </plugin>
		<plugin>
		  <groupId>org.apache.maven.plugins</groupId>
		  <artifactId>maven-surefire-plugin</artifactId>
		    <configuration>
			<skipTests>true</skipTests>
		  </configuration>
		</plugin>
      </plugins>
    </pluginManagement>
  
 
  
  	<plugins>
  	
  	
  
  	
    	<!-- for use JVM 1.6 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <source>1.6</source>
          <target>1.6</target>
        </configuration>
      </plugin>
      
      
    <!-- Relase Plugin-->
		<plugin>
        	<groupId>org.apache.maven.plugins</groupId>
        	<artifactId>maven-release-plugin</artifactId>
	        <version>2.3.2</version>
    	    <configuration>
        		<tagBase>http://11.254.16.21/svn/base_arquitectura_delta/codigo/tags/</tagBase>
		        <tag>${project.artifactId}-${project.version}</tag>          	   
        	</configuration>
    	</plugin>
    	
      
      
    </plugins>
    
    
    
    
    
    <extensions>
			<extension>
				<groupId>org.apache.maven.wagon</groupId>			
				<artifactId>wagon-ftp</artifactId>
			</extension>
			<extension>
				<groupId>org.apache.maven.wagon</groupId>			
				<artifactId>wagon-webdav</artifactId>
			</extension>
		</extensions>
    
    
    
  </build>

  <repositories>
  	<repository>
  		<id>ctirss</id>
  		<name>CTIRSS repository</name>
  		<layout>default</layout>
  		<url>http://172.16.5.134:8080/repository/repo/</url>
  		<snapshots>
  			<enabled>true</enabled>
  		</snapshots>
  	</repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>ctirss</id>
      <name>CTIRSS repository</name>
      <url>http://172.16.5.134:8080/repository/repo/</url>
      <layout>default</layout>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <releases>
        <updatePolicy>never</updatePolicy>
      </releases>
    </pluginRepository>
  </pluginRepositories>

<distributionManagement>
  <repository>
    <id>ctirss-archiva</id>
    <name>CTIRSS Repository Name</name>
    <url>dav:http://172.16.5.134:8080/repository/repo/</url>
    
  </repository>
    
  <snapshotRepository>
    <id>ctirss-archiva</id>
    <name>CTIRSS Repository Name</name>
        <url>dav:http://172.16.5.134:8080/repository/repo/</url>
  </snapshotRepository>

</distributionManagement>
	<scm>
			  <connection>scm:svn:http://11.254.16.21/svn/base_arquitectura_delta/codigo/tags/gestionMediosContacto-1.0-SNAPSHOT</connection>
			  <developerConnection>scm:svn:http://11.254.16.21/svn/base_arquitectura_delta/codigo/tags/gestionMediosContacto-1.0-SNAPSHOT</developerConnection>
			  <url>http://11.254.16.21/svn/base_arquitectura_delta/codigo/tags/gestionMediosContacto-1.0-SNAPSHOT</url>
	</scm>
   
  <modules>
    <module>gestionMediosContacto-interfaces-negocio</module>
    <module>gestionMediosContacto-servicios-negocio-ejb</module>
    <module>gestionMediosContacto-web</module>
    <module>gestionMediosContacto-packing</module>
  </modules>
</project>
