				<textElement textAlignment="Justified"/>
				<textFieldExpression class="java.lang.String"><![CDATA["Mediante el presente se hace constar el registro y trámite de la solicitud de publicación vía estrado electrónico,  la cual será publicada en la página de este Instituto www.imss.gob.mx  el día "+$P{fecPublicacion}+" y retirada el día " +$P{fecRetiroPublicacion}+", correspondiente a:"]]></textFieldExpression>
