	<groupId>estrados</groupId>
	<artifactId>estrados</artifactId>
	<packaging>pom</packaging>
	<version>1.0</version>
	<name>Modulo IMSS</name>
	<url>http://www.imss.gob.mx/instituto/Directorio/ctirss.htm</url>

