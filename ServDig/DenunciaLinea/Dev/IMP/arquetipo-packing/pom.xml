<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>mx.imss.ctirss</groupId>
		<artifactId>denuncia</artifactId>
		<version>1.0-SNAPSHOT</version>
	</parent>

	<groupId>mx.imss.ctirss.packing</groupId>
	<artifactId>denuncia-packing</artifactId>
	<version>1.0-SNAPSHOT</version>
	<packaging>ear</packaging>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<org.slf4j.version>1.6.1</org.slf4j.version>
		<bea.modules.home>/Users/vaguirre/Java/bea-modules</bea.modules.home>
	</properties>


	<dependencies>

		<!-- Dependencia del Framework del IMSS -->
		<dependency>
			<groupId>mx.imss.ctirss.framework</groupId>
			<artifactId>denuncia-framework-base</artifactId>
			<version>1.0-SNAPSHOT</version>
			<type>jar</type>
		</dependency>
		<!-- Dependencia del Proyecto de Models -->
		<dependency>
			<groupId>mx.imss.ctirss.pojo</groupId>
			<artifactId>denuncia-model-business-pojo</artifactId>
			<version>1.0-SNAPSHOT</version>

			<type>jar</type>
		</dependency>

		<!-- Dependencia de las Interfaces de Negocio -->

		<dependency>
			<groupId>mx.imss.ctirss.interface</groupId>
			<artifactId>denuncia-service-business-interface</artifactId>
			<version>1.0-SNAPSHOT</version>
			<type>jar</type>
		</dependency>



		<!-- Dependencia del EJB -->

		<dependency>
			<groupId>mx.imss.ctirss.ejb</groupId>
			<artifactId>denuncia-service-business-ejb</artifactId>
			<version>1.0-SNAPSHOT</version>
			<type>ejb</type>
		</dependency>
        <dependency> 
            <groupId>mx.gob.imss.ctirss.delta</groupId>
            <artifactId>delta-servicios-negocio-ejb</artifactId>
            <version>1.6.0-SNAPSHOT</version>
            <type>ejb</type>
           
        </dependency>
         
        <dependency>
            <groupId>mx.gob.imss.ctirss.delta.gestion.domicilio</groupId>
            <artifactId>gestionDomicilios-servicios-negocio-ejb</artifactId>
            <version>1.3-SNAPSHOT</version>
            <type>ejb</type>
            <exclusions>
            	<exclusion>
            		<artifactId>delta-persistencia</artifactId>
            		<groupId>mx.gob.imss.ctirss.delta</groupId>
            	</exclusion>
            </exclusions>
        </dependency>

	</dependencies>

	<build>
	<finalName>${project.artifactId}</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>2.3.2</version>
				<configuration>
					<source>1.6</source>
					<target>1.6</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-ear-plugin</artifactId>
				<version>2.6</version>
				<configuration>
					<version>5</version>
					<defaultLibBundleDir>lib</defaultLibBundleDir>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>