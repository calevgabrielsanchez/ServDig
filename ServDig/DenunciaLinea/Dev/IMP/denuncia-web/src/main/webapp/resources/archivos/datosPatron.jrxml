	<subDataset name="diversosPatrones">
		<parameter name="numFolioDenuncia" class="java.lang.String"/>
		<queryString>
			<![CDATA[select p.DES_NOMRAZONSOCIAL as nombre,
       p.DES_RFC as rfc,
       d.DOM_GEOG as domicilio
from DLT_DENUNCIA den, DLT_DATOSPATRON p, DG_DOMICILIO_GEOGRAFICO d
where
den.num_foliodenuncia=$P{numFolioDenuncia}
and den.CVE_FOLIODENUNCIA=p.CVE_FOLIODENUNCIA(+)
and p.DOMICILIO_ID=d.DOMICILIO_ID(+)]]>
		</queryString>
		<field name="NOMBRE" class="java.lang.String"/>
		<field name="RFC" class="java.lang.String"/>
		<field name="DOMICILIO" class="java.lang.String"/>
	</subDataset>
	<parameter name="rutaImagen" class="java.lang.String">
		<defaultValueExpression><![CDATA["C:\\Mis Documentos\\projects\\denunciaEnLinea\\denuncia-web\\src\\main\\webapp\\resources\\images\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="numFolioDenuncia" class="java.lang.String"/>
	<parameter name="rutaReporte" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
        ptrn.des_nomrazonsocial as nombre,
        ptrn.num_telefono as "telefono",
        d.nomvial as "calle",
        d.numextnum as "numExt",
        d.numintnum as "numInt",
        l.nom_loc as "colonia",
        cp.codigo as "cp",
        m.nom_mun as "delegacion",
        e.nom_ent as "estado",--dg_cat_estado
        ptrn.des_nomreplegal as "representanteLegal",
        --ptrn.actividad as "actividad",
        null as "actividad",
        --ptrn.sector as "sector",
        null as "sector",

        ptrn.num_telefono as "telefonoF",
        d.nomvial as "calleF",
        d.numextnum as "numExtF",
        d.numintnum as "numIntF",
        l.nom_loc as "coloniaF",
        cp.codigo as "cpF",
        m.nom_mun as "delegacionF",
        e.nom_ent as "estadoF",
        ptrn.NUM_TRABAJADORES as "numTrab",
        null as "diversosPatrones"

        from dlt_denuncia den, dlt_datospatron ptrn, dg_domicilio_geografico d,  dg_cat_localidad l, dg_codigos_postales cp,
dg_cat_municipio m, dg_cat_estado e
where
den.num_foliodenuncia=$P{numFolioDenuncia}
and den.CVE_FOLIODENUNCIA= ptrn.CVE_FOLIODENUNCIA(+)
and ptrn.DOMICILIO_ID = d.DOMICILIO_ID(+)
and d.CODIGO = cp.CODIGO(+)
 and d.CVE_ENT = m.CVE_ENT(+)
and d.CVE_ENT = e.cve_ent(+)
and d.CVE_LOC = l.CVE_LOC(+)]]>
	</queryString>
	<field name="nombre" class="java.lang.String"/>
	<field name="telefono" class="java.lang.String"/>
	<field name="calle" class="java.lang.String"/>
	<field name="numExt" class="java.lang.String"/>
	<field name="numInt" class="java.lang.String"/>
	<field name="colonia" class="java.lang.String"/>
	<field name="cp" class="java.lang.String"/>
