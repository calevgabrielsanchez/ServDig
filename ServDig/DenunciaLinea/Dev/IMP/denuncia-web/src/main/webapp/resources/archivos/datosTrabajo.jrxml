	<subDataset name="comprobantePago">
		<parameter name="numFolioDenuncia" class="java.lang.String"/>
		<queryString>
			<![CDATA[select tfp.DESC_FORMAPAGO
from DLT_DENUNCIA den, dlt_infotrabajo t, dlt_formapago fp, dlc_tiposformapago tfp
where

den.num_foliodenuncia=$P{numFolioDenuncia}
and tfp.cve_concepto=2
and den.CVE_FOLIODENUNCIA=t.CVE_FOLIODENUNCIA(+)
and t.cve_infotrabajo=fp.cve_infotrabajo(+)
and fp.cve_formapago=tfp.cve_formapago(+)]]>
		</queryString>
		<field name="DESC_FORMAPAGO" class="java.lang.String"/>
	</subDataset>
	<subDataset name="formaPago">
		<parameter name="numFolioDenuncia" class="java.lang.String"/>
		<queryString>
			<![CDATA[select tfp.DESC_FORMAPAGO
from DLT_DENUNCIA den, dlt_infotrabajo t, dlt_formapago fp, dlc_tiposformapago tfp
where

den.num_foliodenuncia=$P{numFolioDenuncia}
and tfp.cve_concepto=3
and den.CVE_FOLIODENUNCIA=t.CVE_FOLIODENUNCIA(+)
and t.cve_infotrabajo=fp.cve_infotrabajo(+)
and fp.cve_formapago=tfp.cve_formapago(+)]]>
		</queryString>
		<field name="DESC_FORMAPAGO" class="java.lang.String"/>
	</subDataset>
	<subDataset name="identificacionAdjunta">
		<parameter name="numFolioDenuncia" class="java.lang.String"/>
		<queryString>
			<![CDATA[select td.DES_DOCUMENTO
from DLT_DENUNCIA den, dlt_persona p, dlc_tipodocumento td
where

den.num_foliodenuncia=$P{numFolioDenuncia}
and den.CVE_FOLIODENUNCIA=p.CVE_FOLIODENUNCIA(+)
and p.cve_tipodocumento=td.cve_tipodocumento(+)]]>
		</queryString>
		<field name="DES_DOCUMENTO" class="java.lang.String"/>
	</subDataset>
	<subDataset name="formaPagoAdjuntos">
		<parameter name="numFolioDenuncia" class="java.lang.String"/>
		<queryString>
			<![CDATA[select fp.ref_documento
from DLT_DENUNCIA den, dlt_infotrabajo t, dlt_formapago fp
where

den.num_foliodenuncia=$P{numFolioDenuncia}
and den.CVE_FOLIODENUNCIA=t.CVE_FOLIODENUNCIA(+)
and t.cve_infotrabajo=fp.cve_infotrabajo(+)]]>
		</queryString>
		<field name="REF_DOCUMENTO" class="java.lang.String"/>
	</subDataset>
	<parameter name="numFolioDenuncia" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
        t.fec_fechaInicio as "fecIni",
        t.fec_fechafin as "fecTer",
        t.des_laboresdesemp as "labores",
        t.des_nomjefeinmediato as "jefeInmediato",
        t.des_numcontrato as "contrato",
        t.des_horariolabores as "horario",
        t.imp_salariopercibido as "salario",
        t.imp_vacaciones as "vacaciones",
        t.num_diasvacaciones as "diasVacaciones",--dg_cat_estado
        null as "salarioReal",
        t.imp_aguinaldo as "aguinaldo",
        null as "diasAguinaldo",

  tfp.desc_formapago as "periodoPago",
        null as "gratificacion",
        t.imp_comision_otros as "comisiones",
        null as "otorgamiento",
        null as "riesgoTrabajo",
        t.fec_fechariesgotrab as "fecRiesgo",
        t.des_observaciones as "observaciones"


        from dlt_denuncia den, dlt_infotrabajo t, dlt_formapago fp, DLC_TIPOSFORMAPAGO tfp
where
den.num_foliodenuncia = $P{numFolioDenuncia}
and fp.cve_concepto=1
and den.CVE_FOLIODENUNCIA= t.CVE_FOLIODENUNCIA(+)
and t.cve_infotrabajo = fp.cve_infotrabajo(+)
and fp.cve_formapago = tfp.cve_formapago(+)]]>
	</queryString>
