	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="48"/>
	<parameter name="numeroDenuncia" class="java.lang.String"/>
	<parameter name="numFolioDenuncia" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
        p.des_nombre || ' ' || p.des_paterno || ' ' || p.des_materno as "nombreD",--dlt_persona
        p.cve_tipodenunciante as "calidadDenuncia",
        p.cve_rfc as "rfcD",
        p.cve_curp as "curpD",
        p.num_telefono as "telefonoD",
        d.nomvial as "domicilioD",
        d.numextnum as "numeroD",
        d.numintnum as "interiorD",
         l.nom_loc as "coloniaD",
         cp.codigo as "cpD",
          m.nom_mun as "delegacionD",
           v.nom_via as "callesD"

from dlt_denuncia den, DLT_PERSONA p, dg_domicilio_geografico d,  dg_cat_localidad l, dg_codigos_postales cp,
dg_cat_municipio m, dg_vialidad v
where den.CVE_FOLIODENUNCIA = $P{numeroDenuncia}
    and p.CVE_TIPODENUNCIANTE between 2 and 3
    and den.CVE_FOLIODENUNCIA = p.CVE_FOLIODENUNCIA(+)
    and p.DOMICILIO_ID = d.DOMICILIO_ID(+)
    and d.CVE_LOC = l.CVE_LOC(+)
    and d.CODIGO = cp.CODIGO(+)
    and d.CVE_ENT = m.CVE_ENT(+)
    and d.CVE_VIA_PRIN = v.CVE_VIA(+)]]>
	</queryString>
	<field name="nombreD" class="java.lang.String"/>
	<field name="calidadDenuncia" class="java.math.BigDecimal"/>
	<field name="rfcD" class="java.lang.String"/>
	<field name="curpD" class="java.lang.String"/>
