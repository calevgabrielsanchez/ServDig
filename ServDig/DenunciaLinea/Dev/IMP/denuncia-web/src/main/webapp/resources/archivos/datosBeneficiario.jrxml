<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="datosBeneficiario" pageWidth="555" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="numFolioDenuncia" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
        p.des_nombre || ' ' || p.des_paterno || ' ' || p.des_materno as nombre,
        p.num_telefono as "telefono",
        d.nomvial as "calle",
        d.numextnum as "numExt",
        d.numintnum as "numInt",
        l.nom_loc as "colonia",
        cp.codigo as "cp",
        m.nom_mun as "delegacion",
        e.nom_ent as "estado",--dg_cat_estado
        tdoc.des_documento as "documentoOficial",
        null as "noDoc"
        from dlt_denuncia den, DLT_PERSONA p, dg_domicilio_geografico d,  dg_cat_localidad l, dg_codigos_postales cp,
dg_cat_municipio m, dg_cat_estado e, dlc_tipodocumento tdoc
where
den.num_foliodenuncia=$P{numFolioDenuncia}
and den.CVE_FOLIODENUNCIA= p.CVE_FOLIODENUNCIA(+)
and p.CVE_TIPODOCUMENTO = tdoc.cve_tipodocumento(+)
and p.CVE_TIPODENUNCIANTE = 2
and p.DOMICILIO_ID = d.DOMICILIO_ID(+)
and d.CODIGO = cp.CODIGO(+)
 and d.CVE_ENT = m.CVE_ENT(+)
and d.CVE_ENT = e.cve_ent(+)
and d.CVE_LOC = l.CVE_LOC(+)]]>
	</queryString>
	<field name="nombre" class="java.lang.String"/>
	<field name="telefono" class="java.lang.String"/>
	<field name="calle" class="java.lang.String"/>
	<field name="numExt" class="java.lang.String"/>
	<field name="numInt" class="java.lang.String"/>
	<field name="colonia" class="java.lang.String"/>
	<field name="cp" class="java.lang.String"/>
	<field name="delegacion" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="documentoOficial" class="java.lang.String"/>
	<field name="noDoc" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<pageFooter>
		<band splitType="Stretch"/>
	</pageFooter>
