<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
	xmlns:tns="http://www.serviciosdigitales.imss.gob.mx/servicioTimbrado/"
	xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	name="servicioTimbrado" targetNamespace="http://www.serviciosdigitales.imss.gob.mx/servicioTimbrado/"
	xmlns:xsd1="http://www.mx.gob.imss.ctirss.delta.cobranza">
	
	<wsdl:types>
		
		<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
			<xsd:import namespace="http://www.mx.gob.imss.ctirss.delta.cobranza"
				schemaLocation="pago.xsd">
			</xsd:import>
		</xsd:schema>
	</wsdl:types>
	
	<wsdl:message name="timbrarPagoRequest">
		<wsdl:part name="pagoInput"
			type="xsd1:PagoType" />
	</wsdl:message>
	<wsdl:message name="timbrarPagoResponse">
		<wsdl:part name="pagoOutput"
			type="xsd1:PagoType" />
	</wsdl:message>
	
	<wsdl:portType name="servicioTimbrado">
		<wsdl:operation name="timbrarPago">
			<wsdl:input message="tns:timbrarPagoRequest" />
			<wsdl:output message="tns:timbrarPagoResponse" />
		</wsdl:operation>
	</wsdl:portType>
	
	<wsdl:binding name="servicioTimbradoSOAP" type="tns:servicioTimbrado">
		<soap:binding style="document"
			transport="http://schemas.xmlsoap.org/soap/http" />
		<wsdl:operation name="timbrarPago">
			<soap:operation
				soapAction="http://www.serviciosdigitales.imss.gob.mx/servicioTimbrado/timbrarPago" />
			<wsdl:input>
				<soap:body use="literal" />
			</wsdl:input>
			<wsdl:output>
				<soap:body use="literal" />
			</wsdl:output>
		</wsdl:operation>
	</wsdl:binding>
	
	<wsdl:service name="servicioTimbrado">
		<wsdl:port binding="tns:servicioTimbradoSOAP" name="servicioTimbradoSOAP">
			<soap:address location="http://www.example.org/" />
		</wsdl:port>
	</wsdl:service>
</wsdl:definitions>
