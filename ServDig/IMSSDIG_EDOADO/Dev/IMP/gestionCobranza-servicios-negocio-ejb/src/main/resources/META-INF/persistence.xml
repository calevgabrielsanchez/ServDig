<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.0" xmlns="http://java.sun.com/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/persistence http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd">
	<persistence-unit name="gestionCobPersistenceUnit" transaction-type="JTA">
		<provider>org.hibernate.ejb.HibernatePersistence</provider>
		<jta-data-source>jdbc/delta</jta-data-source> 
		
		<class>mx.gob.imss.ctirss.delta.cobranza.service.entities.DCopActividadesEconomica</class>
		<class>mx.gob.imss.ctirss.delta.cobranza.service.entities.DCopDelegacion</class>
		<class>mx.gob.imss.ctirss.delta.cobranza.service.entities.DCopFactor</class>
		<class>mx.gob.imss.ctirss.delta.cobranza.service.entities.DCopFactorPK</class>
		<class>mx.gob.imss.ctirss.delta.cobranza.service.entities.DCopMovimientosPatronale</class>
		<class>mx.gob.imss.ctirss.delta.cobranza.service.entities.DCopPatrone</class>
		<class>mx.gob.imss.ctirss.delta.cobranza.service.entities.DCopPatronePK</class>
		<class>mx.gob.imss.ctirss.delta.cobranza.service.entities.DCopSubdelegacion</class>
		<class>mx.gob.imss.ctirss.delta.cobranza.service.entities.DCopSubdelegacionPK</class>
		<class>mx.gob.imss.ctirss.delta.cobranza.service.entities.DrtFecCierrOpCob</class>
		<class>mx.gob.imss.ctirss.delta.cobranza.service.entities.HCopCreditosTot</class>
		<class>mx.gob.imss.ctirss.delta.cobranza.service.entities.HCopCreditosTotPK</class>
		<class>mx.gob.imss.ctirss.delta.cobranza.service.entities.HRcvCreditosTot</class>
		<class>mx.gob.imss.ctirss.delta.cobranza.service.entities.HRcvCreditosTotPK</class>
		<properties>
			<property name="hibernate.query.factory_class"
				value="org.hibernate.hql.classic.ClassicQueryTranslatorFactory" />
			<property name="hibernate.dialect" value="org.hibernate.dialect.Oracle10gDialect" />
			<property name="hibernate.show_sql" value="true" />
			<property name="hibernate.format_sql" value="true" />
			<property name="hibernate.use_sql_comments" value="true" />
			<property name="hibernate.transaction.manager_lookup_class"
				value="org.hibernate.transaction.WeblogicTransactionManagerLookup" />
			<property name="hibernate.max_fetch_depth" value="1"/>
		</properties>
	</persistence-unit>
	
	
	
</persistence>
