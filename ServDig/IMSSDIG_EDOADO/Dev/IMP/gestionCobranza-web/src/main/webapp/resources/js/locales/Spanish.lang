                <td class="option-label">
                    <label for="description">Descripción</label>
                </td>
                <td class="option-value">
                    <input id="description" type="text" data-bind="value: description, valueUpdate: 'afterkeydown'" />
                </td>
            </tr>
            <tr>
                <td class="option-label">
                    <label for="build-format">Formato del número de compilación</label>
                </td>
                <td class="option-value">
                    <input id="build-format" type="text" data-bind="value: buildNumberFormat, valueUpdate: 'afterkeydown'" />
                </td>
                <td class="helpMarkDown" data-bind="showTooltip: { text: buildNumberFormatHelpMarkdown }" />
            </tr>            
            <tr>
                <td class="option-label">
                    <label for="jobTimeout">Tiempo máximo de ejecución del trabajo de compilación en minutos</label></td>
                <td class="option-value">
                    <input id="jobTimeout" type="text" data-bind="css: { 'invalid': jobTimeoutInvalid() }, value: jobTimeout, valueUpdate: 'afterkeydown'" /></td>
                <td class="helpMarkDown" data-bind="showTooltip: { text: jobTimeoutHelpMarkdown }" />
            </tr>
            <tr>
                <td class="option-label">
                    <label for="badge-enabled">Distintivo habilitado</label></td>
                <td class="option-value">
                    <input id="badge-enabled" type="checkbox" data-bind="checked: badgeEnabled" />
                    <!-- ko if: showBadgeLink -->
                    <a data-bind="badgePopup: badgeUrl, templateName: 'definition_badge_popup'">Mostrar URL...</a>
                    <!-- /ko -->
                </td>
                <td class="helpMarkDown" data-bind="showTooltip: { text: badgeEnabledHelpMarkdown, pivotSiblingCssClass: 'option-value' }" />                
            </tr>
        </tbody>
    </table>
    <h4>Propuestas</h4>
    <table class="buildvnext-definition-general-demands buildvnext-variables-grid-table">
        <thead>
            <tr>
                <th class="remove-icon"></th>
                <th class="demand-name">Nombre</th>
                <th class="demand-type">Tipo</th>
                <th class="demand-value">Valor</th>
            </tr>
        </thead>
        <tbody data-bind="foreach: readonlyDemands">
            <tr class="readonly">
                <td></td>
                <td class="readonly-demand-name"><span data-bind="text: name"></span></td>
                <td class="readonly-demand-type">
                    <!-- ko if: type() === "exists" -->
                    <span>existe</span>
                    <!-- /ko -->
                    <!-- ko if: type() === "equals" -->
                    <span>es igual a</span>
                    <!-- /ko -->
                </td>
                <td class="readonly-demand-value"><span data-bind="text: value"></span></td>
            </tr>
        </tbody>
        <tbody data-bind="foreach: demands">
            <tr>
                <td class="icon-td">
                    <a href="#" data-bind="click: $parent.removeDemand">
                        <span class="icon icon-delete-grey-f1-background red-delete-icon-hover" title="Quitar demanda"></span>
                    </a>
                </td>
                <td>
                    <input type="text" data-bind="value: name, css: { 'invalid': isNameInvalid() }, valueUpdate: 'afterkeydown'" /></td>
                <td class="filter-type">
                    <select data-bind="value: type">
                        <option value="exists">existe</option>
                        <option value="equals">es igual a</option>
                    </select>
                </td>
                <td>
                    <input type="text" data-bind="value: value, css: { 'invalid' : isValueInvalid() }, visible: valueVisible, valueUpdate: 'afterkeydown'" /></td>
            </tr>
        </tbody>
        <tbody>
            <tr>
                <td>
                    <a href="#" data-bind="click: addDemand">
                        <span class="icon icon-add" title="Agregar demanda"></span>
                    </a>
                </td>
                <td colspan="3">
                    <a href="#" data-bind="click: addDemand">
                        Agregar demanda
                    </a>
                </td>
            </tr>
        </tbody>
    </table>
    <!-- /ko -->
    <!-- /ko -->
</script>

