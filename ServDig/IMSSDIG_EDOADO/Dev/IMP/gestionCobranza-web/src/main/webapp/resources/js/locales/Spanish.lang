<script id="create_repository_dialog" type="text/html">
    <div class="bowtie">
        <div class="repo-type-name-section">
            <div class="repo-type-section">
                <label class="textbox-label" data-bind="text: repoTypeLabel" />
                <div class="repo-type-drop-container" />
            </div>
            <div class="repo-name-section">
                <label class="textbox-label" data-bind="text: nameLabel" />
                <div data-bind="ifnot: typeIsTfvc">
                    <input type="text" class="textbox-input" data-bind="value: name, valueUpdate: ['input'], css: inputCss, attr: { placeholder: placeholder }" />
                </div>
                <div data-bind="if: typeIsTfvc">
                    <input type="text" class="textbox-input" data-bind="visible: typeIsTfvc, value: computedName, css: inputCss" disabled />
