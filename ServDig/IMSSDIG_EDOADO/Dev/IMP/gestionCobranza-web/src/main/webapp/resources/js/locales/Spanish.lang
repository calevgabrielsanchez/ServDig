                <input class="readme-checkbox" id="create-repo-dialog-create-readme" type="checkbox" data-bind="checked: createReadMe"/>
                <label class="readme-checkbox-label" for="create-repo-dialog-create-readme">Agregue un archivo LÉAME para describir el repositorio</label>
            </div>
            <div class="gitignore-section">
                <div class="gitignore-type-selector"/>
            </div>
        </div>
        <div class="vc-create-repo-hybrid-message" data-bind="visible: isHybridProject">
            <span data-bind="text: hybridProjectMessage" />
            <span data-bind="html: learnMoreHtml" />
        </div>
    </div>
</script>

