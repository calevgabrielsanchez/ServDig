				<textElement textAlignment="Justified" verticalAlignment="Middle" markup="html">
					<font size="8" isBold="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Se ubican los siguientes créditos fiscales firmes a su cargo: "]]></textFieldExpression>
			</textField>
			<subreport isUsingCache="false">
