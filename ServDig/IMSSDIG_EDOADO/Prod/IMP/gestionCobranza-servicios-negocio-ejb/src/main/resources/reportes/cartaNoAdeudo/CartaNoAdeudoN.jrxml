		</band>
		<band height="55" splitType="Stretch">
			<printWhenExpression><![CDATA[($P{adeudoBaja251Imss} != null && !$P{adeudoBaja251Imss}.isEmpty()) || ($P{adeudoBaja251Rcv} != null && !$P{adeudoBaja251Rcv}.isEmpty())]]></printWhenExpression>
			<textField pattern="" isBlankWhenNull="false">
				<reportElement x="11" y="10" width="556" height="22"/>
				<box leftPadding="5" rightPadding="5">
					<topPen lineWidth="0.5"/>
