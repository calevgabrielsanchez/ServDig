		</band>
		<band height="92" splitType="Stretch">
			<textField pattern="" isBlankWhenNull="true">
				<reportElement x="0" y="0" width="572" height="26"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Estimado Patrón:"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" pattern="" isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" mode="Transparent" x="11" y="26" width="556" height="66" backcolor="#FFFFFF"/>
				<box topPadding="5" leftPadding="5" bottomPadding="5" rightPadding="5">
					<topPen lineWidth="0.5" lineStyle="Solid"/>
					<leftPen lineWidth="0.5" lineStyle="Solid"/>
					<bottomPen lineWidth="0.5" lineStyle="Solid"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="html">
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Respuesta de opinión:" + "<br><br>" +
"En atención a su consulta sobre el Cumplimiento de Obligaciones, se le informa lo siguiente:"+ "<br><br>" +
"En los controles electrónicos del Instituto Mexicano del Seguro Social, se detecta " +
( $P{respuestaOpinion}.equals( "NEGATIVA_SIN_TRABAJADORES" ) ?
    "que está inscrito en el IMSS pero no tiene trabajadores afiliados, por lo anterior se emite opinión <b>Negativa</b>." :
    ($P{respuestaOpinion}.equals( "NEGATIVA_SIN_ADEUDOS_HUELGA" ) ?
        "que usted se encuentra con Registro (s) Patronal (es) en Huelga, por lo anterior se emite opinión Negativa." :
        "la posible existencia de créditos fiscales firmes a su cargo, por lo anterior se le informa que a la fecha " + $P{fechaSolicitud} + ", su situación fiscal no se encuentra al corriente en el cumplimiento de obligaciones en materia de Seguridad Social, por lo anterior se emite opinión <b>Negativa</b>."
+"<br><br>"+
"Esta carta opinión del cumplimiento de obligaciones fiscales tiene una vigencia hasta el <style isBold=\"true\" isUnderline=\"true\">" + $P{fechaFinVigencia} + "</style>."
+"<br>"+
		($P{leyendaJuicio}.isEmpty()? "":"<br>"+$P{leyendaJuicio}+"<br>")+
		($P{leyendaAuditoria}.isEmpty()? "":"<br>"+$P{leyendaAuditoria}+"<br>")+
        ($P{leyendaConvenio}.isEmpty()? "":"<br>"+$P{leyendaConvenio}+"<br>")+
		"<br>Las inconsistencias detectadas son las siguientes:"))]]></textFieldExpression>
			</textField>
		</band>
		<band height="55" splitType="Stretch">
			<printWhenExpression><![CDATA[($P{adeudoCreditosImss} != null && !$P{adeudoCreditosImss}.isEmpty()) || ($P{adeudoCreditosRcv} != null && !$P{adeudoCreditosRcv}.isEmpty())]]></printWhenExpression>
			<textField pattern="" isBlankWhenNull="false">
