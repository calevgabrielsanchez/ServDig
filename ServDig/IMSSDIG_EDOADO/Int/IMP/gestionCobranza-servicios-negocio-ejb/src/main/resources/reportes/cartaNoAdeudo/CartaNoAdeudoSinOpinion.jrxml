				</textElement>
				<text><![CDATA[Opinión del Cumplimiento de Obligaciones Fiscales en materia de Seguridad Social]]></text>
			</staticText>
			<textField pattern="" isBlankWhenNull="true">
				<reportElement x="0" y="0" width="571" height="22"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["FECHA: " + $P{fechaSolicitud}]]></textFieldExpression>
			</textField>
		</band>
		<band height="92" splitType="Stretch">
			<textField pattern="" isBlankWhenNull="true">
				<reportElement x="165" y="44" width="405" height="22"/>
