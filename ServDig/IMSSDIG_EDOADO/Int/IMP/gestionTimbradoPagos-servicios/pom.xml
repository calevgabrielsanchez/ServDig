		<org.cometd.java.version>2.5.1</org.cometd.java.version>
		<org.slf4j.version>1.6.1</org.slf4j.version>
	</properties>

	<dependencies>

		<dependency>
			<groupId>mx.gob.imss.ws.autopac.timbrado</groupId>
			<artifactId>autopac-timbrado-servicios-negocio-ejb</artifactId>
