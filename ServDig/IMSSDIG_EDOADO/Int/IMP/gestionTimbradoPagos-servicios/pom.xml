		<dependency>
			<groupId>mx.gob.imss.ws.autopac.cancelacion</groupId>
			<artifactId>autopac-cancelacion-servicios-negocio-ejb</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>
		
		<dependency>
			<groupId>soap</groupId>
			<artifactId>soap</artifactId>
			<version>2.3.1</version>
		</dependency>

		<dependency>
			<artifactId>gestionTimbradoPagos-servicios-interfaces</artifactId>
			<version>1.2-SNAPSHOT</version>
			<groupId>mx.gob.imss.ctirss.delta.cobranza</groupId>
		</dependency>

		<dependency>
			<groupId>mx.gob.imss.ctirss.delta.cobranza</groupId>
			<artifactId>gestionCancelacionTimbrado-interfaces</artifactId>
			<version>1.0-SNAPSHOT</version>
		</dependency> 

		<dependency>
			<groupId>org.projectlombok</groupId>
