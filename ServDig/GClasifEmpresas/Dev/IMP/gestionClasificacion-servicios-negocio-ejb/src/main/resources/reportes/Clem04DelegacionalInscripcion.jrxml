			<line>
				<reportElement key="line-133" x="463" y="108" width="1" height="70"/>
			</line>
			<textField>
				<reportElement x="7" y="22" width="546" height="66"/>
				<textElement textAlignment="Justified">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["PRIMERO.- Que el patrón citado al rubro con fecha "+$F{clemVO}.getFechaTramite()+", presentó de manera electrónica a través de IMSS Digital, el Aviso de Registro Patronal Persona " +$F{clemVO}.getTipoPersona()+" en el Régimen Obligatorio, formato "+ ($F{clemVO}.getTipoPersona().equals("moral")?"ARP-PM":"ARP-PF") + ", en el cual determina la clasificación de su actividad para el registro en el Seguro de Riesgos de Trabajo, especificando su giro, materias primas, materiales, maquinaria y equipo que emplea para el desarrollo de su(s) actividad(es), así como el número de trabajadores con que cuenta por grupo de oficios u ocupación y descripción de los procesos de trabajo propios de su actividad."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="6" y="137" width="27" height="20"/>
				<textElement textAlignment="Center">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{clemVO}.getIdDivisionPatron()]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="42" y="138" width="54" height="19"/>
				<textElement textAlignment="Center">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{clemVO}.getIdGrupoPatron()]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="101" y="137" width="83" height="20"/>
				<textElement textAlignment="Center">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{clemVO}.getIdFraccionPatron()]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="188" y="123" width="274" height="55"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{clemVO}.getDenominacionFraccion()]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="465" y="137" width="41" height="20"/>
				<textElement textAlignment="Center">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{clemVO}.getClase()]]></textFieldExpression>
			</textField>
