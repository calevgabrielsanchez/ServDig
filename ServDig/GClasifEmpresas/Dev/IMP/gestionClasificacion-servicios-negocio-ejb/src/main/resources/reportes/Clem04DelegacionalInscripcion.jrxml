				</textElement>
				<text><![CDATA[FRACCIÓN]]></text>
			</staticText>
			<staticText>
				<reportElement key="staticText-175" x="507" y="122" width="30" height="8"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
