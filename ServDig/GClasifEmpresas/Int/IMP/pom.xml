<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
 
 <groupId>mx.gob.imss.ctirss.delta.gestion.clasificacion</groupId>
  <artifactId>gestionClasificacion</artifactId>
  <packaging>pom</packaging>
  <version>2.4</version>
  <name>Modulo  Delta de Gestion de Clasificacion de Empresas IMSS</name>
  <url>http://www.imss.gob.mx/instituto/Directorio/ctirss.htm</url>
  
  <properties>
		<delta.framework.version>2.6</delta.framework.version>
		<delta.framework.comboSelect>2.0</delta.framework.comboSelect>
		<delta.domicilios>2.4</delta.domicilios>
		<delta.documentos.probatorios>2.4</delta.documentos.probatorios>
		<delta.medioscontacto>2.3</delta.medioscontacto>
		<delta.solicitud>2.2</delta.solicitud>
		<delta.patronal>2.4</delta.patronal>
		<delta.personas>2.4</delta.personas>
		<delta.clasificacion.empr>2.4</delta.clasificacion.empr>
		<delta.cobranza>2.1</delta.cobranza>
        <delta.clientews>2.2</delta.clientews>
        <delta.dashboard>1.2</delta.dashboard>
        <delta.beneficios>1.0</delta.beneficios>
  </properties>
  <build>
  
  
  
  
  <!-- To define the plugin version in your parent POM -->
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>3.0</version>
        </plugin>
		<plugin>
		  <groupId>org.apache.maven.plugins</groupId>
		  <artifactId>maven-surefire-plugin</artifactId>
		    <configuration>
			<skipTests>true</skipTests>
		  </configuration>
		</plugin>
      </plugins>
    </pluginManagement>
  
 
  
  	<plugins>
  	
  	
  
  	
    	<!-- for use JVM 1.6 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
         <version>2.5.1</version>
        <configuration>
          <source>1.6</source>
          <target>1.6</target>
        </configuration>
        
      </plugin>
      
       <!-- Relase Plugin-->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-release-plugin</artifactId>
        <version>2.3.2</version>
        <configuration>
          <tagBase>http://11.254.16.21/svn/base_arquitectura_delta/codigo/tags/</tagBase>
          <tag>${project.artifactId}-${project.version}</tag>
        </configuration>
      </plugin>
      
    </plugins>
    
     <!--Extension necesaria para el deploy (instalacion) de los
      componentes en el repositorio central -->
    <extensions>
      <extension>
        <groupId>org.apache.maven.wagon</groupId>
        <artifactId>wagon-ftp</artifactId>
      </extension>
      <extension>
        <groupId>org.apache.maven.wagon</groupId>
        <artifactId>wagon-webdav</artifactId>
      </extension>
    </extensions>
    
  </build>

  
  
  <repositories>
    <repository>
      <id>ctirss</id>
      <name>CTIRSS repository</name>
      <layout>default</layout>
      <url>http://172.16.5.134:8080/repository/repo/</url>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>ctirss</id>
      <name>CTIRSS repository</name>
      <url>http://172.16.5.134:8080/repository/repo/</url>
      <layout>default</layout>
      <snapshots>
      	<enabled>true</enabled>
      </snapshots>
      <releases>
        <updatePolicy>never</updatePolicy>
      </releases>
    </pluginRepository>
  </pluginRepositories>

  <distributionManagement>
    <!-- use the following if you're not using a snapshot version. -->
    <repository>
      <id>ctirss-archiva</id>
      <name>CTIRSS Repository Name</name>
      <url>dav:http://172.16.5.134:8080/repository/repo/</url>
    </repository>
    <snapshotRepository>
      <id>ctirss-archiva</id>
      <name>CTIRSS Repository Name</name>
      <url>dav:http://172.16.5.134:8080/repository/repo/</url>
    </snapshotRepository>
  </distributionManagement>

  <scm>
    <connection>scm:svn:http://11.254.16.21/svn/base_arquitectura_delta/codigo/trunk/gestion_domicilios/</connection>
    <developerConnection>scm:svn:http://11.254.16.21/svn/base_arquitectura_delta/codigo/trunk/gestion_domicilios/</developerConnection>
    <url>http://11.254.16.21/svn/base_arquitectura_delta/codigo/trunk/gestion_domicilios/</url>
  </scm>
  
  <profiles>
		<!--Perfil para la compilacion en el ambiente de Stage -->
		<profile>
			<id>compile-stage</id>
			<activation>
				<property>
					<name>compile-stage</name>
				</property>
			</activation>
			<modules>
				<module>gestionClasificacion-web</module>
			</modules>
		</profile>
		<!--Perfil para la compilacion en el ambiente de Produccion -->
		<profile>
			<id>compile-prod</id>
			<activation>
				<property>
					<name>compile-prod</name>
				</property>
			</activation>
			<modules>
				<module>gestionClasificacion-web</module>
			</modules>
		</profile>
	</profiles>
   
  <modules>
    <module>gestionClasificacion-modelo</module>
    <module>gestionClasificacion-interfaces-negocio</module>
    <module>gestionClasificacion-servicios-negocio-ejb</module>
    <module>gestionClasificacion-web</module>
   <!-- <module>gestionClasificacion-packing</module> -->
    <module>riesgosTrabajo-interfaces-negocio</module>
    <module>riesgosTrabajo-packing</module>
    <module>riesgosTrabajo-servicios-negocio-ejb</module>
    <module>riesgosTrabajo-web</module>
    <module>escritoDesacuerdo-web</module>
  </modules>
</project>