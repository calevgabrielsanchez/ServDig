      <groupId>mx.gob.imss.ctirss.delta</groupId>
      <artifactId>delta-persistencia</artifactId>
      <version>${delta.framework.version}</version>
      <type>jar</type>
    </dependency>
    
    <dependency>
	    <groupId>mx.gob.imss.ctirss.delta</groupId>
	    <artifactId>delta-modelo-negocio</artifactId>
	    <version>${delta.framework.version}</version>
	    <type>jar</type>
    </dependency>
    
    <!--  Dependencia del JaxbUtils -->
    <dependency>
	    <groupId>mx.gob.imss.distss.digital</groupId>
	    <artifactId>jaxb-utils</artifactId>
	    <version>${delta.jaxb.utils}</version>
	    <exclusions>
		    <exclusion>
			    <groupId>mx.gob.imss.ctirss.delta</groupId>
			    <artifactId>delta-modelo-negocio</artifactId>
		    </exclusion>
	    </exclusions>
    </dependency>

    <dependency>
      <groupId>mx.gob.imss.cit.gestion.solicitud</groupId>
      <artifactId>gestionsolicitud-flujo-trabajo-interfaces-negocio</artifactId>
      <version>${gestionsolicitud.flujo.trabajo}</version>
