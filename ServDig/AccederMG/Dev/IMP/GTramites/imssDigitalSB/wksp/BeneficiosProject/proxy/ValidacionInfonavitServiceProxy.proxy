<?xml version="1.0" encoding="UTF-8"?>
<xml-fragment xmlns:ser="http://www.bea.com/wli/sb/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:con="http://www.bea.com/wli/sb/typesystem/config" xmlns:tran="http://www.bea.com/wli/sb/transports" xmlns:env="http://www.bea.com/wli/config/env" xmlns:con1="http://www.bea.com/wli/sb/pipeline/config" xmlns:con2="http://www.bea.com/wli/sb/stages/config" xmlns:con3="http://www.bea.com/wli/sb/stages/logging/config">
  <ser:coreEntry isProxy="true" isEnabled="true" isAutoPublish="false" isTracingEnabled="false">
    <ser:description/>
    <ser:binding type="Mixed" xsi:type="con:MixedBindingType" xmlns:con="http://www.bea.com/wli/sb/services/bindings/config">
      <con:request type="XML">
        <con2:schema ref="BeneficiosProject/schema/ServiceContract/ValidacionRissInfonavitSchema" element="validarRissInfonavitRequest" xmlns:con2="http://www.bea.com/wli/sb/typesystem/config"/>
      </con:request>
      <con:response type="XML">
        <con2:schema ref="BeneficiosProject/schema/ServiceContract/ValidacionRissInfonavitSchema" element="validarRissInfonavitResponse" xmlns:con2="http://www.bea.com/wli/sb/typesystem/config"/>
      </con:response>
    </ser:binding>
    <ser:monitoring isEnabled="false">
      <ser:aggregationInterval>10</ser:aggregationInterval>
      <ser:pipelineMonitoringLevel>Pipeline</ser:pipelineMonitoringLevel>
    </ser:monitoring>
    <ser:reporting>true</ser:reporting>
    <ser:logging isEnabled="true">
      <ser:logLevel>debug</ser:logLevel>
    </ser:logging>
    <ser:sla-alerting isEnabled="true">
      <ser:alertLevel>normal</ser:alertLevel>
    </ser:sla-alerting>
    <ser:pipeline-alerting isEnabled="true">
      <ser:alertLevel>normal</ser:alertLevel>
    </ser:pipeline-alerting>
    <ser:pageAttachments isEnabled="false"/>
    <ser:transactions isRequired="true" sameTxForResponse="false"/>
  </ser:coreEntry>
  <ser:endpointConfig>
    <tran:provider-id>http</tran:provider-id>
    <tran:inbound>true</tran:inbound>
    <tran:URI>
      <env:value>/Beneficios/ValidacionInfonavitServiceProxy</env:value>
    </tran:URI>
    <tran:inbound-properties/>
    <tran:all-headers>false</tran:all-headers>
    <tran:provider-specific xsi:type="http:HttpEndPointConfiguration" xmlns:http="http://www.bea.com/wli/sb/transports/http">
      <http:inbound-properties/>
    </tran:provider-specific>
  </ser:endpointConfig>
  <ser:router>
    <con1:pipeline name="PipelinePairNode1_request" type="request">
      <con4:stage name="validarRissInfonavitStage" errorHandler="_onErrorHandler-8969311306134567190-8a002ec.146060d23bf.-7ff2" xmlns:con="http://www.bea.com/wli/sb/pipeline/config" xmlns:con1="http://www.bea.com/wli/sb/stages/config" xmlns:con2="http://www.bea.com/wli/sb/stages/logging/config" xmlns:con3="http://www.bea.com/wli/sb/stages/transform/config" xmlns:http="http://www.bea.com/wli/sb/transports/http" xmlns:con4="http://www.bea.com/wli/sb/pipeline/config">
        <con4:comment>Se llama al servicio del Infonavit para validar si la persona ha cumplido con todas las validaciones dentro del Infonavit</con4:comment>
        <con4:context>
          <con5:varNsDecl prefix="mx" namespace="http://mx.gob.imss.delta.global.service/" xmlns:con5="http://www.bea.com/wli/sb/stages/config"/>
        </con4:context>
        <con4:actions>
          <con3:assign varName="RFC">
            <con5:id xmlns:con5="http://www.bea.com/wli/sb/stages/config">_ActionId-4620114698667468896-c11a0ae.145e146d065.-7fc4</con5:id>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$body/mx:validarRissInfonavitRequest/mx:rfc/text()</con:xqueryText>
            </con3:expr>
          </con3:assign>
          <con3:assign varName="NRP">
            <con5:id xmlns:con5="http://www.bea.com/wli/sb/stages/config">_ActionId-4620114698667468896-c11a0ae.145e146d065.-7fc3</con5:id>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$body/mx:validarRissInfonavitRequest/mx:nrp/text()</con:xqueryText>
            </con3:expr>
          </con3:assign>
          <con3:assign varName="NSS">
            <con5:id xmlns:con5="http://www.bea.com/wli/sb/stages/config">_ActionId-4620114698667468896-c11a0ae.145e146d065.-7fc2</con5:id>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$body/mx:validarRissInfonavitRequest/mx:nss/text()</con:xqueryText>
            </con3:expr>
          </con3:assign>
          <con5:log xmlns:con5="http://www.bea.com/wli/sb/stages/logging/config">
            <con6:id xmlns:con6="http://www.bea.com/wli/sb/stages/config">_ActionId-4620114698667468896-c11a0ae.145e146d065.-7fc8</con6:id>
            <con5:logLevel>error</con5:logLevel>
            <con5:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">fn:concat('RFC: ', $RFC, ' NRP: ', $NRP, ' NSS: ', $NSS)</con:xqueryText>
            </con5:expr>
            <con5:message>Se va a validar al INFONAVIT con los siguientes datos</con5:message>
          </con5:log>
          <con3:wsCallout>
            <con5:id xmlns:con5="http://www.bea.com/wli/sb/stages/config">_ActionId-4620114698667468896-c11a0ae.145e146d065.-7fc7</con5:id>
            <con3:service ref="BeneficiosProject/businessService/ConsultaAdeudosInfonavitBusinessService" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
            <con3:operation>consultaAdeudos</con3:operation>
            <con3:request>
              <con3:body wrapped="false">$validarRissInfonavitRequest</con3:body>
              <con3:header/>
            </con3:request>
            <con3:response>
              <con3:body wrapped="false">validarRissInfonavitResponseTmp</con3:body>
              <con3:header/>
            </con3:response>
            <con3:requestTransform>
              <con3:assign varName="validarRissInfonavitRequest">
                <con5:id xmlns:con5="http://www.bea.com/wli/sb/stages/config">_ActionId-4620114698667468896-c11a0ae.145e146d065.-7fc6</con5:id>
                <con3:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config"><![CDATA[<riss:consultaAdeudos xmlns:riss="http://services.infonavit.org.mx/riss">
    <!--Optional:-->
    <RequestAdeudosVO>
        <!--Optional:-->
        <nrp>{$NRP}</nrp>
        <!--Optional:-->
        <nss>{$NSS}</nss>
        <!--Optional:-->
        <rfc>{$RFC}</rfc>
    </RequestAdeudosVO>
</riss:consultaAdeudos>]]></con:xqueryText>
                </con3:expr>
              </con3:assign>
            </con3:requestTransform>
            <con3:responseTransform>
              <con5:log xmlns:con5="http://www.bea.com/wli/sb/stages/logging/config">
                <con6:id xmlns:con6="http://www.bea.com/wli/sb/stages/config">_ActionId-4620114698667468896-c11a0ae.145e146d065.-7fc5</con6:id>
                <con5:logLevel>error</con5:logLevel>
                <con5:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$validarRissInfonavitResponseTmp</con:xqueryText>
                </con5:expr>
                <con5:message>LA RESPUESTA DEL INFONAVIT ES:</con5:message>
              </con5:log>
              <con3:assign varName="validarRissInfonavitResponse">
                <con5:id xmlns:con5="http://www.bea.com/wli/sb/stages/config">_ActionId-7213958083713809680-39592cd.1460576dd9e.-7fe6</con5:id>
                <con3:expr>
                  <con:xqueryTransform xmlns:con="http://www.bea.com/wli/sb/stages/config">
                    <con:resource ref="BeneficiosProject/xquery/TransformaAdeudoInfonavitResponse"/>
                    <con:param name="adeudosInfonavitResponse">
                      <con:path>$validarRissInfonavitResponseTmp</con:path>
                    </con:param>
                  </con:xqueryTransform>
                </con3:expr>
              </con3:assign>
              <con3:replace varName="body" contents-only="true">
                <con5:id xmlns:con5="http://www.bea.com/wli/sb/stages/config">_ActionId-4620114698667468896-c11a0ae.145e146d065.-7fc1</con5:id>
                <con3:location>
                  <con:xpathText xmlns:con="http://www.bea.com/wli/sb/stages/config">.</con:xpathText>
                </con3:location>
                <con3:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$validarRissInfonavitResponse</con:xqueryText>
                </con3:expr>
              </con3:replace>
            </con3:responseTransform>
          </con3:wsCallout>
        </con4:actions>
      </con4:stage>
    </con1:pipeline>
    <con1:pipeline name="_onErrorHandler-8969311306134567190-8a002ec.146060d23bf.-7ff2" type="error">
      <con1:stage name="errorHandlerStage" xmlns:con4="http://www.bea.com/wli/sb/stages/transform/config" xmlns:http="http://www.bea.com/wli/sb/transports/http">
        <con1:context>
          <con2:userNsDecl prefix="con" namespace="http://www.bea.com/wli/sb/context"/>
          <con2:userNsDecl prefix="con1" namespace="http://www.bea.com/wli/sb/stages/transform/config"/>
          <con2:userNsDecl prefix="m" namespace="http://servicios.imss.gob.mx/beneficio/riss"/>
          <con2:varNsDecl prefix="mx" namespace="http://mx.gob.imss.delta.global.service/"/>
        </con1:context>
        <con1:actions>
          <con3:log>
            <con2:id>_ActionId-3360921260481779652--51f592cf.14614efb887.-7ff3</con2:id>
            <con3:logLevel>error</con3:logLevel>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$fault</con:xqueryText>
            </con3:expr>
            <con3:message>EN EL MANEJADOR DE ERRORES DEL PROXY DEL SERVICIO DEL INFONAVIT</con3:message>
          </con3:log>
          <con4:assign varName="cveErrorResp">
            <con2:id>_ActionId-3360921260481779652--51f592cf.14614efb887.-7ff2</con2:id>
            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$fault/con:errorCode/text()</con:xqueryText>
            </con4:expr>
          </con4:assign>
          <con3:log>
            <con2:id>_ActionId-3360921260481779652--51f592cf.14614efb887.-7fe2</con2:id>
            <con3:logLevel>error</con3:logLevel>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$cveErrorResp</con:xqueryText>
            </con3:expr>
            <con3:message>CODIGO ERROR</con3:message>
          </con3:log>
          <con4:assign varName="descErrorResp">
            <con2:id>_ActionId-2718038593477788971-55c8536f.145fcd232d2.-7f30</con2:id>
            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">'Error de comunicación con el servicio externo del INFONAVIT'</con:xqueryText>
            </con4:expr>
          </con4:assign>
          <con3:log>
            <con2:id>_ActionId-3360921260481779652--51f592cf.14614efb887.-7ff1</con2:id>
            <con3:logLevel>error</con3:logLevel>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$descErrorResp</con:xqueryText>
            </con3:expr>
            <con3:message>MENSAJE ERROR</con3:message>
          </con3:log>
          <con4:assign varName="indDerechoBeneficioResp">
            <con2:id>_ActionId-3360921260481779652--51f592cf.14614efb887.-7ff0</con2:id>
            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">"false"</con:xqueryText>
            </con4:expr>
          </con4:assign>
          <con4:replace varName="body" contents-only="true">
            <con2:id>_ActionId-3360921260481779652--51f592cf.14614efb887.-7fef</con2:id>
            <con4:location>
              <con:xpathText xmlns:con="http://www.bea.com/wli/sb/stages/config">.</con:xpathText>
            </con4:location>
            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config"><![CDATA[<mx:validarRissInfonavitResponse xmlns:mx="http://mx.gob.imss.delta.global.service/">
	<mx:indicadorDerechoBeneficio>{$indDerechoBeneficioResp}</mx:indicadorDerechoBeneficio>
	<mx:motivoDeRechazo>{$motivRechazoResp}</mx:motivoDeRechazo>
	<mx:exito>1</mx:exito>
	<mx:claveError>{$cveErrorResp}</mx:claveError>
	<mx:descripcion>{$descErrorResp}</mx:descripcion>
</mx:validarRissInfonavitResponse>]]></con:xqueryText>
            </con4:expr>
          </con4:replace>
          <con2:reply isError="false">
            <con2:id>_ActionId-1388787346616577609-10eb227a.14649642b7d.-7ff2</con2:id>
          </con2:reply>
        </con1:actions>
      </con1:stage>
    </con1:pipeline>
    <con1:pipeline name="PipelinePairNode1_response" type="response">
      <con1:stage name="responseStage">
        <con1:comment/>
        <con1:context>
          <con2:varNsDecl prefix="mx" namespace="http://mx.gob.imss.delta.global.service/"/>
