<xs:schema attributeFormDefault="unqualified"
	elementFormDefault="qualified" targetNamespace="http://mx.gob.imss.delta.global.service/"
	xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="validacionApartadoBRequest">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="rfc" type="xs:string" />
				<xs:element name="registrosPatronales">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="nrp" minOccurs="1" maxOccurs="unbounded"
								nillable="true" type="xs:string" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="indicadorApartadoC" type="xs:boolean" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="validacionApartadoBResponse">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="indDerechoBeneficioApartadoB" type="xs:boolean" />
				<xs:element name="motivoDeRechazo" type="xs:string" />
				<xs:element name="exito" type="xs:int" />
				<xs:element name="claveError" type="xs:int" />
				<xs:element name="descripcion" type="xs:string" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>