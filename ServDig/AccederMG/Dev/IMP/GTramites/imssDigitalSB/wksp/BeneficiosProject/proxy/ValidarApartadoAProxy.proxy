                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$indDerechoBeneficioInfonavit</con:xqueryText>
                </con3:expr>
                <con3:message>Sujeto a beneficio en INFONAVIT</con3:message>
