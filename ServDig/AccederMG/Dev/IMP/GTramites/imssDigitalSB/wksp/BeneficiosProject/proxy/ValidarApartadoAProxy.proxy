                      <con4:service ref="BeneficiosProject/proxy/ValidacionImssSinCotizar24MesesProxy" xsi:type="ref:ProxyRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
                      <con4:request>
                        <con4:payload wrapped="false">$validarSinCotizar24MesesRequest</con4:payload>
                      </con4:request>
                      <con4:response>
