  <ser:router>
    <con1:pipeline name="PipelinePairNode2_response" type="response"/>
    <con1:pipeline name="PipelinePairNode1_request" type="request">
      <con1:stage name="validarApartadoA-C">
        <con1:comment/>
        <con1:context>
          <con2:varNsDecl prefix="mx" namespace="http://mx.gob.imss.delta.global.service/"/>
        </con1:context>
        <con1:actions>
          <con3:log>
            <con2:id>_ActionId-429625865168579810--41b5b2f7.145f10e3e1b.-7fa8</con2:id>
            <con3:logLevel>error</con3:logLevel>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$nss</con:xqueryText>
            </con3:expr>
            <con3:message>Se va validar como apartado A-C el NSS:</con3:message>
          </con3:log>
          <con4:wsCallout>
            <con2:id>_ActionId-429625865168579810--41b5b2f7.145f10e3e1b.-7fa7</con2:id>
            <con4:service ref="BeneficiosProject/proxy/ValidacionImssSinCotizarPatronesProxy" xsi:type="ref:ProxyRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
            <con4:request>
              <con4:payload wrapped="false">$validarNssNoCotizaRequest</con4:payload>
            </con4:request>
            <con4:response>
              <con4:payload wrapped="false">validarNssNoCotizaResponse</con4:payload>
            </con4:response>
            <con4:requestTransform>
              <con4:assign varName="validarNssNoCotizaRequest">
                <con2:id>_ActionId-429625865168579810--41b5b2f7.145f10e3e1b.-7fa6</con2:id>
                <con4:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config"><![CDATA[<mx:validarSinCotizarPatronesRequest xmlns:mx="http://mx.gob.imss.delta.global.service/">
    <mx:nss>{$nss}</mx:nss>
    <mx:cveAsignacion>{$cveAsignacion}</mx:cveAsignacion>
</mx:validarSinCotizarPatronesRequest>]]></con:xqueryText>
                </con4:expr>
              </con4:assign>
            </con4:requestTransform>
            <con4:responseTransform>
              <con3:log>
                <con2:id>_ActionId-429625865168579810--41b5b2f7.145f10e3e1b.-7fa5</con2:id>
                <con3:logLevel>error</con3:logLevel>
                <con3:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$validarNssNoCotizaResponse</con:xqueryText>
                </con3:expr>
                <con3:message>Respuesta NSS cotizando en IMSS con patrón en validar apartado A-C</con3:message>
              </con3:log>
              <con4:assign varName="indCotizaPatrones">
                <con2:id>_ActionId-429625865168579810--41b5b2f7.145f10e3e1b.-7fa4</con2:id>
                <con4:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$validarNssNoCotizaResponse/mx:indicadorCotizaPatrones/text()</con:xqueryText>
                </con4:expr>
              </con4:assign>
              <con4:assign varName="indError">
                <con2:id>_ActionId-9073002872389677899-14e89f74.145f65dc55b.-7fb2</con2:id>
                <con4:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$validarNssNoCotizaResponse/mx:exito/text()</con:xqueryText>
                </con4:expr>
              </con4:assign>
              <con3:log>
                <con2:id>_ActionId-429625865168579810--41b5b2f7.145f10e3e1b.-7fa3</con2:id>
                <con3:logLevel>error</con3:logLevel>
                <con3:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">fn:concat('El NSS ', $nss, ' esta cotizando actualmente en el IMSS con algún patrón: ', $indCotizaPatrones)</con:xqueryText>
                </con3:expr>
                <con3:message/>
              </con3:log>
            </con4:responseTransform>
          </con4:wsCallout>
          <con4:ifThenElse>
            <con2:id>_ActionId-9073002872389677899-14e89f74.145f65dc55b.-7fb1</con2:id>
            <con4:case>
              <con4:condition>
                <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$indError != "0"</con:xqueryText>
              </con4:condition>
              <con4:actions>
                <con3:log>
                  <con2:id>_ActionId-9073002872389677899-14e89f74.145f65dc55b.-7fb0</con2:id>
