                <con4:case>
                  <con4:condition>
                    <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$indDerechoBeneficioInfonavit = "true"</con:xqueryText>
                  </con4:condition>
                  <con4:actions>
