                    <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$indCotizaPatrones = "false"</con:xqueryText>
                  </con4:condition>
                  <con4:actions>
                    <con3:log>
                      <con2:id>_ActionId-9073002872389677899-14e89f74.145f65dc55b.-7f97</con2:id>
                      <con3:logLevel>error</con3:logLevel>
                      <con3:expr>
                        <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$nss</con:xqueryText>
                      </con3:expr>
                      <con3:message>Tiene derecho a beneficio</con3:message>
                    </con3:log>
                    <con4:assign varName="indDerechoBeneficioResp">
                      <con2:id>_ActionId-9073002872389677899-14e89f74.145f65dc55b.-7f96</con2:id>
                      <con4:expr>
                        <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">"true"</con:xqueryText>
                      </con4:expr>
                    </con4:assign>
                  </con4:actions>
                </con4:case>
                <con4:default>
                  <con3:log>
                    <con2:id>_ActionId-9073002872389677899-14e89f74.145f65dc55b.-7f95</con2:id>
                    <con3:logLevel>error</con3:logLevel>
                    <con3:expr>
                      <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$nss</con:xqueryText>
                    </con3:expr>
                    <con3:message>El NSS no es sujeto a beneficio, ya que está cotizando actualmente con algún patrón:</con3:message>
                  </con3:log>
                  <con4:assign varName="indDerechoBeneficioResp">
                    <con2:id>_ActionId-9073002872389677899-14e89f74.145f65dc55b.-7f94</con2:id>
                    <con4:expr>
                      <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">"false"</con:xqueryText>
                    </con4:expr>
                  </con4:assign>
                  <con4:assign varName="motivRechazoResp">
                    <con2:id>_ActionId-9073002872389677899-14e89f74.145f65dc55b.-7f93</con2:id>
                    <con4:expr>
                      <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">fn:concat('El IMSS informa que "El NSS ', $nss, ' esta cotizando actualmente con algún patrón"')</con:xqueryText>
                    </con4:expr>
                  </con4:assign>
                </con4:default>
              </con4:ifThenElse>
              <con4:assign varName="exitoResp">
                <con2:id>_ActionId-8906604340824846064-676f598e.14648614502.-7ecd</con2:id>
                <con4:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">'0'</con:xqueryText>
                </con4:expr>
              </con4:assign>
            </con4:default>
