                <con5:logLevel>error</con5:logLevel>
                <con5:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$leerArchivoResponse</con:xqueryText>
                </con5:expr>
                <con5:message>Archivo:::::</con5:message>
              </con5:log>
            </con4:responseTransform>
          </con4:wsCallout>
        </con1:actions>
      </con1:stage>
      <con1:stage name="Generar NSS Estudiante" xmlns:file="http://www.bea.com/wli/sb/transports/file" xmlns:con2="http://www.bea.com/wli/sb/stages/logging/config" xmlns:con3="http://www.bea.com/wli/sb/stages/config" xmlns:ftp="http://www.bea.com/wli/sb/transports/ftp" xmlns:con5="http://www.bea.com/wli/sb/stages/publish/config">
        <con1:comment/>
        <con1:context>
          <con3:userNsDecl namespace="http://mx.gob.imss.ctirss.delta.gestion.asegurado.serie.service/" prefix="ns2"/>
          <con3:userNsDecl namespace="http://mx.gob.imss.ctirss.delta.model.asegurado" prefix="ns3"/>
          <con3:userNsDecl prefix="aseg" namespace="http://imss.gob.mx/asegurado/"/>
          <con3:userNsDecl prefix="asegI" namespace="java:mx.gob.imss.ctirss.delta.model.gestion.asegurado.integracion"/>
          <con3:userNsDecl prefix="m" namespace="http://imss.gob.mx/sistema/"/>
          <con3:userNsDecl prefix="asInt" namespace="http://imss.gob.mx/integracion/asegurado/"/>
          <con3:userNsDecl prefix="jaseg" namespace="java:mx.gob.imss.ctirss.delta.model.asegurado"/>
          <con3:userNsDecl prefix="cnrp" namespace="http://patrones.reing.ctirss.imss.gob.mx/"/>
          <con3:userNsDecl prefix="jgbl" namespace="java:mx.gob.imss.ctirss.delta.global.model"/>
          <con3:varNsDecl prefix="sol" namespace="solicitud:mx.gob.imss.ctirss.delta.model.gestion.solicitud"/>
          <con3:varNsDecl prefix="gbl" namespace="gblModel:mx.gob.imss.ctirss.delta.global.model"/>
          <con3:varNsDecl prefix="fwbm" namespace="fwbm:mx.gob.imss.ctirss.delta.framework.base.model"/>
          <con3:varNsDecl prefix="mx" namespace="http://mx.gob.imss.delta.global.service/"/>
        </con1:context>
        <con1:actions>
          <con7:log xmlns:con7="http://www.bea.com/wli/sb/stages/logging/config">
            <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fcb</con3:id>
            <con7:logLevel>error</con7:logLevel>
            <con7:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$leerArchivoResponse</con:xqueryText>
            </con7:expr>
            <con7:message>Empleados</con7:message>
          </con7:log>
          <con4:assign varName="empleadosList">
            <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fca</con3:id>
            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$leerArchivoResponse/asInt:Empleados</con:xqueryText>
            </con4:expr>
          </con4:assign>
          <con7:log xmlns:con7="http://www.bea.com/wli/sb/stages/logging/config">
            <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7f9e</con3:id>
            <con7:logLevel>error</con7:logLevel>
            <con7:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$empleadosList</con:xqueryText>
            </con7:expr>
            <con7:message>empleadoList:::</con7:message>
          </con7:log>
          <con4:assign varName="numAsignados">
            <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fc9</con3:id>
            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">0</con:xqueryText>
            </con4:expr>
          </con4:assign>
          <con4:assign varName="numErrores">
            <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fc8</con3:id>
            <con4:expr>
              <con3:xqueryText>0</con3:xqueryText>
            </con4:expr>
          </con4:assign>
          <con4:assign varName="numRecuperados">
            <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fc7</con3:id>
            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">0</con:xqueryText>
            </con4:expr>
          </con4:assign>
          <con4:assign varName="curpsErroneas">
            <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fc6</con3:id>
            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">''</con:xqueryText>
            </con4:expr>
          </con4:assign>
          <con4:assign varName="prefijoFolioArchivo">
            <con3:id>_ActionId-2361242735592168495--76d4515a.1446a4971a8.-7fec</con3:id>
            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">fn:floor((fn:current-dateTime() - xs:dateTime("1970-01-01T00:00:00-00:00")) div xdt:dayTimeDuration("PT0.001S"))</con:xqueryText>
            </con4:expr>
          </con4:assign>
          <con4:assign varName="posfijoFolioArchivo">
            <con3:id>_ActionId-2361242735592168495--76d4515a.1446a4971a8.-7fed</con3:id>
            <con4:expr>
              <con3:xqueryText>fn:concat(fn:year-from-dateTime(fn:current-dateTime()), fn:month-from-dateTime(fn:current-dateTime()), fn:day-from-dateTime(fn:current-dateTime()))</con3:xqueryText>
            </con4:expr>
          </con4:assign>
          <con4:assign varName="folioArchivo">
            <con3:id>_ActionId-2361242735592168495--76d4515a.1446a4971a8.-7feb</con3:id>
            <con4:expr>
              <con3:xqueryText>fn:concat($prefijoFolioArchivo, $posfijoFolioArchivo)</con3:xqueryText>
            </con4:expr>
          </con4:assign>
          <con7:log xmlns:con7="http://www.bea.com/wli/sb/stages/logging/config">
            <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fc3</con3:id>
            <con7:logLevel>error</con7:logLevel>
            <con7:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$nombreArchivo</con:xqueryText>
            </con7:expr>
            <con7:message>registroPatronalFile</con7:message>
          </con7:log>
          <con4:foreach>
            <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fc0</con3:id>
            <con4:variable>empleadosList</con4:variable>
            <con4:expression>
              <con:xpathText xmlns:con="http://www.bea.com/wli/sb/stages/config">./*:AltaDatosAsignacionNSSType</con:xpathText>
            </con4:expression>
            <con4:value-variable>empleado</con4:value-variable>
            <con4:index-variable>index</con4:index-variable>
            <con4:total-variable>count</con4:total-variable>
            <con4:actions>
              <con7:log xmlns:con7="http://www.bea.com/wli/sb/stages/logging/config">
                <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fbf</con3:id>
                <con7:logLevel>error</con7:logLevel>
                <con7:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$empleado</con:xqueryText>
                </con7:expr>
                <con7:message>Empleado:</con7:message>
              </con7:log>
              <con4:replace varName="body" contents-only="true">
                <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fbe</con3:id>
                <con4:location>
                  <con3:xpathText>.</con3:xpathText>
                </con4:location>
                <con4:expr>
                  <con3:xqueryText>$empleado</con3:xqueryText>
                </con4:expr>
              </con4:replace>
              <con4:assign varName="curp">
                <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fbd</con3:id>
                <con4:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$empleado/jaseg:Curp/text()</con:xqueryText>
                </con4:expr>
              </con4:assign>
              <con4:assign varName="nombreCompleto">
                <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fbc</con3:id>
                <con4:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">fn:concat($empleado/jaseg:Nombre/text(),' ',$empleado/jaseg:ApellidoPaterno/text(),' ',$empleado/jaseg:ApellidoMaterno/text())</con:xqueryText>
                </con4:expr>
              </con4:assign>
              <con4:assign varName="altaEstudianteRequestDocument">
                <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fbb</con3:id>
                <con4:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config"><![CDATA[<aseg:generarNSSEstudiante xmlns:aseg="http://imss.gob.mx/asegurado/">
    <aseg:arg0 xmlns:java="java:mx.gob.imss.ctirss.delta.model.asegurado">
        <java:Nombre>{$empleado/jaseg:Nombre/text()}</java:Nombre>
        <java:ApellidoPaterno>{$empleado/jaseg:ApellidoPaterno/text()}</java:ApellidoPaterno>
        <java:ApellidoMaterno>{$empleado/jaseg:ApellidoMaterno/text()}</java:ApellidoMaterno>
        <java:Sexo>{$empleado/jaseg:Sexo/text()}</java:Sexo>
        <java:LugarNacimiento>{$empleado/jaseg:LugarNacimiento/text()}</java:LugarNacimiento>
        <java:DiaNacimiento>{$empleado/jaseg:DiaNacimiento/text()}</java:DiaNacimiento>
        <java:MesNacimiento>{$empleado/jaseg:MesNacimiento/text()}</java:MesNacimiento>
        <java:AnioNacimiento>{$empleado/jaseg:AnioNacimiento/text()}</java:AnioNacimiento>
        <java:Curp>{$curp}</java:Curp>
        <java:CodigoPostal>{$empleado/jaseg:CodigoPostal/text()}</java:CodigoPostal>
        <java:RegistroPatronal>{fn:substring($registroPatronal, 1, 10)}</java:RegistroPatronal>
    </aseg:arg0>
    <aseg:arg1>HAMC</aseg:arg1>
</aseg:generarNSSEstudiante>]]></con:xqueryText>
                </con4:expr>
              </con4:assign>
              <con4:wsCallout>
                <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fba</con3:id>
                <con4:service ref="AsignacionNSSProject/JavaBusinessService/AsignacionEJBService" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
                <con4:operation>generarNSSEstudiante</con4:operation>
                <con4:request>
                  <con4:body wrapped="false">$altaEstudianteRequestDocument</con4:body>
                  <con4:header/>
                </con4:request>
                <con4:response>
                  <con4:body wrapped="false">altaEstudianteResponseDocument</con4:body>
                  <con4:header/>
                </con4:response>
                <con4:requestTransform>
                  <con4:replace varName="body" contents-only="true">
                    <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fb9</con3:id>
                    <con4:location>
                      <con:xpathText xmlns:con="http://www.bea.com/wli/sb/stages/config">.</con:xpathText>
                    </con4:location>
                    <con4:expr>
                      <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$altaEstudianteRequestDocument</con:xqueryText>
                    </con4:expr>
                  </con4:replace>
                  <con7:log xmlns:con7="http://www.bea.com/wli/sb/stages/logging/config">
                    <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fb8</con3:id>
                    <con7:logLevel>error</con7:logLevel>
                    <con7:expr>
                      <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$body</con:xqueryText>
                    </con7:expr>
                    <con7:message>Invocando generarNSSEstudiante</con7:message>
                  </con7:log>
                </con4:requestTransform>
                <con4:responseTransform/>
              </con4:wsCallout>
              <con7:log xmlns:con7="http://www.bea.com/wli/sb/stages/logging/config">
                <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fb7</con3:id>
                <con7:logLevel>error</con7:logLevel>
                <con7:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$altaEstudianteRequestDocument</con:xqueryText>
                </con7:expr>
                <con7:message>generarAseguradoRequest</con7:message>
              </con7:log>
              <con7:log xmlns:con7="http://www.bea.com/wli/sb/stages/logging/config">
                <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fb6</con3:id>
                <con7:logLevel>error</con7:logLevel>
                <con7:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$altaEstudianteResponseDocument</con:xqueryText>
                </con7:expr>
                <con7:message>respuesta alta estudiante::::</con7:message>
              </con7:log>
              <con4:assign varName="estatusRegistro">
                <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fb5</con3:id>
                <con4:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$altaEstudianteResponseDocument/aseg:return/asegI:EstatusRegistro/text()</con:xqueryText>
                </con4:expr>
              </con4:assign>
              <con4:assign varName="nssCompleto">
                <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fb4</con3:id>
                <con4:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$altaEstudianteResponseDocument/aseg:return/asegI:Nss/text()</con:xqueryText>
                </con4:expr>
              </con4:assign>
              <con4:ifThenElse>
                <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fb3</con3:id>
                <con4:case>
                  <con4:condition>
                    <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$estatusRegistro='1'</con:xqueryText>
                  </con4:condition>
                  <con4:actions>
                    <con4:assign varName="numAsignados">
                      <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fb2</con3:id>
                      <con4:expr>
                        <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">xs:integer(&lt;e xsi:type="xs:integer">{$numAsignados}&lt;/e> + 1)</con:xqueryText>
                      </con4:expr>
                    </con4:assign>
                  </con4:actions>
                </con4:case>
                <con4:case>
                  <con4:condition>
                    <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$estatusRegistro='2'</con:xqueryText>
                  </con4:condition>
                  <con4:actions>
                    <con4:assign varName="numRecuperados">
                      <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fb1</con3:id>
                      <con4:expr>
                        <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">xs:integer(&lt;e xsi:type="xs:integer">{$numRecuperados}&lt;/e> + 1)</con:xqueryText>
                      </con4:expr>
                    </con4:assign>
                  </con4:actions>
                </con4:case>
                <con4:default>
                  <con4:assign varName="numErrores">
                    <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fb0</con3:id>
                    <con4:expr>
                      <con3:xqueryText>xs:integer(&lt;e xsi:type="xs:integer">{$numErrores}&lt;/e> + 1)</con3:xqueryText>
                    </con4:expr>
                  </con4:assign>
                  <con4:assign varName="curpsErroneas">
                    <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7faf</con3:id>
                    <con4:expr>
                      <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">fn:concat($curpsErroneas,$nombreCompleto,' ',$curp,'&amp;#13;')</con:xqueryText>
                    </con4:expr>
                  </con4:assign>
                </con4:default>
              </con4:ifThenElse>
              <con4:ifThenElse>
                <con3:id>_ActionId-7355114743526151193--4a65f6ae.14431b7a3aa.-7fae</con3:id>
                <con4:case>
                  <con4:condition>
                    <con3:xqueryConditionExpr>
                      <con3:boolExpr operator="or">
                        <con3:compExpr operator="=">
                          <con3:leftPath>$estatusRegistro</con3:leftPath>
                          <con3:rightPath>'1'</con3:rightPath>
                        </con3:compExpr>
                        <con3:compExpr operator="=">
                          <con3:leftPath>$estatusRegistro</con3:leftPath>
                          <con3:rightPath>'2'</con3:rightPath>
                        </con3:compExpr>
                      </con3:boolExpr>
                    </con3:xqueryConditionExpr>
                  </con4:condition>
                  <con4:actions>
                    <con7:log xmlns:con7="http://www.bea.com/wli/sb/stages/logging/config">
                      <con3:id>_ActionId-232754454574033022--6237b003.1446b72c801.-7fe3</con3:id>
                      <con7:logLevel>debug</con7:logLevel>
                      <con7:expr>
                        <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">'Escribiria archivo exito'</con:xqueryText>
                      </con7:expr>
                      <con7:message>Log:::</con7:message>
                    </con7:log>
                  </con4:actions>
                </con4:case>
                <con4:default>
                  <con7:log xmlns:con7="http://www.bea.com/wli/sb/stages/logging/config">
                    <con3:id>_ActionId-232754454574033022--6237b003.1446b72c801.-7fe2</con3:id>
                    <con7:logLevel>debug</con7:logLevel>
                    <con7:expr>
                      <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">'Escribiria archivo error'</con:xqueryText>
                    </con7:expr>
                    <con7:message>log:::</con7:message>
                  </con7:log>
                </con4:default>
              </con4:ifThenElse>
            </con4:actions>
          </con4:foreach>
          <con6:route>
            <con3:id>_ActionId-232754454574033022--6237b003.1446b72c801.-7fe7</con3:id>
            <con6:service ref="deltaGestionPatronalService/proxy/mail/DynamicProxyServer" xsi:type="ref:ProxyRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
            <con6:outboundTransform>
              <con4:assign varName="template">
                <con3:id>_ActionId-232754454574033022--6237b003.1446b72c801.-7fe6</con3:id>
                <con4:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config"><![CDATA[<html>
  <body>
<div style="width: 95%; background-color: lightgray; padding: 40px;"> 
<div style="background-color: white; margin: 0px auto; height: auto;">

	<table align="center" style="width: 80%">
		<tr>
			<td align="center">
				<h2 style="font-size:30px;">Instituto Mexicano del Seguro Social</h2>
			</td>
		</tr>
		<tr>
			<td align="center">
				<a style="line-height:40px;
					font-size:11px;
					display:inline;
					margin-left:5px;
					color:#999;"
	 				href="http://www.imss.gob.mx" title="Portal IMSS">Visita 
						el portal oficial del Instituto Mexicano del Seguro Social
				</a>
			</td>
		</tr>
	 	<tr>
			<td>
				<p style="font-size: 16px !important; ">        
					Este correo contiene las estadisticas generales asociadas a la solicitud de inscripción de estudiantes realizada por parte del patrón {fn:substring($registroPatronal,1,11)}.<br/> <br/>
Le informamos que su solicitud ha sido atendida. Le pedimos por favor verificar los cambios a través de su portal <b>IDSE</b>.<br/><br/>
<b>Número de estudiantes a los cuales se les realizó asignación de Número de Seguro Social: {$numAsignados}</b> <br/>
<b>Número de estudiantes para los cuales se realizó la recuperación de Número de Seguro Social: {$numRecuperados}</b> <br/>
<b>Número de estudiantes a los cuales no se logro realizar su asignación o recuperación de Número de Seguro Social: {$numErrores}*</b> <br/>

<br/><br/>
* El archivo adjunto a este correo (CurpInvalidas.txt) contiene los nombres y curp de los estudiantes para los cuales no fue posible realizar la asignación o recuperación de Número de Seguro Social (NSS).
<br/><br/>
      
				</p>
<br/>

			</td>
		</tr>
		<tfoot style="width: 90%">
			<tr>
				<th width="50%">
						<div style="text-align: center; padding-bottom: 30px;"> 
<h4 style="font-size: 14px !important; ">Gracias por usar los servicios digitales creados para usted por el Instituto Mexicano del Seguro Social.</h4>
<img title="Portal IMSS" src="http://deltadev.imss.gob.mx/delta/resources/imagenes/header70.jpg"/> 
<p style="text-align: center; font-size: 10px;"> Reforma 476, Col. Juárez, México DF - Tel 01 800 623 23 23 - <br/> ALGUNOS DERECHOS RESERVADOS IMSS - 2012 
</p> 
</div>
				</th>
