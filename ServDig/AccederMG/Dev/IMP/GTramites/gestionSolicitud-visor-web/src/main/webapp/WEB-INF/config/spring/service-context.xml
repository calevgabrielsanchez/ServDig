<?xml version="1.0" encoding="utf-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:context="http://www.springframework.org/schema/context"
	xmlns:aop="http://www.springframework.org/schema/aop" xmlns:tx="http://www.springframework.org/schema/tx"
	xmlns:jee="http://www.springframework.org/schema/jee"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
    http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd
    http://www.springframework.org/schema/aop http://www.springframework.org/schema/aop/spring-aop.xsd
    http://www.springframework.org/schema/tx http://www.springframework.org/schema/tx/spring-tx.xsd">

	<context:annotation-config />
	
	<!-- Se comento por que en desarrollo no se esta utilizando, se deja para 
		fines de configuracion en los ambientes de produccio -->
 
    <bean id="serviceRepository" class="org.springframework.jndi.JndiTemplate">
		<property name="environment">
			<props>
				<prop key="java.naming.factory.initial">weblogic.jndi.WLInitialContextFactory</prop>
				<prop key="java.naming.provider.url">${service.provider.url}</prop>
				<prop key="java.naming.security.principal">${service.security.principal}</prop>
				<prop key="java.naming.security.credentials">${service.security.credentials}</prop>
			</props>
		</property>
	</bean>

	<!-- SERVICIO PARA LA GENERACION DE COMPONENTES COMBO -->
	<bean id="componentComboService" class="org.springframework.ejb.access.SimpleRemoteStatelessSessionProxyFactoryBean">
		<property name="jndiName" value="componentComboService#mx.gob.imss.ctirss.delta.service.ejb.SelectServiceRemote" />
		<property name="businessInterface" value="mx.gob.imss.ctirss.delta.service.interfaces.ISelectService" />
		<property name="jndiTemplate" ref="serviceRepository" />
	</bean>

	<!-- Servicios afiliacion patrones -->
	<bean id="solicitudBusiness" class="org.springframework.ejb.access.SimpleRemoteStatelessSessionProxyFactoryBean">
		<property name="jndiName" value="solicitudBusiness#mx.gob.imss.ctirss.delta.gestion.solicitud.service.interfaces.SolicitudBusinessRemote" />
		<property name="businessInterface" value="mx.gob.imss.ctirss.delta.gestion.solicitud.service.interfaces.SolicitudBusinessRemote" />
		<property name="jndiTemplate" ref="serviceRepository" />
	</bean>

	<bean id="solicitudServiceBusiness" class="org.springframework.ejb.access.SimpleRemoteStatelessSessionProxyFactoryBean">
		<property name="jndiName" value="solicitudServiceBusiness#mx.gob.imss.ctirss.delta.gestion.patronal.service.interfaces.solicitud.SolicitudServiceBusinessRemote" />
		<property name="businessInterface" value="mx.gob.imss.ctirss.delta.gestion.patronal.service.interfaces.solicitud.SolicitudServiceBusinessRemote" />
		<property name="jndiTemplate" ref="serviceRepository" />
	</bean>

	<bean id="representanteLegalServiceBusiness" class="org.springframework.ejb.access.SimpleRemoteStatelessSessionProxyFactoryBean">
		<property name="jndiName" value="representanteLegalServiceBusiness#mx.gob.imss.ctirss.delta.gestion.patronal.service.interfaces.rep.legal.RepresentanteLegalServiceBusinessRemote" />
		<property name="businessInterface" value="mx.gob.imss.ctirss.delta.gestion.patronal.service.interfaces.rep.legal.RepresentanteLegalServiceBusinessRemote" />
		<property name="jndiTemplate" ref="serviceRepository" />
	</bean>

	<bean id="domicilioServiceBusiness"
		class="org.springframework.ejb.access.SimpleRemoteStatelessSessionProxyFactoryBean">
		<property name="jndiName"
			value="domicilioServiceBusiness#mx.gob.imss.ctirss.delta.gestion.domicilio.service.interfaces.domicilio.DomicilioServiceBusinessRemote" />
		<property name="businessInterface"
			value="mx.gob.imss.ctirss.delta.gestion.domicilio.service.interfaces.domicilio.DomicilioServiceBusinessRemote" />
		<property name="jndiTemplate" ref="serviceRepository" />
	</bean>
	
	
	<bean id="tramiteServiceBusiness"
		class="org.springframework.ejb.access.SimpleRemoteStatelessSessionProxyFactoryBean">
		<property name="jndiName"
			value="tramiteServiceBusiness#mx.gob.imss.ctirss.delta.tramite.service.interfaces.TramiteServiceBusinessRemote" />
		<property name="businessInterface"
			value="mx.gob.imss.ctirss.delta.tramite.service.interfaces.TramiteServiceBusinessRemote" />
		<property name="jndiTemplate" ref="serviceRepository" />
	</bean>
	
	<bean id="sujetoObligadoServiceBusiness"
		class="org.springframework.ejb.access.SimpleRemoteStatelessSessionProxyFactoryBean">
		<property name="jndiName"
			value="sujetoObligadoServiceBusiness#mx.gob.imss.ctirss.delta.gestion.patronal.service.interfaces.SujetoObligadoServiceBusinessRemote" />
		<property name="businessInterface"
			value="mx.gob.imss.ctirss.delta.gestion.patronal.service.interfaces.SujetoObligadoServiceBusinessRemote" />
		<property name="jndiTemplate" ref="serviceRepository" />
	</bean>
</beans>