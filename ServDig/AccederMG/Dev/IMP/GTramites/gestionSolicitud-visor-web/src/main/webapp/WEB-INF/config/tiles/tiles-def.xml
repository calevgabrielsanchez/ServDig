<tiles-definitions>

	<definition name="simple.base.definition" template="/WEB-INF/views/layout/main-simple.jsp">
		<put-attribute name="title" value=" Visor de Solicitudes " />
		<put-attribute name="encabezado"
			value="/WEB-INF/views/layout/encabezado.jsp" />
		<put-attribute name="subencabezado"
			value="/WEB-INF/views/layout/sub-encabezado.jsp" />
		<put-attribute name="pie" value="/WEB-INF/views/layout/pie.jsp" />
	</definition>

	<definition name="base.definition" template="/WEB-INF/views/layout/main.jsp">
		<put-attribute name="title" value=" Visor de Solicitudes " />
		<put-attribute name="encabezado"
			value="/WEB-INF/views/layout/encabezado.jsp" />
		<put-attribute name="subencabezado"
			value="/WEB-INF/views/layout/sub-encabezado.jsp" />
		<put-attribute name="menu" value="/WEB-INF/views/layout/menu.jsp" />
		<put-attribute name="submenu" value="/WEB-INF/views/layout/submenu.jsp" />

		<put-attribute name="pie" value="/WEB-INF/views/layout/pie.jsp" />
	</definition>

	<definition name="base.definition.embebed" template="/WEB-INF/views/layout/main-embebed.jsp">
		<put-attribute name="title" value=" Visor de Solicitudes " />
		<put-attribute name="encabezado"
			value="/WEB-INF/views/layout/encabezado.jsp" />
		<put-attribute name="pie" value="/WEB-INF/views/layout/pie.jsp" />
	</definition>
	
	<!-- Para mostrar el detalle externo con el estilo del portal -->
	<definition name="base.definition.externo"
		template="/WEB-INF/views/layout/externo/main.jsp">
		<put-attribute name="title" value=" Portal de Servicios IMSS Digital " />
		<put-attribute name="encabezado" value="/WEB-INF/views/layout/externo/encabezado.jsp" />
		<put-attribute name="menu" value="/WEB-INF/views/layout/externo/menu.jsp" />
		<put-attribute name="pie" value="/WEB-INF/views/layout/externo/pie.jsp" />
	</definition>
	
	<definition name="wizard.base.definition" template="/WEB-INF/views/layout/main-wizard.jsp">
		<put-attribute name="title" value=" Portal de Servicios DELTA " />
	</definition>

	<!-- Definicion de la pantalla de logeo -->
	<definition name="login" extends="simple.base.definition">
		<put-attribute name="contenido" value="/WEB-INF/views/general/login.jsp " />
		<put-attribute name="pie" value="/WEB-INF/views/layout/pie.jsp" />
	</definition>

	<!-- Definicion de la pantalla de bienvenida de la aplicacion -->
	<definition name="welcome" extends="simple.base.definition">
		<put-attribute name="contenido"
			value="/WEB-INF/views/general/welcome.jsp " />
		<put-attribute name="pie" value="/WEB-INF/views/layout/pie.jsp" />
	</definition>

	<!-- Definicion de la pantalla HOME de la aplicacion -->
	<definition name="home" extends="base.definition">
		<put-attribute name="contenido" value="/WEB-INF/views/general/home.jsp " />
		<put-attribute name="pie" value="/WEB-INF/views/layout/pie.jsp" />
	</definition>

	<!-- Definicion de la pantalla que muestra el detalle de una solicitud -->
	<definition name="portletSolicitudesDetalle" extends="base.definition">
		<put-attribute name="contenido"
			value="/WEB-INF/views/portlet/solicitudes/detalleSolicitud.jsp" />
		<put-attribute name="pie" value="/WEB-INF/views/layout/pie.jsp" />
	</definition>
	<definition name="portletSolicitudesDetalleSimple" extends="wizard.base.definition">
		<put-attribute name="contenido"
			value="/WEB-INF/views/portlet/solicitudes/detalleSolicitudContenido.jsp" />
	</definition>
	<definition name="portletSolicitudesCorreo" extends="wizard.base.definition">
		<put-attribute name="contenido"
			value="/WEB-INF/views/portlet/solicitudes/detalleSolicitudesAutorizar.jsp" />
	</definition>
	<definition name="detalleSolicitudExterno" extends="base.definition.externo">
		<put-attribute name="contenido"
			value="/WEB-INF/views/portlet/solicitudes/detalleSolicitudContenido.jsp" />
		<put-attribute name="funciones" value="" />
	</definition>

	<!-- Definiciones de los errores en genertal -->
	<definition name="error" extends="base.definition">
		<put-attribute name="contenido" value="/WEB-INF/views/error/error.jsp" />
	</definition>

	<definition name="databaseError" extends="base.definition">
		<put-attribute name="contenido" value="/WEB-INF/views/error/error.jsp" />
	</definition>

	<definition name="internalError" extends="base.definition">
		<put-attribute name="contenido" value="/WEB-INF/views/error/error.jsp" />
	</definition>

	<definition name="500" extends="base.definition">
		<put-attribute name="contenido" value="/WEB-INF/views/error/error.jsp" />
	</definition>

	<definition name="404" extends="base.definition">
		<put-attribute name="contenido" value="/WEB-INF/views/error/error-404.jsp" />
	</definition>
	
