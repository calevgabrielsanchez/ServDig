<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd">

<log4j:configuration xmlns:log4j="http://jakarta.apache.org/log4j/">

    <appender name="console" class="org.apache.log4j.ConsoleAppender">
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern"
                value="[%d{dd-MM-yy HH:mm:ss,SSS}] %5p (%60C{5}-%30M:%4L) -> %m%n"/>
        </layout>
    </appender>
    
    <appender name="gestionWS" class="org.apache.log4j.RollingFileAppender">
    	<param name="File" value="E:/Proyectos/TFS/Gestion_WS/010304_Inc_GestionClientesWS/Dev/01DST/04IMP/WebServiceAsignacionNSS/asignacion_NSS_app.log"/>
    	<param name="MaxFileSize" value="5000KB"/>
    	<param name="MaxBackupIndex" value="9"/>
    	<layout class="org.apache.log4j.PatternLayout">
      	<param name="ConversionPattern" 
       	 value=" [sapi] %p [%d{dd-MM-yy HH:mm:ss}] (%C{1}.%M:%L)| %m%n"/>
      </layout>
  	</appender>
    
    <logger name="org.apache">
        <level value="warn"/>
    </logger>

	<logger name="org.eclipse.jetty">
		<level value="warn" />
	</logger>

	<logger name="org.cometd">
		<level value="warn" />
	</logger>

    <logger name="javax">
        <level value="info"/>
    </logger>

    <logger name="org.hibernate">
        <level value="debug"/>
    </logger>
  
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder">
        <level value="trace"/>
    </logger>

    <logger name="mx.gob.imss.ctirss">
        <level value="debug"/>
        <appender-ref ref="gestionWS"/>
    </logger>
    
    <logger name="mx.gob.imss" additivity="true">
    	<level value="debug"/>
    	<appender-ref ref="gestionWS"/> 	
     </logger>

    <root>
        <level value="debug"/>
        <appender-ref ref="console"/>
    </root>

</log4j:configuration>
