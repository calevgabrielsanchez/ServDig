<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>mx.gob.imss.ctirss.delta.portal</groupId>
	<artifactId>portal</artifactId>
	<packaging>pom</packaging>
	<version>2.2</version>
	<name>Modulo Delta de Portal IMSS</name>
	<url>http://www.imss.gob.mx/instituto/Directorio/ctirss.htm</url>

	<properties>
		<project.build.sourceEncoding>iso-8859-1</project.build.sourceEncoding>
		<org.springframework.version>3.0.5.RELEASE</org.springframework.version>
		<org.slf4j.version>1.6.1</org.slf4j.version>
		<org.hibernate.version>3.6.9.Final</org.hibernate.version>
		<delta.framework.version>2.6</delta.framework.version>


		<!-- DEPENDENCIAS DE OTROS PROYECTOS -->
		<delta.framework.comboSelect>2.0</delta.framework.comboSelect>
		<delta.medioscontacto>2.3</delta.medioscontacto>
		<delta.documentos.probatorios>2.4</delta.documentos.probatorios>
		<delta.domicilios>2.4</delta.domicilios>
		<delta.personas>2.4</delta.personas>
		<gestion.solicitud.version>2.2</gestion.solicitud.version>
		<gestion.solicitud.visor>2.0</gestion.solicitud.visor>
		<gestion.patronal.version>2.4</gestion.patronal.version>
		<delta.clasificacion.empr>2.4</delta.clasificacion.empr>
		<delta.asegurados>2.2</delta.asegurados>
		<delta.portal>2.2</delta.portal>
		<delta.cobranza>2.1</delta.cobranza>
		<delta.beneficios>1.0</delta.beneficios>
		<delta.derechohabientes.version>2.2</delta.derechohabientes.version>
		<delta.portal.dhabiente>2.0</delta.portal.dhabiente>
		<delta.portal.grupoFamiliar>2.0</delta.portal.grupoFamiliar>
		<delta.seguroVoluntario>1.0</delta.seguroVoluntario>
		<delta.cuestionario>1.0</delta.cuestionario>
		<delta.portal.ventanilla>1.0</delta.portal.ventanilla>
		<delta.portal.ciudadano>1.0</delta.portal.ciudadano>
		<delta.wizard.web>1.0</delta.wizard.web>
		<gestion.beneficio.web.publico>1.0</gestion.beneficio.web.publico>
		<delta.correcciondatosasegurado>1.0</delta.correcciondatosasegurado>
		<delta.riesgosTrabajo>1.0</delta.riesgosTrabajo>
		<clientes.externos.rest.version>1.0-SNAPSHOT</clientes.externos.rest.version>
		
	</properties>

	<build>

		<!-- To define the plugin version in your parent POM -->
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-site-plugin</artifactId>
					<version>3.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<skipTests>true</skipTests>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<!-- for use JVM 1.6 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<source>1.6</source>
					<target>1.6</target>
					<encoding>${project.build.sourceEncoding}</encoding>
				</configuration>
			</plugin>


			<!-- Relase Plugin -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-release-plugin</artifactId>
				<version>2.3.2</version>
				<configuration>
					<tagBase>http://11.254.16.21/svn/base_arquitectura_delta/codigo/tags/</tagBase>
					<tag>${project.artifactId}-${project.version}</tag>
				</configuration>
			</plugin>


		</plugins>



		<!--Extension necesaria para el deploy (instalacion) de los componentes 
			en el repositorio central -->
		<extensions>
			<extension>
				<groupId>org.apache.maven.wagon</groupId>
				<artifactId>wagon-ftp</artifactId>
			</extension>
			<extension>
				<groupId>org.apache.maven.wagon</groupId>
				<artifactId>wagon-webdav</artifactId>
			</extension>
		</extensions>
	</build>

	<repositories>
		<repository>
			<id>ctirss</id>
			<name>CTIRSS repository</name>
			<layout>default</layout>
			<url>http://172.16.5.134:8080/repository/repo/</url>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</repositories>

	<pluginRepositories>
		<pluginRepository>
			<id>ctirss</id>
			<name>CTIRSS repository</name>
			<url>http://172.16.5.134:8080/repository/repo/</url>
			<layout>default</layout>
			<snapshots>
			</snapshots>
			<releases>
				<updatePolicy>never</updatePolicy>
			</releases>
		</pluginRepository>
	</pluginRepositories>

	<distributionManagement>
		<!-- use the following if you're not using a snapshot version. -->
		<repository>
			<id>ctirss-archiva</id>
			<name>CTIRSS Repository Name</name>
			<url>dav:http://172.16.5.134:8080/repository/repo/</url>
		</repository>
		<snapshotRepository>
			<id>ctirss-archiva</id>
			<name>CTIRSS Repository Name</name>
			<url>dav:http://172.16.5.134:8080/repository/repo/</url>
		</snapshotRepository>
	</distributionManagement>

	<scm>
		<connection>scm:svn:http://11.254.16.21/svn/base_arquitectura_delta/codigo/trunk/gestion_domicilios/</connection>
		<developerConnection>scm:svn:http://11.254.16.21/svn/base_arquitectura_delta/codigo/trunk/gestion_domicilios/</developerConnection>
		<url>http://11.254.16.21/svn/base_arquitectura_delta/codigo/trunk/gestion_domicilios/</url>
	</scm>

	<modules>
		<module>portal-interfaces-negocio</module>
		<module>portal-servicios-negocio-ejb</module>
		<module>portal-web</module>
		<module>portal-comet-web</module>
		<module>portal-ventanilla-web</module>
		<!--<module>portal-packing</module> -->
		<!--<module>portal-packing-web</module> -->
		<module>portal-ciudadano-web-externo</module>
		<module>wizard-web</module>
	</modules>

	<profiles>
		<!--Perfil para la compilacion en el ambiente de Stage -->
		<profile>
			<id>compile-stage</id>
			<activation>
				<property>
					<name>compile-stage</name>
				</property>
			</activation>
			<modules>
				<module>portal-web</module>
			</modules>
		</profile>
		<!--Perfil para la compilacion en el ambiente de Produccion -->
		<profile>
			<id>compile-prod</id>
			<activation>
				<property>
					<name>compile-prod</name>
				</property>
			</activation>
			<modules>
				<module>portal-web</module>
			</modules>
		</profile>
	</profiles>
</project>
