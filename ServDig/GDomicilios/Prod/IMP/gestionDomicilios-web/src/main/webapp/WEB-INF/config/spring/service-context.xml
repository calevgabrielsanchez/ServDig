	</bean>
	
	<bean id="patronService" class="org.springframework.ejb.access.SimpleRemoteStatelessSessionProxyFactoryBean">
		<property name="jndiName" value="patronService#mx.gob.imss.ctirss.delta.derechohabientes.service.utility.interfaces.PatronServiceRemote" />
		<property name="businessInterface" value="mx.gob.imss.ctirss.delta.derechohabientes.service.utility.interfaces.PatronServiceRemote" />
		<property name="jndiTemplate" ref="serviceRepository" />
	</bean>
	
	<bean id="personaBusiness" class="org.springframework.ejb.access.SimpleRemoteStatelessSessionProxyFactoryBean">
		<property name="jndiName" value="personaBusiness#mx.gob.imss.ctirss.gestionpersonas.servicios.business.PersonaBusinessRemote" />
		<property name="businessInterface" value="mx.gob.imss.ctirss.gestionpersonas.servicios.business.PersonaBusinessRemote" />
		<property name="jndiTemplate" ref="serviceRepository" />
	</bean>
	
	<bean id="umfService" class="org.springframework.ejb.access.SimpleRemoteStatelessSessionProxyFactoryBean">
		<property name="jndiName" value="umfService#mx.gob.imss.ctirss.delta.derechohabientes.service.utility.interfaces.UmfServiceRemote" />
		<property name="businessInterface" value="mx.gob.imss.ctirss.delta.derechohabientes.service.utility.interfaces.UmfServiceRemote" />
