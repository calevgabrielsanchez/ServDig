<?xml version="1.0" encoding="UTF-8"?>
<ehcache xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="ehcache.xsd" updateCheck="true"
	monitoring="autodetect" dynamicConfig="true" name="ehCacheManager2">

<defaultCache maxEntriesLocalHeap="10000" eternal="true"
		timeToIdleSeconds="3000" timeToLiveSeconds="3000" diskSpoolBufferSizeMB="30"
		maxEntriesLocalDisk="10000000" diskExpiryThreadIntervalSeconds="3000"
		memoryStoreEvictionPolicy="LRU" statistics="true">
		<persistence strategy="localTempSwap" />
	</defaultCache>
	 
				 
	<cache name="org.hibernate.cache.internal.StandardQueryCache"  maxEntriesLocalHeap="10000"
		timeToIdleSeconds="3000" timeToLiveSeconds="3000" diskSpoolBufferSizeMB="50"
		maxEntriesLocalDisk="10000000" diskExpiryThreadIntervalSeconds="3000"
		memoryStoreEvictionPolicy="LRU" statistics="true">
		<persistence strategy="localTempSwap" />
	</cache>
	<cache name="org.hibernate.cache.StandardQueryCache"  maxEntriesLocalHeap="10000"
	timeToIdleSeconds="3000" timeToLiveSeconds="3000" diskSpoolBufferSizeMB="50"
		maxEntriesLocalDisk="10000000" diskExpiryThreadIntervalSeconds="3000"
		memoryStoreEvictionPolicy="LRU" statistics="true">
		<persistence strategy="localTempSwap" />
	</cache>
	
	<cache name="org.hibernate.cache.UpdateTimestampsCache"  maxEntriesLocalHeap="10000"
	timeToIdleSeconds="3000" timeToLiveSeconds="3000" diskSpoolBufferSizeMB="50"
		maxEntriesLocalDisk="10000000" diskExpiryThreadIntervalSeconds="3000"
		memoryStoreEvictionPolicy="LRU" statistics="true">
		<persistence strategy="localTempSwap" />
	</cache>

	<cache name="org.hibernate.cache.spi.UpdateTimestampsCache"
		maxEntriesLocalHeap="5000" eternal="true">
		<persistence strategy="localTempSwap" />
	</cache>
	 

	<cache name="query.catalogos.catComun" maxEntriesLocalHeap="5000" eternal="true"
		timeToIdleSeconds="3000" timeToLiveSeconds="3000" diskSpoolBufferSizeMB="50"
		maxEntriesLocalDisk="10000000" diskExpiryThreadIntervalSeconds="3000"
		memoryStoreEvictionPolicy="LRU" statistics="true">
		<persistence strategy="localTempSwap" />
	</cache>
	

</ehcache>
