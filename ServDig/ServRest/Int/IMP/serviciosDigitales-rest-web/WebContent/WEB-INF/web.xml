<web-app version="2.5" xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd">


  <display-name>serviciosDigitales-rest</display-name>
  
  	<context-param>
		<param-name>webAppRootKey</param-name>
		<param-value>serviciosDigitales-rest</param-value>
	</context-param>
  
  	<context-param>
		<param-name>log4jConfigLocation</param-name>
		<param-value>/WEB-INF/log4j/log4j.xml</param-value>
	</context-param>
	<listener>
        <listener-class>org.springframework.web.util.Log4jConfigListener</listener-class>
    </listener>
   
  <servlet>
  	<display-name>Servicios Digitales Rest Externo</display-name>
  	<servlet-name>RestJerseryApp</servlet-name>
  	<servlet-class>com.sun.jersey.spi.container.servlet.ServletContainer</servlet-class>
  	<init-param>    
  		<param-name>com.sun.jersey.config.property.packages</param-name>
  		<param-value>mx.gob.imss.cit.dacvass.servicios.externos.service.business.rest</param-value>
  	</init-param>
  	
  </servlet>
  <servlet-mapping>
  	 <servlet-name>RestJerseryApp</servlet-name>
  	 <url-pattern>/*</url-pattern>
  </servlet-mapping>
  
