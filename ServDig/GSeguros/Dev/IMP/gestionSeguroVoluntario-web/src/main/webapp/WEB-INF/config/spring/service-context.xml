    <!--Servicios Web para consulta de situacion aseguramiento de las diferentes modalidades-->

    <!--WSConsultaSituacionAseguramiento se puede utlizar para consultar la situacion de modalidad 34(Domesticos) y 35,43,44(IVRO)-->
    <bean id="wsConsultaSituacionAseguramiento"
          class="org.springframework.remoting.jaxws.JaxWsPortProxyFactoryBean">
        <property name="serviceInterface"
                  value="mx.gob.imss.ws.estatusvigencia.individual.cliente.WSConsultaSituacionAseguramiento" />
        <property name="wsdlDocumentUrl"
                  value="${ws.consulta.estatus.vigencia.ivro.url}" />
        <property name="namespaceUri" value="http://situacionAseguramiento.imss.gob.mx/" />
        <property name="serviceName" value="WSConsultaSituacionAseguramiento" />
        <property name="portName" value="WSConsultaSituacionAseguramientoPort" />
        <property name="lookupServiceOnStartup" value="false" />
    </bean>

    <!--WSConsultaMod33 se puede utlizar para consultar la situacion de modalidad 33(SSF)-->
    <bean id="modalidad33VO"
          class="org.springframework.remoting.jaxws.JaxWsPortProxyFactoryBean">
        <property name="serviceInterface"
                  value="mx.gob.imss.ws.vo.Modalidad33VO" />
        <property name="wsdlDocumentUrl"
                  value="${ws.consulta.estatus.vigencia.ssf.url}" />
        <property name="namespaceUri" value="http://vo.ws.imss.gob.mx/" />
        <property name="serviceName" value="WSConsultaMod33" />
        <property name="portName" value="Modalidad33VOPort" />
        <property name="lookupServiceOnStartup" value="false" />
        <property name="customProperties" ref="jaxwsCustomProperties" />
    </bean>

    <!--wSConsultaMod40 se puede utlizar para consultar la situacion de modalidad 40(CVRO)-->
