			</staticText>
			<rectangle>
				<reportElement mode="Transparent" x="0" y="57" width="572" height="17" forecolor="#AFB1B1" backcolor="#E7E8E7"/>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
