<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE taglib PUBLIC "-//Sun Microsystems, Inc.//DTD JSP Tag Library 1.2//EN" "http://java.sun.com/dtd/web-jsptaglibrary_1_2.dtd">
<taglib>
	<tlib-version>1.0</tlib-version>
	<jsp-version>2.1</jsp-version>
	<short-name>domicilio</short-name>
	<uri>http://www.serviciosdigitales.imss.gob.mx/tags/domicilio</uri>
	<description>Utilerías para formateo de domicilios</description>
	<tag>
		<name>generar-descripcion</name>
		<tag-class>
			mx.gob.imss.ctirss.delta.gestion.seguroVoluntario.util.DomicilioTag
		</tag-class>
		<body-content>empty</body-content>
		<description>
			<![CDATA[Da formato al objeto domicilio para mostrarlo de forma homogenea]]>
         </description>
		
		<attribute>
			<name>domicilio</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
</taglib>