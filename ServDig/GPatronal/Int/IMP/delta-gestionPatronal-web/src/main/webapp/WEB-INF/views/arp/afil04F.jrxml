				<text><![CDATA[No distribuye, ni entrega]]></text>
			</staticText>
			<staticText>
				<reportElement key="staticText-17" x="29" y="500" width="172" height="30"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
