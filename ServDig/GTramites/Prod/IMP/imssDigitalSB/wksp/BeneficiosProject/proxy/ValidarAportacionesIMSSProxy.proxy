                              <con2:id>_ActionId-8906604340824846064-676f598e.14648614502.-7edc</con2:id>
                              <con4:case>
                                <con4:condition>
                                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$indCotizado24Meses = "true"</con:xqueryText>
