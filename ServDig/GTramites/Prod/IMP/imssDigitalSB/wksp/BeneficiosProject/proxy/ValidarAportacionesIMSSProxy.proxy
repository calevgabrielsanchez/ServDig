            <con2:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$body</con:xqueryText>
            </con2:expr>
            <con2:message>Documento de entrada -></con2:message>
          </con2:log>
          <con3:assign varName="nss">
            <con1:id>_ActionId-8906604340824846064-676f598e.14648614502.-7fea</con1:id>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$body/mx:validarAportacionesImssRequest/nss/text()</con:xqueryText>
            </con3:expr>
          </con3:assign>
          <con3:wsCallout>
            <con1:id>_ActionId-8906604340824846064-676f598e.14648614502.-7fe9</con1:id>
