                          </con4:expr>
                        </con4:assign>
                        <con4:ifThenElse>
                          <con2:id>_ActionId-8906604340824846064-676f598e.14648614502.-7ee2</con2:id>
                          <con4:case>
                            <con4:condition>
                              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$indError != "0"</con:xqueryText>
                            </con4:condition>
                            <con4:actions>
