          <con1:varNsDecl prefix="mx" namespace="http://mx.gob.imss.delta.global.service/"/>
        </con:context>
        <con:actions>
          <con2:log>
            <con1:id>_ActionId-8906604340824846064-676f598e.14648614502.-7feb</con1:id>
