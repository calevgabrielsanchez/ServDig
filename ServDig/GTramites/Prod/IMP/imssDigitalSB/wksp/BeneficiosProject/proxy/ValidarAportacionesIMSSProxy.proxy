                                  </con3:log>
                                  <con4:assign varName="indDerechoBeneficioResp">
                                    <con2:id>_ActionId-8906604340824846064-676f598e.14648614502.-7eda</con2:id>
                                    <con4:expr>
                                      <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">"false"</con:xqueryText>
