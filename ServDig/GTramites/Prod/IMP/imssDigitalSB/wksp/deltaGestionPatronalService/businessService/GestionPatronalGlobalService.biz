<?xml version="1.0" encoding="UTF-8"?>
<xml-fragment xmlns:ser="http://www.bea.com/wli/sb/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tran="http://www.bea.com/wli/sb/transports" xmlns:env="http://www.bea.com/wli/config/env" xmlns:ejb="http://www.bea.com/wli/sb/transports/ejb">
  <ser:coreEntry isProxy="false" isEnabled="true" isAutoPublish="false" isTracingEnabled="false">
    <ser:description>Contiene metodos para afectar la clasificación y datos de afiliación de un patrón.</ser:description>
    <ser:binding type="SOAP" isSoap12="false" xsi:type="con:SoapBindingType" transport-typed="true" xmlns:con="http://www.bea.com/wli/sb/services/bindings/config">
      <con:binding>
        <con:name>JwsServiceSoapBinding</con:name>
        <con:namespace>http://delta.global.services/</con:namespace>
      </con:binding>
    </ser:binding>
    <ser:monitoring isEnabled="false">
      <ser:aggregationInterval>10</ser:aggregationInterval>
    </ser:monitoring>
    <ser:sla-alerting isEnabled="true">
      <ser:alertLevel>normal</ser:alertLevel>
    </ser:sla-alerting>
    <ser:throttling enabled="false">
      <ser:capacity>0</ser:capacity>
      <ser:maxQueueLength>0</ser:maxQueueLength>
      <ser:timeToLive>0</ser:timeToLive>
    </ser:throttling>
    <ser:result-caching isEnabled="true" isSupported="false"/>
  </ser:coreEntry>
  <ser:endpointConfig>
    <tran:provider-id>ejb</tran:provider-id>
    <tran:inbound>false</tran:inbound>
    <tran:URI weight="0">
      <env:value>ejb:deltaJNDIProvider:clasificacionServiceBusiness#mx.gob.imss.ctirss.delta.gestion.patronal.global.service.interfaces.ClasificacionServiceRemote</env:value>
    </tran:URI>
    <tran:outbound-properties>
      <tran:load-balancing-algorithm>round-robin</tran:load-balancing-algorithm>
      <tran:retry-count>0</tran:retry-count>
      <tran:retry-interval>30</tran:retry-interval>
      <tran:retry-application-errors>true</tran:retry-application-errors>
      <tran:delay-interval-configuration isEnabled="false">
        <tran:delay-interval>0</tran:delay-interval>
      </tran:delay-interval-configuration>
    </tran:outbound-properties>
    <tran:provider-specific>
      <ejb:security>
        <ejb:passClientIdentity>false</ejb:passClientIdentity>
      </ejb:security>
      <ejb:service>
        <ejb:clientJar ref="deltaGestionPatronalService/libs/delta-gestionPatronal-interfaces-negocio-1.4-SNAPSHOT"/>
        <ejb:ejbBizService classname="mx.gob.imss.ctirss.delta.gestion.patronal.global.service.interfaces.ClasificacionServiceRemote">
          <ejb:method name="actualizarClasificacionYActividadEconomica" signature="void actualizarClasificacionYActividadEconomica(mx.gob.imss.ctirss.delta.global.model.RegistroPatronalTO,java.lang.Long) throws mx.gob.imss.ctirss.delta.framework.base.exception.GestionPatronalBusinessException" exclude="false">
            <ejb:operation>actualizarClasificacionYActividadEconomica</ejb:operation>
            <ejb:param name="arg0" type="mx.gob.imss.ctirss.delta.global.model.RegistroPatronalTO"/>
            <ejb:param name="arg1" type="java.lang.Long"/>
          </ejb:method>
          <ejb:method name="finalizarModificacionSRT" signature="void finalizarModificacionSRT(java.lang.Long) throws mx.gob.imss.ctirss.delta.framework.base.exception.GestionPatronalBusinessException" exclude="false">
            <ejb:operation>finalizarModificacionSRT</ejb:operation>
            <ejb:param name="arg0" type="java.lang.Long"/>
          </ejb:method>
        </ejb:ejbBizService>
        <ejb:targetNamespace>http://delta.global.services/</ejb:targetNamespace>
        <ejb:style>Document Wrapped</ejb:style>
        <ejb:encoding>Literal</ejb:encoding>
      </ejb:service>
      <ejb:ejb30>true</ejb:ejb30>
    </tran:provider-specific>
  </ser:endpointConfig>
</xml-fragment>