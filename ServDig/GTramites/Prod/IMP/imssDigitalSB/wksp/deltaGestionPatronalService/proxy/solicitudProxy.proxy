        <con1:actions>
          <con:assign varName="csreq" xmlns:con="http://www.bea.com/wli/sb/stages/transform/config">
            <con1:id xmlns:con1="http://www.bea.com/wli/sb/stages/config">_ActionId-437815093207181374--60624ad5.13f3a590d41.-7fe1</con1:id>
            <con:expr>
