<?xml version="1.0" encoding="UTF-8"?>
<xml-fragment xmlns:ser="http://www.bea.com/wli/sb/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:con="http://www.bea.com/wli/sb/typesystem/config" xmlns:tran="http://www.bea.com/wli/sb/transports" xmlns:env="http://www.bea.com/wli/config/env">
  <ser:coreEntry isProxy="true" isEnabled="true" isAutoPublish="false">
    <ser:description/>
    <ser:binding type="Mixed" xsi:type="con:MixedBindingType" xmlns:con="http://www.bea.com/wli/sb/services/bindings/config">
      <con:request type="XML">
        <con1:schema ref="deltaGestionPatronalService/schema/ServiceContract/EmailRequestSchema" element="EmailPayload" xmlns:con1="http://www.bea.com/wli/sb/typesystem/config"/>
      </con:request>
    </ser:binding>
    <ser:monitoring isEnabled="false">
      <ser:aggregationInterval>10</ser:aggregationInterval>
      <ser:pipelineMonitoringLevel>Pipeline</ser:pipelineMonitoringLevel>
    </ser:monitoring>
    <ser:reporting>true</ser:reporting>
    <ser:logging isEnabled="true">
      <ser:logLevel>debug</ser:logLevel>
    </ser:logging>
    <ser:sla-alerting isEnabled="true">
      <ser:alertLevel>normal</ser:alertLevel>
    </ser:sla-alerting>
    <ser:pipeline-alerting isEnabled="true">
      <ser:alertLevel>normal</ser:alertLevel>
    </ser:pipeline-alerting>
  </ser:coreEntry>
  <ser:endpointConfig>
    <tran:provider-id>http</tran:provider-id>
    <tran:inbound>true</tran:inbound>
    <tran:URI>
      <env:value>/deltaGestionPatronalService/proxy/Test/TestCorreo</env:value>
    </tran:URI>
    <tran:inbound-properties/>
    <tran:all-headers>false</tran:all-headers>
    <tran:provider-specific xsi:type="http:HttpEndPointConfiguration" xmlns:http="http://www.bea.com/wli/sb/transports/http">
      <http:inbound-properties/>
    </tran:provider-specific>
  </ser:endpointConfig>
  <ser:router>
    <con1:pipeline name="PipelinePairNode1_request" type="request" xmlns:con1="http://www.bea.com/wli/sb/pipeline/config">
      <con1:stage name="obtenerParametrosMailNss">
        <con1:comment/>
        <con1:context>
          <con2:varNsDecl prefix="mx" namespace="http://mx.gob.imss.email.model" xmlns:con2="http://www.bea.com/wli/sb/stages/config"/>
        </con1:context>
        <con1:actions>
          <con2:assign varName="nombre" xmlns:con2="http://www.bea.com/wli/sb/stages/transform/config">
            <con3:id xmlns:con3="http://www.bea.com/wli/sb/stages/config">_ActionId-830800944085897281--2fb2688e.14257a86a80.-7fef</con3:id>
            <con2:expr>
              <con:xqueryTransform xmlns:con="http://www.bea.com/wli/sb/stages/config">
                <con:resource ref="deltaGestionPatronalService/XQuery/ReturnValueFromMap"/>
                <con:param name="keyName">
                  <con:path>"nombre"</con:path>
                </con:param>
                <con:param name="map">
                  <con:path>$body/mx:EmailPayload/mx:Parameters</con:path>
                </con:param>
              </con:xqueryTransform>
            </con2:expr>
          </con2:assign>
          <con2:assign varName="apellidoPaterno" xmlns:con2="http://www.bea.com/wli/sb/stages/transform/config">
            <con3:id xmlns:con3="http://www.bea.com/wli/sb/stages/config">_ActionId-830800944085897281--2fb2688e.14257a86a80.-7fee</con3:id>
            <con2:expr>
              <con:xqueryTransform xmlns:con="http://www.bea.com/wli/sb/stages/config">
                <con:resource ref="deltaGestionPatronalService/XQuery/ReturnValueFromMap"/>
                <con:param name="keyName">
                  <con:path>"apellidoPaterno"</con:path>
                </con:param>
                <con:param name="map">
                  <con:path>$body/mx:EmailPayload/mx:Parameters</con:path>
                </con:param>
              </con:xqueryTransform>
            </con2:expr>
          </con2:assign>
          <con2:assign varName="apellidoMaterno" xmlns:con2="http://www.bea.com/wli/sb/stages/transform/config">
            <con3:id xmlns:con3="http://www.bea.com/wli/sb/stages/config">_ActionId-830800944085897281--2fb2688e.14257a86a80.-7fed</con3:id>
            <con2:expr>
              <con:xqueryTransform xmlns:con="http://www.bea.com/wli/sb/stages/config">
                <con:resource ref="deltaGestionPatronalService/XQuery/ReturnValueFromMap"/>
                <con:param name="keyName">
                  <con:path>"apellidoMaterno"</con:path>
                </con:param>
                <con:param name="map">
                  <con:path>$body/mx:EmailPayload/mx:Parameters</con:path>
                </con:param>
              </con:xqueryTransform>
            </con2:expr>
          </con2:assign>
          <con2:assign varName="nss" xmlns:con2="http://www.bea.com/wli/sb/stages/transform/config">
            <con3:id xmlns:con3="http://www.bea.com/wli/sb/stages/config">_ActionId-830800944085897281--2fb2688e.14257a86a80.-7fec</con3:id>
            <con2:expr>
              <con:xqueryTransform xmlns:con="http://www.bea.com/wli/sb/stages/config">
                <con:resource ref="deltaGestionPatronalService/XQuery/ReturnValueFromMap"/>
                <con:param name="keyName">
                  <con:path>"nss"</con:path>
                </con:param>
                <con:param name="map">
                  <con:path>$body/mx:EmailPayload/mx:Parameters</con:path>
                </con:param>
              </con:xqueryTransform>
            </con2:expr>
          </con2:assign>
          <con2:log xmlns:con2="http://www.bea.com/wli/sb/stages/logging/config">
            <con3:id xmlns:con3="http://www.bea.com/wli/sb/stages/config">_ActionId-830800944085897281--2fb2688e.14257a86a80.-7feb</con3:id>
            <con2:logLevel>error</con2:logLevel>
            <con2:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">fn:concat($nombre, "-", $apellidoPaterno,"-",$apellidoMaterno)</con:xqueryText>
            </con2:expr>
            <con2:message>NOMBRE::::</con2:message>
          </con2:log>
          <con2:log xmlns:con2="http://www.bea.com/wli/sb/stages/logging/config">
            <con3:id xmlns:con3="http://www.bea.com/wli/sb/stages/config">_ActionId-830800944085897281--2fb2688e.14257a86a80.-7fea</con3:id>
            <con2:logLevel>error</con2:logLevel>
            <con2:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$nss</con:xqueryText>
            </con2:expr>
            <con2:message>NSS::::</con2:message>
          </con2:log>
        </con1:actions>
      </con1:stage>
    </con1:pipeline>
    <con1:pipeline name="PipelinePairNode1_response" type="response" xmlns:con1="http://www.bea.com/wli/sb/pipeline/config"/>
    <con1:flow xmlns:con1="http://www.bea.com/wli/sb/pipeline/config">
      <con1:pipeline-node name="PipelinePairNode1">
        <con1:request>PipelinePairNode1_request</con1:request>
        <con1:response>PipelinePairNode1_response</con1:response>
      </con1:pipeline-node>
    </con1:flow>
  </ser:router>
</xml-fragment>