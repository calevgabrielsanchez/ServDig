            <con5:expr>
              <con2:xqueryText>$solicitudResponse</con2:xqueryText>
            </con5:expr>
            <con5:message>Finaliza ejecución de callout de consulta</con5:message>
          </con5:log>
          <con4:assign varName="varIdSolicitud">
            <con2:id>_ActionId-7924871251150676548-1a762934.13fca5eb18f.-7fe6</con2:id>
            <con4:expr>
