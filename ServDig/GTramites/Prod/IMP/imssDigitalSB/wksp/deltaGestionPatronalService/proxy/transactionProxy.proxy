            </con4:expr>
          </con4:assign>
          <con4:assign varName="varIdTipoSol">
            <con2:id>_ActionId-7924871251150676548-1a762934.13fca5eb18f.-7fe5</con2:id>
            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$solicitudResponse/mx:return/jgbl:TipoSolicitud/jsol:IdTipoSolicitud/text()</con:xqueryText>
            </con4:expr>
