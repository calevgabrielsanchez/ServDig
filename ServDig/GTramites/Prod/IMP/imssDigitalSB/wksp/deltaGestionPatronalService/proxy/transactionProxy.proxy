            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">&lt;mx:consultarDatosGenerales xmlns:mx="http://mx.gob.imss.delta.global.service/">
    &lt;mx:arg0>{$body/mx1:transactionRequest/mx1:idSolicitud/text()}&lt;/mx:arg0>
&lt;/mx:consultarDatosGenerales></con:xqueryText>
            </con4:expr>
          </con4:assign>
          <con5:log>
            <con2:id>_ActionId-7924871251150676548-1a762934.13fca5eb18f.-7fcc</con2:id>
            <con5:logLevel>error</con5:logLevel>
            <con5:expr>
