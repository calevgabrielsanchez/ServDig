            <con4:service ref="deltaGestionPatronalService/businessService/DeltaSolicitudBusinessService" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
            <con4:operation>consultarDatosGenerales</con4:operation>
