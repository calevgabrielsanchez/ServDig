                <con3:location>
                  <con:xpathText xmlns:con="http://www.bea.com/wli/sb/stages/config">.</con:xpathText>
                </con3:location>
                <con3:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$idFraccion</con:xqueryText>
                </con3:expr>
              </con3:replace>
              <con3:routing-options>
                <con2:id>_ActionId-1826520508859675320-91a2cca.13f43732846.-7cc2</con2:id>
