          <con2:varNsDecl prefix="gbl" namespace="gblModel:mx.gob.imss.ctirss.delta.global.model"/>
          <con2:varNsDecl prefix="fwbm" namespace="fwbm:mx.gob.imss.ctirss.delta.framework.base.model"/>
          <con2:varNsDecl prefix="mx" namespace="http://mx.gob.imss.delta.global.service/"/>
          <con2:varNsDecl prefix="java" namespace="java:mx.gob.imss.ctirss.delta.model.gestion.patronal"/>
          <con2:varNsDecl prefix="mx1" namespace="http://mx.gob.imss.delta.solicitud/"/>
          <con2:varNsDecl prefix="java1" namespace="java:mx.gob.imss.ctirss.delta.framework.base.model"/>
        </con1:context>
