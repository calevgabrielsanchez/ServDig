            <con5:logLevel>error</con5:logLevel>
            <con5:expr>
              <con2:xqueryText>$varIdSolicitud</con2:xqueryText>
            </con5:expr>
            <con5:message>varIdSolicitud</con5:message>
          </con5:log>
          <con4:foreach>
            <con2:id>_ActionId-7924871251150676548-1a762934.13fca5eb18f.-7fc9</con2:id>
            <con4:variable>solicitudResponse</con4:variable>
            <con4:expression>
              <con:xpathText xmlns:con="http://www.bea.com/wli/sb/stages/config">./mx:return/jgbl:Tramites/item</con:xpathText>
