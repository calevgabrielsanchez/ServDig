            <con2:id>_ActionId-1826520508859675320-91a2cca.13f43732846.-7e03</con2:id>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">&lt;mx:cancelarSolicitud xmlns:mx="http://mx.gob.imss.delta.solicitud/">
    &lt;mx:arg0>{$body/mx:transactionRequest/mx:idSolicitud/text()}&lt;/mx:arg0>
&lt;/mx:cancelarSolicitud></con:xqueryText>
            </con3:expr>
          </con3:assign>
          <con3:assign varName="paramIdFraccion">
            <con2:comment>Asigna el valor de la variable de entrada idFraccion a la variable paramIdFraccion</con2:comment>
            <con2:id>_ActionId-1826520508859675320-91a2cca.13f43732846.-7e05</con2:id>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$body/mx:transactionRequest/mx:idFraccion/text()</con:xqueryText>
            </con3:expr>
          </con3:assign>
          <con3:assign varName="idFraccion">
            <con2:comment>asigna a la variable local idFraccion el valor del XML de entrada tomando como valor del parametro el valor de la variable paramIdFraccion, esto fue requerido para evitar errores en los namespaces</con2:comment>
            <con2:id>_ActionId-1826520508859675320-91a2cca.13f43732846.-7e07</con2:id>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">&lt;mx:obtenerFraccionClaseActiva xmlns:mx="http://mx.gob.imss.delta.clasificacion/">
    &lt;mx:arg0>{$paramIdFraccion}&lt;/mx:arg0>
&lt;/mx:obtenerFraccionClaseActiva></con:xqueryText>
            </con3:expr>
          </con3:assign>
          <con3:wsCallout>
            <con2:id>_ActionId-5325630280882900651--152c2c33.13f3e7c9ea4.-7fef</con2:id>
            <con3:service ref="deltaGestionPatronalService/BSTest/solicitudServiceBusines" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
            <con3:operation>cancelarSolicitud</con3:operation>
            <con3:request>
              <con3:body wrapped="false">$idSolicitud</con3:body>
              <con3:header/>
            </con3:request>
            <con3:response>
