          </con5:log>
          <con5:log>
            <con2:id>_ActionId-7924871251150676548-1a762934.13fca5eb18f.-7fcb</con2:id>
            <con5:logLevel>error</con5:logLevel>
            <con5:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$body/mx1:transactionRequest</con:xqueryText>
