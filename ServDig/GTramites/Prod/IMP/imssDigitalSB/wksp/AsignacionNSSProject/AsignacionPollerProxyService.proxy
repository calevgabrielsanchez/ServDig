                      <con5:service ref="AsignacionNSSProject/IdseProxyService" xsi:type="ref:ProxyRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
                      <con5:outboundTransform>
                        <con4:assign varName="peticionIDSE">
                          <con3:id>_ActionId-367289871648706837--1abe819.1435a993350.-7f64</con3:id>
                          <con4:expr>
                            <con3:xqueryText><![CDATA[<idse:MovimientoIdse xmlns:idse="http://www.mx.gob.imss.ctirss.delta.idse/idse_schema">
    <idse:registroPatronal>{fn:substring($registroPatronal, 1,10)}</idse:registroPatronal>
    <idse:digitoVerificadorRP>{fn:substring($registroPatronal, 11, 1)}</idse:digitoVerificadorRP>
    <idse:folioArchivo>{$folioArchivo}</idse:folioArchivo>
    <idse:nSS>{fn:substring($nssCompleto, 1, 10)}</idse:nSS>
    <idse:digitoVerificadorNSS>{fn:substring($nssCompleto, 11, 1)}</idse:digitoVerificadorNSS>
    <idse:primerApellido>{$altaEstudianteResponseDocument/aseg:return/asegI:PrimerApellido/text()}</idse:primerApellido>
    <idse:segundoApellido>{$altaEstudianteResponseDocument/aseg:return/asegI:SegundoApellido/text()}</idse:segundoApellido>
    <idse:nombreDelEstudiante>{$altaEstudianteResponseDocument/aseg:return/asegI:Nombre/text()}</idse:nombreDelEstudiante>
    <idse:tipoDeTrabajador>2</idse:tipoDeTrabajador>
    <idse:tipoDeSalario>1</idse:tipoDeSalario>
    <idse:semanaOJornadaReducida>0</idse:semanaOJornadaReducida>
    <idse:fechaDelMovimiento>{$altaEstudianteResponseDocument/aseg:return/asegI:FechaOperacion/text()}</idse:fechaDelMovimiento>
    <idse:unidadDeMedicinaFamiliar>{$altaEstudianteResponseDocument/aseg:return/asegI:Umf/asegI:NoEconomico/text()}</idse:unidadDeMedicinaFamiliar>
    <idse:tipoDeMovimiento>08</idse:tipoDeMovimiento>
    <idse:curp_o_Rfc>{$altaEstudianteResponseDocument/aseg:return/asegI:Curp/text()}</idse:curp_o_Rfc>
    <idse:idFormato>9</idse:idFormato>
</idse:MovimientoIdse>]]></con3:xqueryText>
                          </con4:expr>
                        </con4:assign>
                        <con4:replace varName="body" contents-only="true">
                          <con3:id>_ActionId-367289871648706837--1abe819.1435a993350.-7f63</con3:id>
                          <con4:location>
                            <con:xpathText xmlns:con="http://www.bea.com/wli/sb/stages/config">.</con:xpathText>
                          </con4:location>
                          <con4:expr>
                            <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$peticionIDSE</con:xqueryText>
                          </con4:expr>
                        </con4:replace>
                      </con5:outboundTransform>
                    </con5:route>
                  </con4:actions>
                </con4:case>
                <con4:default>
                  <con5:route>
                    <con3:id>_ActionId-2698253971106577746--3ca74642.142b493cbc7.-7fd3</con3:id>
                    <con5:service ref="AsignacionNSSProject/IdseProxyService" xsi:type="ref:ProxyRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
                    <con5:outboundTransform>
                      <con4:assign varName="peticionIDSE">
                        <con3:id>_ActionId-2698253971106577746--3ca74642.142b493cbc7.-7fd2</con3:id>
                        <con4:expr>
                          <con3:xqueryText><![CDATA[<idse:MovimientoIdse xmlns:idse="http://www.mx.gob.imss.ctirss.delta.idse/idse_schema">
    <idse:registroPatronal>{fn:substring($registroPatronal, 1,10)}</idse:registroPatronal>
    <idse:digitoVerificadorRP>{fn:substring($registroPatronal, 11, 1)}</idse:digitoVerificadorRP>
    <idse:folioArchivo>{$folioArchivo}</idse:folioArchivo>
    <idse:nSS></idse:nSS>
    <idse:digitoVerificadorNSS></idse:digitoVerificadorNSS>
    <idse:primerApellido>{$empleado/APELLIDO_PATERNO/text()}</idse:primerApellido>
    <idse:segundoApellido>{$empleado/APELLIDO_MATERNO/text()}</idse:segundoApellido>
    <idse:nombreDelEstudiante>{$empleado/NOMBRE/text()}</idse:nombreDelEstudiante>
    <idse:tipoDeTrabajador>2</idse:tipoDeTrabajador>
    <idse:tipoDeSalario>1</idse:tipoDeSalario>
    <idse:semanaOJornadaReducida>0</idse:semanaOJornadaReducida>
    <idse:fechaDelMovimiento>{$altaEstudianteResponseDocument/aseg:return/asegI:FechaOperacion/text()}</idse:fechaDelMovimiento>
    <idse:unidadDeMedicinaFamiliar>{$altaEstudianteResponseDocument/aseg:return/asegI:Umf/asegI:NoEconomico/text()}</idse:unidadDeMedicinaFamiliar>
    <idse:tipoDeMovimiento>08</idse:tipoDeMovimiento>
    <idse:curp_o_Rfc>{$altaEstudianteResponseDocument/aseg:return/asegI:Curp/text()}</idse:curp_o_Rfc>
    <idse:idFormato>9</idse:idFormato>
</idse:MovimientoIdse>]]></con3:xqueryText>
                        </con4:expr>
                      </con4:assign>
                      <con4:replace varName="body" contents-only="true">
                        <con3:id>_ActionId-2698253971106577746--3ca74642.142b493cbc7.-7fd1</con3:id>
                        <con4:location>
                          <con:xpathText xmlns:con="http://www.bea.com/wli/sb/stages/config">.</con:xpathText>
                        </con4:location>
                        <con4:expr>
                          <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$peticionIDSE</con:xqueryText>
                        </con4:expr>
                      </con4:replace>
                    </con5:outboundTransform>
                  </con5:route>
                </con4:default>
