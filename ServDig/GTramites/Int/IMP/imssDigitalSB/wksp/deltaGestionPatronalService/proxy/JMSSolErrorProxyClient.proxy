<?xml version="1.0" encoding="UTF-8"?>
<xml-fragment xmlns:ser="http://www.bea.com/wli/sb/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:con="http://www.bea.com/wli/sb/typesystem/config" xmlns:tran="http://www.bea.com/wli/sb/transports" xmlns:env="http://www.bea.com/wli/config/env" xmlns:con1="http://www.bea.com/wli/sb/pipeline/config" xmlns:con2="http://www.bea.com/wli/sb/stages/config" xmlns:con3="http://www.bea.com/wli/sb/stages/transform/config" xmlns:con4="http://www.bea.com/wli/sb/stages/logging/config" xmlns:jms="http://www.bea.com/wli/sb/transports/jms" xmlns:con5="http://www.bea.com/wli/sb/stages/publish/config">
  <ser:coreEntry isProxy="true" isEnabled="true" isAutoPublish="false" isTracingEnabled="false">
    <ser:description>Consume los mensajes almacenados en la cola de mensajes de error con el fin de notificar al usuario que hubo un error y cancelar la solicitud.</ser:description>
    <ser:binding type="Mixed" xsi:type="con:MixedBindingType" xmlns:con="http://www.bea.com/wli/sb/services/bindings/config">
      <con:request type="XML">
        <con6:schema ref="deltaGestionPatronalService/schema/ServiceContract/JMSConcluirSolicitudConsumer" element="JMSProducer_Input" xmlns:con6="http://www.bea.com/wli/sb/typesystem/config"/>
      </con:request>
    </ser:binding>
    <ser:monitoring isEnabled="false">
      <ser:aggregationInterval>10</ser:aggregationInterval>
      <ser:pipelineMonitoringLevel>Pipeline</ser:pipelineMonitoringLevel>
    </ser:monitoring>
    <ser:reporting>true</ser:reporting>
    <ser:logging isEnabled="true">
      <ser:logLevel>debug</ser:logLevel>
    </ser:logging>
    <ser:sla-alerting isEnabled="true">
      <ser:alertLevel>normal</ser:alertLevel>
    </ser:sla-alerting>
    <ser:pipeline-alerting isEnabled="true">
      <ser:alertLevel>normal</ser:alertLevel>
    </ser:pipeline-alerting>
    <ser:largeMessageSupport isEnabled="true">
      <ser:persistToFile>false</ser:persistToFile>
      <ser:enableCompression>true</ser:enableCompression>
    </ser:largeMessageSupport>
    <ser:transactions isRequired="true" sameTxForResponse="false"/>
  </ser:coreEntry>
  <ser:endpointConfig>
    <tran:provider-id>jms</tran:provider-id>
    <tran:inbound>true</tran:inbound>
    <tran:URI>
      <env:value>jms://172.24.116.37:15051,172.24.116.37:15052/jms.SolicitudConnectionFactory/jms.SolicitudErrorDistributedQueue</env:value>
    </tran:URI>
    <tran:inbound-properties/>
    <tran:all-headers>true</tran:all-headers>
    <tran:provider-specific>
      <jms:is-queue>true</jms:is-queue>
      <jms:is-secure>false</jms:is-secure>
      <jms:inbound-properties>
        <jms:response-required>false</jms:response-required>
        <jms:XA-required>false</jms:XA-required>
      </jms:inbound-properties>
      <jms:request-encoding>UTF-8</jms:request-encoding>
      <jms:jndi-timeout>0</jms:jndi-timeout>
    </tran:provider-specific>
  </ser:endpointConfig>
  <ser:router>
    <con1:pipeline name="PipelinePairNode1_request" type="request">
      <con1:stage name="Notificar Error en la conclusion">
        <con1:comment/>
        <con1:context>
          <con2:userNsDecl prefix="sol" namespace="solicitud:mx.gob.imss.ctirss.delta.model.gestion.solicitud"/>
          <con2:userNsDecl prefix="gbl" namespace="gblModel:mx.gob.imss.ctirss.delta.global.model"/>
          <con2:userNsDecl prefix="fwbm" namespace="fwbm:mx.gob.imss.ctirss.delta.framework.base.model"/>
          <con2:userNsDecl prefix="javaSolicitud" namespace="java:mx.gob.imss.ctirss.delta.model.gestion.solicitud"/>
          <con2:userNsDecl prefix="jgbl" namespace="java:mx.gob.imss.ctirss.delta.global.model"/>
          <con2:userNsDecl prefix="m" namespace="http://mx.gob.imss.delta.global.service/"/>
          <con2:varNsDecl prefix="mx" namespace="http://mx.gob.imss.delta.global.services/"/>
        </con1:context>
        <con1:actions>
          <con4:log>
            <con2:id>_ActionId-4611628466107087791--4c167a6e.1414cd7ff8f.-7f10</con2:id>
            <con4:logLevel>error</con4:logLevel>
            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$body/mx:JMSProducer_Input/mx:FolioSolicitud/text()</con:xqueryText>
            </con4:expr>
            <con4:message>Entrada</con4:message>
          </con4:log>
          <con3:assign varName="folioSolicitud">
            <con2:id>_ActionId-4611628466107087791--4c167a6e.1414cd7ff8f.-7f0f</con2:id>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$body/mx:JMSProducer_Input/mx:FolioSolicitud/text()</con:xqueryText>
            </con3:expr>
          </con3:assign>
          <con3:assign varName="mensajeError">
            <con2:id>_ActionId-4611628466107087791--4c167a6e.1414cd7ff8f.-7f0e</con2:id>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">"Se ha presentado un error al finalizar la solicitud, por favor reintente concluir la solicitud en unos minutos..."</con:xqueryText>
            </con3:expr>
          </con3:assign>
          <con5:route>
            <con2:id>_ActionId-4611628466107087791--4c167a6e.1414cd7ff8f.-7f0d</con2:id>
            <con5:service ref="deltaGestionPatronalService/businessService/DeltaSolicitudBusinessService" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
            <con5:operation>notificarErrorProcesamiento</con5:operation>
            <con5:outboundTransform>
              <con3:assign varName="notificarErrorRequest">
                <con2:id>_ActionId-4611628466107087791--4c167a6e.1414cd7ff8f.-7f0c</con2:id>
                <con3:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config"><![CDATA[<mx:notificarErrorProcesamiento xmlns:mx="http://mx.gob.imss.delta.global.service/">
    <mx:arg0>0</mx:arg0>
    <mx:arg1>{$folioSolicitud}</mx:arg1>
    <mx:arg2></mx:arg2>
</mx:notificarErrorProcesamiento>]]></con:xqueryText>
                </con3:expr>
              </con3:assign>
              <con3:replace varName="body" contents-only="true">
                <con2:id>_ActionId-4611628466107087791--4c167a6e.1414cd7ff8f.-7f0b</con2:id>
                <con3:location>
                  <con:xpathText xmlns:con="http://www.bea.com/wli/sb/stages/config">.</con:xpathText>
                </con3:location>
                <con3:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$notificarErrorRequest</con:xqueryText>
                </con3:expr>
              </con3:replace>
              <con3:routing-options>
                <con2:id>_ActionId-4611628466107087791--4c167a6e.1414cd7ff8f.-7f0a</con2:id>
                <con3:qualityOfService>exactly-once</con3:qualityOfService>
              </con3:routing-options>
              <con4:log>
                <con2:id>_ActionId-298615991039842170-152479ec.142489ff486.-7ff4</con2:id>
                <con4:logLevel>error</con4:logLevel>
                <con4:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$notificarErrorRequest</con:xqueryText>
                </con4:expr>
                <con4:message>notificando error de procesamiento</con4:message>
              </con4:log>
            </con5:outboundTransform>
          </con5:route>
          <con5:route>
            <con2:id>_ActionId-4611628466107087791--4c167a6e.1414cd7ff8f.-7f09</con2:id>
            <con5:service ref="deltaGestionPatronalService/proxy/mail/DynamicProxyServer" xsi:type="ref:ProxyRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
            <con5:outboundTransform>
              <con3:replace varName="body" contents-only="true">
                <con2:id>_ActionId-4611628466107087791--4c167a6e.1414cd7ff8f.-7f08</con2:id>
                <con3:location>
                  <con:xpathText xmlns:con="http://www.bea.com/wli/sb/stages/config">.</con:xpathText>
                </con3:location>
                <con3:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config"><![CDATA[<mx:EmailPayload xmlns:mx="http://mx.gob.imss.email.model">
    <mx:FromAccountName>Portal IMSS Digital</mx:FromAccountName>
    <mx:To>martha.lopezp@imss.gob.mx</mx:To>
    <mx:ReplyToAddress></mx:ReplyToAddress>
    <mx:Subject>Solicitud {$folioSolicitud} finalizada</mx:Subject>
    <mx:Content>Se ha producido un error al procesar la solicitud con folio: {$folioSolicitud}, por favor intente concluir esta solicitud en unos minutos...</mx:Content>
    <!--Optional:-->
    <mx:Cc></mx:Cc>
    <!--Optional:-->
    <mx:Bcc></mx:Bcc>
</mx:EmailPayload>]]></con:xqueryText>
                </con3:expr>
              </con3:replace>
            </con5:outboundTransform>
          </con5:route>
        </con1:actions>
      </con1:stage>
    </con1:pipeline>
    <con1:pipeline name="PipelinePairNode1_response" type="response"/>
    <con1:flow>
      <con1:pipeline-node name="PipelinePairNode1">
        <con1:request>PipelinePairNode1_request</con1:request>
        <con1:response>PipelinePairNode1_response</con1:response>
      </con1:pipeline-node>
    </con1:flow>
  </ser:router>
</xml-fragment>