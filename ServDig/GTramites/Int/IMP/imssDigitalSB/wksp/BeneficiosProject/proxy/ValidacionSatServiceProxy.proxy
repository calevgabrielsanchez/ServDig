<?xml version="1.0" encoding="UTF-8"?>
<xml-fragment xmlns:ser="http://www.bea.com/wli/sb/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:con="http://www.bea.com/wli/sb/typesystem/config" xmlns:tran="http://www.bea.com/wli/sb/transports" xmlns:env="http://www.bea.com/wli/config/env" xmlns:con1="http://www.bea.com/wli/sb/pipeline/config">
  <ser:coreEntry isProxy="true" isEnabled="true" isAutoPublish="false" isTracingEnabled="false">
    <ser:description/>
    <ser:binding type="Mixed" xsi:type="con:MixedBindingType" xmlns:con="http://www.bea.com/wli/sb/services/bindings/config">
      <con:request type="XML">
        <con1:schema ref="BeneficiosProject/schema/ServiceContract/ValidacionRifSatSchema" element="validarRifSatRequest" xmlns:con1="http://www.bea.com/wli/sb/typesystem/config"/>
      </con:request>
      <con:response type="XML">
        <con1:schema ref="BeneficiosProject/schema/ServiceContract/ValidacionRifSatSchema" element="validarRifSatResponse" xmlns:con1="http://www.bea.com/wli/sb/typesystem/config"/>
      </con:response>
    </ser:binding>
    <ser:monitoring isEnabled="false">
      <ser:aggregationInterval>10</ser:aggregationInterval>
      <ser:pipelineMonitoringLevel>Pipeline</ser:pipelineMonitoringLevel>
    </ser:monitoring>
    <ser:reporting>true</ser:reporting>
    <ser:logging isEnabled="true">
      <ser:logLevel>debug</ser:logLevel>
    </ser:logging>
    <ser:sla-alerting isEnabled="true">
      <ser:alertLevel>normal</ser:alertLevel>
    </ser:sla-alerting>
    <ser:pipeline-alerting isEnabled="true">
      <ser:alertLevel>normal</ser:alertLevel>
    </ser:pipeline-alerting>
    <ser:pageAttachments isEnabled="false"/>
    <ser:transactions isRequired="true" sameTxForResponse="false"/>
  </ser:coreEntry>
  <ser:endpointConfig>
    <tran:provider-id>http</tran:provider-id>
    <tran:inbound>true</tran:inbound>
    <tran:URI>
      <env:value>/Beneficios/ValidacionSatServiceProxy</env:value>
    </tran:URI>
    <tran:inbound-properties/>
    <tran:all-headers>false</tran:all-headers>
    <tran:provider-specific xsi:type="http:HttpEndPointConfiguration" xmlns:http="http://www.bea.com/wli/sb/transports/http">
      <http:inbound-properties/>
    </tran:provider-specific>
  </ser:endpointConfig>
  <ser:router>
    <con1:pipeline name="_onErrorHandler-3360921260481779652--51f592cf.14614efb887.-7fc4" type="error">
      <con1:stage name="errorHandlerStage" xmlns:con4="http://www.bea.com/wli/sb/stages/transform/config" xmlns:http="http://www.bea.com/wli/sb/transports/http" xmlns:con2="http://www.bea.com/wli/sb/stages/config" xmlns:con3="http://www.bea.com/wli/sb/stages/logging/config">
        <con1:context>
          <con2:userNsDecl prefix="con" namespace="http://www.bea.com/wli/sb/context"/>
          <con2:userNsDecl prefix="con1" namespace="http://www.bea.com/wli/sb/stages/transform/config"/>
          <con2:userNsDecl prefix="m" namespace="http://servicios.imss.gob.mx/beneficio/riss"/>
          <con2:varNsDecl prefix="mx" namespace="http://mx.gob.imss.delta.global.service/"/>
        </con1:context>
        <con1:actions>
          <con3:log>
            <con2:id>_ActionId-3360921260481779652--51f592cf.14614efb887.-7fc3</con2:id>
            <con3:logLevel>error</con3:logLevel>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$fault</con:xqueryText>
            </con3:expr>
            <con3:message>EN EL MANEJADOR DE ERRORES</con3:message>
          </con3:log>
          <con4:assign varName="cveErrorResp">
            <con2:id>_ActionId-3360921260481779652--51f592cf.14614efb887.-7fc2</con2:id>
            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$fault/con:errorCode/text()</con:xqueryText>
            </con4:expr>
          </con4:assign>
          <con3:log>
            <con2:id>_ActionId-3360921260481779652--51f592cf.14614efb887.-7fc1</con2:id>
            <con3:logLevel>error</con3:logLevel>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$cveErrorResp</con:xqueryText>
            </con3:expr>
            <con3:message>CODIGO ERROR</con3:message>
          </con3:log>
          <con4:assign varName="descErrorResp">
            <con2:id>_ActionId-2718038593477788971-55c8536f.145fcd232d2.-7f31</con2:id>
            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">'Error de comunicación con el servicio externo del SAT'</con:xqueryText>
            </con4:expr>
          </con4:assign>
          <con3:log>
            <con2:id>_ActionId-3360921260481779652--51f592cf.14614efb887.-7fbd</con2:id>
            <con3:logLevel>error</con3:logLevel>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$descErrorResp</con:xqueryText>
            </con3:expr>
            <con3:message>MENSAJE ERROR</con3:message>
          </con3:log>
          <con4:assign varName="indDerechoBeneficioResp">
            <con2:id>_ActionId-3360921260481779652--51f592cf.14614efb887.-7fbc</con2:id>
            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">"false"</con:xqueryText>
            </con4:expr>
          </con4:assign>
          <con4:replace varName="body" contents-only="true">
            <con2:id>_ActionId-3360921260481779652--51f592cf.14614efb887.-7fbb</con2:id>
            <con4:location>
              <con:xpathText xmlns:con="http://www.bea.com/wli/sb/stages/config">.</con:xpathText>
            </con4:location>
            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config"><![CDATA[<mx:validarRifSatResponse>
	<mx:rfcVigente></mx:rfcVigente>
	<mx:indicadorDerechoBeneficio>{$indDerechoBeneficioResp}</mx:indicadorDerechoBeneficio>
	<mx:indicadorApartadoC></mx:indicadorApartadoC>
	<mx:curp></mx:curp>
	<mx:fechaInicioRIF></mx:fechaInicioRIF>
	<mx:exito>1</mx:exito>
	<mx:claveError>{$cveErrorResp}</mx:claveError>
	<mx:descripcion>{$descErrorResp}</mx:descripcion>
</mx:validarRifSatResponse>]]></con:xqueryText>
            </con4:expr>
          </con4:replace>
          <con2:reply isError="false">
            <con2:id>_ActionId-3360921260481779652--51f592cf.14614efb887.-7fba</con2:id>
          </con2:reply>
        </con1:actions>
      </con1:stage>
    </con1:pipeline>
    <con1:pipeline name="PipelinePairNode1_request" type="request">
      <con4:stage name="validarRifSatStage" errorHandler="_onErrorHandler-3360921260481779652--51f592cf.14614efb887.-7fc4" xmlns:con="http://www.bea.com/wli/sb/pipeline/config" xmlns:con1="http://www.bea.com/wli/sb/stages/config" xmlns:con2="http://www.bea.com/wli/sb/stages/logging/config" xmlns:con3="http://www.bea.com/wli/sb/stages/transform/config" xmlns:http="http://www.bea.com/wli/sb/transports/http" xmlns:con4="http://www.bea.com/wli/sb/pipeline/config">
        <con4:comment>Se llama al servicio del SAT para validar si cuenta con el régimen y si ha cumplido con todas las validaciones dentro del SAT. También nos dice si es apartado C</con4:comment>
        <con4:context>
          <con1:varNsDecl prefix="mx" namespace="http://mx.gob.imss.delta.global.service/"/>
        </con4:context>
        <con4:actions>
          <con3:assign varName="RFC_SAT">
            <con1:id>_ActionId-4620114698667468896-c11a0ae.145e146d065.-7fcc</con1:id>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$body/mx:validarRifSatRequest/mx:rfc/text()</con:xqueryText>
            </con3:expr>
          </con3:assign>
          <con2:log>
            <con1:id>_ActionId-4620114698667468896-c11a0ae.145e146d065.-7fd1</con1:id>
            <con2:logLevel>error</con2:logLevel>
            <con2:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$RFC_SAT</con:xqueryText>
            </con2:expr>
            <con2:message>Se va a consultar al SAT con el siguiente RFC:</con2:message>
          </con2:log>
          <con3:wsCallout>
            <con1:id>_ActionId-4620114698667468896-c11a0ae.145e146d065.-7fd0</con1:id>
            <con3:service ref="BeneficiosProject/businessService/ValidarRissSatBusinessService" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
            <con3:operation>validarDerechoBeneficioRif</con3:operation>
            <con3:request>
              <con3:body wrapped="false">$validarRifSatRequest</con3:body>
              <con3:header/>
            </con3:request>
            <con3:response>
              <con3:body wrapped="false">validarRifSatResponseTmp</con3:body>
              <con3:header/>
            </con3:response>
            <con3:requestTransform>
              <con3:assign varName="validarRifSatRequest">
                <con1:id>_ActionId-4620114698667468896-c11a0ae.145e146d065.-7fcf</con1:id>
                <con3:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config"><![CDATA[<val:validarDerechoBeneficioRifRequest xmlns:val="http://sat.gob.mx/ws/ValidarDerechoBeneficioRif">
    <rfc>{$RFC_SAT}</rfc>
    <indicadorInstitucionConsulta>1</indicadorInstitucionConsulta>
</val:validarDerechoBeneficioRifRequest>]]></con:xqueryText>
                </con3:expr>
              </con3:assign>
            </con3:requestTransform>
            <con3:responseTransform>
              <con2:log>
                <con1:id>_ActionId-4620114698667468896-c11a0ae.145e146d065.-7fce</con1:id>
                <con2:logLevel>error</con2:logLevel>
                <con2:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$validarRifSatResponseTmp</con:xqueryText>
                </con2:expr>
                <con2:message>LA RESPUESTA DEL SAT ES:</con2:message>
              </con2:log>
              <con3:assign varName="validarRifSatResponse">
                <con5:id xmlns:con5="http://www.bea.com/wli/sb/stages/config">_ActionId-1981946144262031613--5cf52273.1461a4314e7.-7fef</con5:id>
                <con3:expr>
                  <con:xqueryTransform xmlns:con="http://www.bea.com/wli/sb/stages/config">
                    <con:resource ref="BeneficiosProject/xquery/TransformaValidaRIFResponse"/>
                    <con:param name="serviceResponse">
                      <con:path>$validarRifSatResponseTmp</con:path>
                    </con:param>
                  </con:xqueryTransform>
                </con3:expr>
              </con3:assign>
              <con2:log>
                <con1:id>_ActionId-1981946144262031613--5cf52273.1461a4314e7.-7fee</con1:id>
                <con2:logLevel>error</con2:logLevel>
                <con2:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$validarRifSatResponse/mx:indicadorDerechoBeneficio/text()</con:xqueryText>
                </con2:expr>
                <con2:message>El RFC es candidato al RIF</con2:message>
              </con2:log>
              <con3:replace varName="body" contents-only="true">
                <con1:id>_ActionId-4620114698667468896-c11a0ae.145e146d065.-7fca</con1:id>
                <con3:location>
                  <con:xpathText xmlns:con="http://www.bea.com/wli/sb/stages/config">.</con:xpathText>
                </con3:location>
                <con3:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$validarRifSatResponse</con:xqueryText>
                </con3:expr>
              </con3:replace>
            </con3:responseTransform>
          </con3:wsCallout>
        </con4:actions>
      </con4:stage>
    </con1:pipeline>
    <con1:pipeline name="PipelinePairNode1_response" type="response">
      <con1:stage name="responseStage" xmlns:con2="http://www.bea.com/wli/sb/stages/config" xmlns:con3="http://www.bea.com/wli/sb/stages/logging/config">
        <con1:comment/>
        <con1:context>
          <con2:varNsDecl prefix="mx" namespace="http://mx.gob.imss.delta.global.service/"/>
        </con1:context>
        <con1:actions>
          <con3:log>
            <con2:id>_ActionId-6140452112033537740--5e354702.1464947d828.-7fee</con2:id>
            <con3:logLevel>error</con3:logLevel>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$body</con:xqueryText>
            </con3:expr>
            <con3:message>RESPUESTA DESDE ValidacionSatServiceProxy</con3:message>
          </con3:log>
        </con1:actions>
      </con1:stage>
    </con1:pipeline>
    <con1:flow>
      <con1:pipeline-node name="PipelinePairNode1">
        <con1:request>PipelinePairNode1_request</con1:request>
        <con1:response>PipelinePairNode1_response</con1:response>
      </con1:pipeline-node>
    </con1:flow>
  </ser:router>
</xml-fragment>