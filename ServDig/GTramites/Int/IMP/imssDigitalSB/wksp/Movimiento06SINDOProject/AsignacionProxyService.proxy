<?xml version="1.0" encoding="UTF-8"?>
<xml-fragment xmlns:ser="http://www.bea.com/wli/sb/services" xmlns:tran="http://www.bea.com/wli/sb/transports" xmlns:env="http://www.bea.com/wli/config/env" xmlns:http="http://www.bea.com/wli/sb/transports/http" xmlns:file="http://www.bea.com/wli/sb/transports/file" xmlns:con="http://www.bea.com/wli/sb/pipeline/config" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:con1="http://www.bea.com/wli/sb/typesystem/config" xmlns:con2="http://www.bea.com/wli/sb/stages/config" xmlns:con3="http://www.bea.com/wli/sb/stages/logging/config" xmlns:con4="http://www.bea.com/wli/sb/stages/transform/config" xmlns:jms="http://www.bea.com/wli/sb/transports/jms">
  <ser:coreEntry isProxy="true" isEnabled="true" isAutoPublish="false" isTracingEnabled="false">
    <ser:binding type="Mixed" xsi:type="con1:MixedBindingType" xmlns:con1="http://www.bea.com/wli/sb/services/bindings/config">
      <con1:request type="XML">
        <con5:schema ref="Movimiento06SINDOProject/schemas/movimientoasignacion" element="MovimientoAsignacion" xmlns:con5="http://www.bea.com/wli/sb/typesystem/config"/>
      </con1:request>
    </ser:binding>
    <ser:monitoring isEnabled="false">
      <ser:aggregationInterval>10</ser:aggregationInterval>
      <ser:pipelineMonitoringLevel>Pipeline</ser:pipelineMonitoringLevel>
    </ser:monitoring>
    <ser:reporting>true</ser:reporting>
    <ser:logging isEnabled="true">
      <ser:logLevel>debug</ser:logLevel>
    </ser:logging>
    <ser:sla-alerting isEnabled="true">
      <ser:alertLevel>normal</ser:alertLevel>
    </ser:sla-alerting>
    <ser:pipeline-alerting isEnabled="true">
      <ser:alertLevel>normal</ser:alertLevel>
    </ser:pipeline-alerting>
  </ser:coreEntry>
  <ser:endpointConfig>
    <tran:provider-id>jms</tran:provider-id>
    <tran:inbound>true</tran:inbound>
    <tran:URI>
      <env:value>jms://172.24.116.37:15051,172.24.116.37:15052/jms.GeneralConnectionFactory/jms.AsignNSScanaseDistributedQueue</env:value>
    </tran:URI>
    <tran:inbound-properties/>
    <tran:all-headers>false</tran:all-headers>
    <tran:provider-specific xsi:type="jms:JmsEndPointConfiguration">
      <jms:is-queue>true</jms:is-queue>
      <jms:is-secure>false</jms:is-secure>
      <jms:inbound-properties>
        <jms:response-required>false</jms:response-required>
        <jms:XA-required>false</jms:XA-required>
      </jms:inbound-properties>
      <jms:jms-service-account ref="Movimiento06SINDOProject/DeltaSindoAccount"/>
      <jms:request-encoding>UTF-8</jms:request-encoding>
      <jms:jndi-timeout>0</jms:jndi-timeout>
    </tran:provider-specific>
  </ser:endpointConfig>
  <ser:router>
    <con:pipeline type="request" name="EnviarAsignaciones_request">
      <con:stage name="PrepararAsignacion">
        <con:context>
          <con2:varNsDecl namespace="http://www.mx.gob.imss.ctirss.delta/movimientoasignacion" prefix="mov"/>
        </con:context>
        <con:actions>
          <con1:assign varName="cizOrigen" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
            <con2:id>_ActionId-9052667837189718956--6b71c523.13faa463ccf.-7fe8</con2:id>
            <con1:expr>
              <con2:xqueryText>$body/mov:MovimientoAsignacion/mov:cizOrigen/text()</con2:xqueryText>
            </con1:expr>
          </con1:assign>
          <con3:log>
            <con2:id>_ActionId-9052667837189718956--6b71c523.13faa463ccf.-7fd6</con2:id>
            <con3:logLevel>error</con3:logLevel>
            <con3:expr>
              <con2:xqueryText>$cizOrigen</con2:xqueryText>
            </con3:expr>
            <con3:message>Valor de Ciz</con3:message>
          </con3:log>
          <con4:assign varName="movimiento_asignacion_mfl">
            <con2:id>_ActionId-9052667837189718956--6b71c523.13faa463ccf.-7fb5</con2:id>
            <con4:expr>
              <con2:xqueryTransform>
                <con2:resource ref="Movimiento06SINDOProject/xquery/MovimientoAsignacion_mfl"/>
                <con2:param name="movimiento1">
                  <con2:path>$body/mov:MovimientoAsignacion</con2:path>
                </con2:param>
              </con2:xqueryTransform>
            </con4:expr>
          </con4:assign>
          <con3:log>
            <con2:id>_ActionId-9052667837189718956--6b71c523.13faa463ccf.-7f9c</con2:id>
            <con3:logLevel>error</con3:logLevel>
            <con3:expr>
              <con2:xqueryText>$movimiento_asignacion_mfl</con2:xqueryText>
            </con3:expr>
            <con3:message>Valor del movimiento de asignacion</con3:message>
          </con3:log>
          <con4:replace contents-only="true" varName="body">
            <con2:id>_ActionId-9052667837189718956--6b71c523.13faa463ccf.-7f47</con2:id>
            <con4:location>
              <con2:xpathText>.</con2:xpathText>
            </con4:location>
            <con4:expr>
              <con2:xqueryText>$movimiento_asignacion_mfl</con2:xqueryText>
            </con4:expr>
          </con4:replace>
          <con3:log>
            <con2:id>_ActionId-9052667837189718956--6b71c523.13faa463ccf.-7f0d</con2:id>
            <con3:logLevel>error</con3:logLevel>
            <con3:expr>
              <con2:xqueryText>$body/AsignacionPatron</con2:xqueryText>
            </con3:expr>
            <con3:message>body/AsignacionPatron
es
-----</con3:message>
          </con3:log>
          <con4:mflTransform>
            <con2:id>_ActionId-9052667837189718956--6b71c523.13faa463ccf.-7f76</con2:id>
            <con4:type>XML-To-nonXML</con4:type>
            <con4:sourceExpr>
              <con2:xqueryText>$body/AsignacionPatron</con2:xqueryText>
            </con4:sourceExpr>
            <con4:mfl-resource ref="Movimiento06SINDOProject/mfl/MovimientoAsignacion"/>
            <con4:assign-variable>trama</con4:assign-variable>
          </con4:mflTransform>
          <con3:log>
            <con2:id>_ActionId-9052667837189718956--6b71c523.13faa463ccf.-7f5f</con2:id>
            <con3:logLevel>error</con3:logLevel>
            <con3:expr>
              <con2:xqueryText>$trama</con2:xqueryText>
            </con3:expr>
            <con3:message>trama obtenida--------------></con3:message>
          </con3:log>
          <con4:javaCallout varName="nuevatrama">
            <con2:id>_ActionId-9052667837189718956--6b71c523.13faa463ccf.-7efc</con2:id>
            <con4:archive ref="Movimiento06SINDOProject/jar/layout-callout"/>
            <con4:className>mx.gob.imss.ctirss.delta.gestion.clasificacion.callouts.LayoutCallOut</con4:className>
            <con4:method>public static java.lang.String generateLayout(java.lang.String, [B)</con4:method>
            <con4:expr>
              <con2:xqueryText>'/ctirss/w/servicios4/srvs04/domains/d_osb/delta/canase/APMVIAJ.txt'</con2:xqueryText>
            </con4:expr>
            <con4:expr>
              <con2:xqueryText>$trama</con2:xqueryText>
            </con4:expr>
            <con4:return-param-as-ref>false</con4:return-param-as-ref>
          </con4:javaCallout>
          <con4:javaCallout varName="nuevatramaTemp">
            <con2:id>_ActionId-2423025352524900348-4dedc78f.143dc8eeff5.-7ff3</con2:id>
            <con4:archive ref="Movimiento06SINDOProject/jar/layout-callout"/>
            <con4:className>mx.gob.imss.ctirss.delta.gestion.clasificacion.callouts.LayoutCallOut</con4:className>
            <con4:method>public static java.lang.String generateLayout(java.lang.String, [B)</con4:method>
            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">'/ctirss/w/servicios4/srvs04/domains/d_osb/delta/canase/APMVIAJ.txt.tmp'</con:xqueryText>
            </con4:expr>
            <con4:expr>
              <con2:xqueryText>$trama</con2:xqueryText>
            </con4:expr>
            <con4:return-param-as-ref>false</con4:return-param-as-ref>
          </con4:javaCallout>
        </con:actions>
      </con:stage>
    </con:pipeline>
    <con:pipeline type="response" name="EnviarAsignaciones_response"/>
    <con:flow>
      <con:pipeline-node name="EnviarAsignaciones">
        <con:request>EnviarAsignaciones_request</con:request>
        <con:response>EnviarAsignaciones_response</con:response>
      </con:pipeline-node>
    </con:flow>
  </ser:router>
</xml-fragment>