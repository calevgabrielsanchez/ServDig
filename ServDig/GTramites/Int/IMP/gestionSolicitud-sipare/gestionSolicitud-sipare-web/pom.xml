		</dependency>

		<dependency>
			<groupId>org.hibernate</groupId>
			<artifactId>hibernate-validator</artifactId>
			<version>4.0.1.GA</version>
			<exclusions>
				<exclusion>
					<artifactId>jaxb-impl</artifactId>
