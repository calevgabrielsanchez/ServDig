          <ejb:method name="guardarRelacionSolicitudFolioCertificacion" signature="void guardarRelacionSolicitudFolioCertificacion(mx.gob.imss.ctirss.delta.model.gestion.solicitud.certificacion.retiro.SolicitudFolioCertificacion)" exclude="true">
            <ejb:operation>guardarRelacionSolicitudFolioCertificacion</ejb:operation>
