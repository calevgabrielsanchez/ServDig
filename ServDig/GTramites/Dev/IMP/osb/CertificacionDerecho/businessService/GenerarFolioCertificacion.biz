      <env:value xmlns:env="http://www.bea.com/wli/config/env">ejb:deltaJNDIProvider:folioCertificacionServiceBusiness#mx.gob.imss.ctirss.delta.gestion.solicitud.service.interfaces.FolioCertificacionServiceBusinessRemote</env:value>
