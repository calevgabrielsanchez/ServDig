        <java:RazonSocial>{$razonSocialSinAcentos}</java:RazonSocial>
        <java:Municipio>{$body/mx:requestIdse/mx:ClaveMunicipio/text()}</java:Municipio>
        <java:Sector>90</java:Sector>
        <java:Rfc>{$body/mx:requestIdse/mx:RFC/text()}</java:Rfc>
        <java:Domicilio>{$domicilioSinAcento}</java:Domicilio>
        <java:Localidad>{$localidadSinAcento}</java:Localidad>
        <java:Actividad>{$body/mx:requestIdse/mx:Actividad/text()}</java:Actividad>
        <java:Fraccion>{$body/mx:requestIdse/mx:Fraccion/text()}</java:Fraccion>
        <java:ClaseRt>{$body/mx:requestIdse/mx:Clase/text()}</java:ClaseRt>
        <java:Email>{$body/mx:requestIdse/mx:EMail/text()}</java:Email>
        <java:RepLegal>{$body/mx:requestIdse/mx:RepresentanteLegal/text()}</java:RepLegal>
    </mxIdse:idseBean>
</mxIdse:registrarAltaPatronalIDSE>]]></con:xqueryText>
            </con4:expr>
          </con4:assign>
          <con3:log>
            <con2:id>_ActionId-2718038593477788971-55c8536f.145fcd232d2.-7f4f</con2:id>
            <con3:logLevel>error</con3:logLevel>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$requestAltaIDSE</con:xqueryText>
            </con3:expr>
            <con3:message>Mensaje idse 2-0</con3:message>
          </con3:log>
        </con1:actions>
      </con1:stage>
      <con1:stage name="Invocar Alta IDSE V2">
        <con1:comment/>
        <con1:actions>
          <con4:wsCallout>
            <con2:id>_ActionId-2718038593477788971-55c8536f.145fcd232d2.-7f5c</con2:id>
            <con4:service ref="IDSEIntegracion/businessService/IDSEIntegratorService" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
            <con4:operation>registrarAltaPatronalIDSE</con4:operation>
            <con4:request>
              <con4:body wrapped="false">$requestAltaIDSE</con4:body>
              <con4:header/>
            </con4:request>
            <con4:response>
              <con4:body wrapped="false">responseAltaIDSE</con4:body>
