    </ser:pipeline-alerting>
    <ser:largeMessageSupport isEnabled="true">
      <ser:persistToFile>false</ser:persistToFile>
      <ser:enableCompression>true</ser:enableCompression>
    </ser:largeMessageSupport>
    <ser:transactions isRequired="true" sameTxForResponse="false"/>
  </ser:coreEntry>
  <ser:endpointConfig>
    <tran:provider-id>jms</tran:provider-id>
    <tran:inbound>true</tran:inbound>
    <tran:URI>
      <env:value>jms://172.24.116.37:15051,172.24.116.37:15052/jms.SolicitudConnectionFactory/jms.IDSEComplianceDistributedQueue</env:value>
    </tran:URI>
    <tran:inbound-properties/>
    <tran:all-headers>false</tran:all-headers>
    <tran:provider-specific>
      <jms:is-queue>true</jms:is-queue>
      <jms:is-secure>false</jms:is-secure>
      <jms:inbound-properties>
        <jms:response-required>false</jms:response-required>
        <jms:XA-required>false</jms:XA-required>
      </jms:inbound-properties>
      <jms:request-encoding>UTF-8</jms:request-encoding>
      <jms:jndi-timeout>0</jms:jndi-timeout>
    </tran:provider-specific>
  </ser:endpointConfig>
  <ser:router>
    <con1:pipeline name="Registar RP en IDSE_response" type="response"/>
    <con1:pipeline name="Registar RP en IDSE_request" type="request">
      <con1:stage name="Generar Documentos de Peticion">
        <con1:comment/>
        <con1:context>
          <con2:userNsDecl prefix="m" namespace="http://delta.global.services.utility/"/>
          <con2:userNsDecl prefix="sol" namespace="solicitud:mx.gob.imss.ctirss.delta.model.gestion.solicitud"/>
          <con2:userNsDecl prefix="gbl" namespace="gblModel:mx.gob.imss.ctirss.delta.global.model"/>
          <con2:userNsDecl prefix="cnrp" namespace="http://patrones.reing.ctirss.imss.gob.mx/"/>
          <con2:userNsDecl prefix="jgbl" namespace="java:mx.gob.imss.ctirss.delta.global.model"/>
          <con2:varNsDecl prefix="rp" namespace="rp:mx.gob.imss.ctirss.delta.global.model"/>
          <con2:varNsDecl prefix="fwbm" namespace="fwbm:mx.gob.imss.ctirss.delta.framework.base.model"/>
          <con2:varNsDecl prefix="mx" namespace="http://mx.gob.imss.delta.global.service/"/>
        </con1:context>
        <con1:actions>
          <con3:log>
            <con2:id>_ActionId-2038305897104497637-1f94bbad.141e132665f.-7ff0</con2:id>
            <con3:logLevel>error</con3:logLevel>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$body</con:xqueryText>
            </con3:expr>
            <con3:message>Se invocara nuevo servicio de IDSE</con3:message>
          </con3:log>
          <con4:assign varName="nrpCompleto">
            <con2:id>_ActionId-8826446041629584931--4852dc58.14223f990e8.-7ff5</con2:id>
            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">fn:concat($body/mx:requestIdse/mx:RegistroPatronal/text(), $body/mx:requestIdse/mx:DigitoVerificador/text())</con:xqueryText>
            </con4:expr>
          </con4:assign>
          <con4:assign varName="email">
            <con2:id>_ActionId-1994334658112977797-2e58690c.141ec3877e9.-7ff0</con2:id>
            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$body/mx:requestIdse/mx:EMail/text()</con:xqueryText>
            </con4:expr>
          </con4:assign>
          <con3:log>
            <con2:id>_ActionId-6496532042894576472--3828632d.142301591a1.-7ff4</con2:id>
            <con3:logLevel>error</con3:logLevel>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$body/mx:requestIdse/mx:RazonSocial/text()</con:xqueryText>
            </con3:expr>
            <con3:message>Razon social acentos</con3:message>
          </con3:log>
          <con4:assign varName="razonSocialSinAcentos">
            <con2:id>_ActionId-4287923438254745191--6df46994.14229ca7b08.-7fed</con2:id>
            <con4:expr>
              <con:xqueryTransform xmlns:con="http://www.bea.com/wli/sb/stages/config">
                <con:resource ref="deltaGestionPatronalService/XQuery/ReemplazaAcentosXQT"/>
                <con:param name="dirtyData">
