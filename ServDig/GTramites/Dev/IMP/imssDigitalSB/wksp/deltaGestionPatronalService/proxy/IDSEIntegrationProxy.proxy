                <con:resource ref="deltaGestionPatronalService/XQuery/ReemplazaAcentosXQT"/>
                <con:param name="dirtyData">
                  <con:path>$body/mx:requestIdse/mx:Localidad/text()</con:path>
                </con:param>
              </con:xqueryTransform>
            </con4:expr>
          </con4:assign>
          <con4:assign varName="requestIDSE" xmlns:con3="http://www.bea.com/wli/sb/stages/routing/config" xmlns:con5="http://www.bea.com/wli/sb/stages/logging/config" xmlns:http="http://www.bea.com/wli/sb/transports/http" xmlns:con6="http://www.bea.com/wli/sb/stages/publish/config">
            <con2:id>_ActionId-4287923438254745191--6df46994.14229ca7b08.-7fee</con2:id>
            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config"><![CDATA[<rpnp:parameters xmlns:rpnp="http://rpnp.ws.idse.imss.gob.mx/">
    <pkcs7Bean>
      <claveSerial>{$body/mx:requestIdse/mx:pkcs7Bean/mx:ClaveSerial/text()}</claveSerial>
      <nombreCompleto>{$body/mx:requestIdse/mx:pkcs7Bean/mx:NombreCompleto/text()}</nombreCompleto>
      <estatusFiel>1</estatusFiel>
      <correoElectronico>{$body/mx:requestIdse/mx:pkcs7Bean/mx:CorreoElectronico/text()}</correoElectronico>
      <curpFiel>{$body/mx:requestIdse/mx:pkcs7Bean/mx:CurpFiel/text()}</curpFiel>
      <nombreUsuario>{$body/mx:requestIdse/mx:pkcs7Bean/mx:NombreUsuario/text()}</nombreUsuario>
      <rfcAsociado>{$body/mx:requestIdse/mx:pkcs7Bean/mx:RfcAsociado/text()}</rfcAsociado>
      <fechaValidaInicio>{$body/mx:requestIdse/mx:pkcs7Bean/mx:FechaValidaInicio/text()}</fechaValidaInicio>
      <fechaValidaFin>{$body/mx:requestIdse/mx:pkcs7Bean/mx:FechaValidaFin/text()}</fechaValidaFin>
      <telefono>{$body/mx:requestIdse/mx:pkcs7Bean/mx:Telefono/text()}</telefono>
      <idRol>{$body/mx:requestIdse/mx:pkcs7Bean/mx:IdRol/text()}</idRol>
    </pkcs7Bean>     
    <regPatronBean>
        <registroPatronal>{$nrpCompleto}</registroPatronal>
        <fechaRecepcion>{$body/mx:requestIdse/mx:FechaRecepcion/text()}</fechaRecepcion>
        <fechaActivacion>{$body/mx:requestIdse/mx:FechaActivacion/text()}</fechaActivacion>
        <razonSocial>{$body/mx:requestIdse/mx:RazonSocial/text()}</razonSocial>
        <rfcRegistroPatronal>{$body/mx:requestIdse/mx:RFC/text()}</rfcRegistroPatronal>
        <tipoPersona>{$body/mx:requestIdse/mx:TipoPersona/text()}</tipoPersona>
        <estatusRP>2</estatusRP>
        <usuarioSubDel>PDigIMSS</usuarioSubDel>
    </regPatronBean>
</rpnp:parameters>]]></con:xqueryText>
            </con4:expr>
          </con4:assign>
          <con4:assign varName="regIdseRequest">
            <con2:id>_ActionId-4287923438254745191--6df46994.14229ca7b08.-7fea</con2:id>
            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config"><![CDATA[<rpnp:parametersIdse xmlns:rpnp="http://rpnp.ws.idse.imss.gob.mx/">
    <cveDel>{$body/mx:requestIdse/mx:ClaveDelegacion/text()}</cveDel>
    <cveSub>{$body/mx:requestIdse/mx:ClaveSubdelegacion/text()}</cveSub>
    <regPatron>{$body/mx:requestIdse/mx:RegistroPatronal/text()}</regPatron>
    <regPatronDig>{$body/mx:requestIdse/mx:DigitoVerificador/text()}</regPatronDig>
    <razonSocial>{$razonSocialSinAcentos}</razonSocial>
    <municipio>{$body/mx:requestIdse/mx:ClaveMunicipio/text()}</municipio>
    <sector>90</sector>
    <rfc>{$body/mx:requestIdse/mx:RFC/text()}</rfc>
    <domicilio>{$domicilioSinAcento}</domicilio>
    <localidad>{$localidadSinAcento}</localidad>
    <actividad>{$body/mx:requestIdse/mx:Actividad/text()}</actividad>
    <fraccion>{$body/mx:requestIdse/mx:Fraccion/text()}</fraccion>
    <claseRt>{$body/mx:requestIdse/mx:Clase/text()}</claseRt>
    <email>{$body/mx:requestIdse/mx:EMail/text()}</email>
    <repLegal>{$body/mx:requestIdse/mx:RepresentanteLegal/text()}</repLegal>
</rpnp:parametersIdse>]]></con:xqueryText>
            </con4:expr>
          </con4:assign>
          <con3:log>
            <con2:id>_ActionId-2718038593477788971-55c8536f.145fcd232d2.-7f50</con2:id>
            <con3:logLevel>error</con3:logLevel>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">'VERIFICACION'</con:xqueryText>
            </con3:expr>
            <con3:message>Se formará petición para servicio idse 2-0</con3:message>
          </con3:log>
          <con4:assign varName="requestAltaIDSE">
            <con2:id>_ActionId-2718038593477788971-55c8536f.145fcd232d2.-7f5d</con2:id>
            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config"><![CDATA[<mxIdse:registrarAltaPatronalIDSE xmlns:mxIdse="http://mx.gob.imss.idse/" xmlns:java="java:mx.gob.imss.ctirss.idse.model">
    <mxIdse:iectBean>
        <java:Pkcs7Bean>
            <java:ClaveSerial>{$body/mx:requestIdse/mx:pkcs7Bean/mx:ClaveSerial/text()}</java:ClaveSerial>
            <java:NombreCompleto>{$body/mx:requestIdse/mx:pkcs7Bean/mx:NombreCompleto/text()}</java:NombreCompleto>
            <java:EstatusFiel>1</java:EstatusFiel>
            <java:CorreoElectronico>{$body/mx:requestIdse/mx:pkcs7Bean/mx:CorreoElectronico/text()}</java:CorreoElectronico>
            <java:CurpFiel>{$body/mx:requestIdse/mx:pkcs7Bean/mx:CurpFiel/text()}</java:CurpFiel>
            <java:NombreUsuario>{$body/mx:requestIdse/mx:pkcs7Bean/mx:NombreUsuario/text()}</java:NombreUsuario>
            <java:RfcAsociado>{$body/mx:requestIdse/mx:pkcs7Bean/mx:RfcAsociado/text()}</java:RfcAsociado>
            <java:FechaValidaInicio>{$body/mx:requestIdse/mx:pkcs7Bean/mx:FechaValidaInicio/text()}</java:FechaValidaInicio>
            <java:FechaValidaFin>{$body/mx:requestIdse/mx:pkcs7Bean/mx:FechaValidaFin/text()}</java:FechaValidaFin>
            <java:Telefono>{$body/mx:requestIdse/mx:pkcs7Bean/mx:Telefono/text()}</java:Telefono>
            <java:IdRol>{$body/mx:requestIdse/mx:pkcs7Bean/mx:IdRol/text()}</java:IdRol>
        </java:Pkcs7Bean>
        <java:RegPatronBean>
            <java:RegistroPatronal>{$nrpCompleto}</java:RegistroPatronal>
            <java:FechaRecepcion>{$body/mx:requestIdse/mx:FechaRecepcion/text()}</java:FechaRecepcion>
            <java:FechaActivacion>{$body/mx:requestIdse/mx:FechaActivacion/text()}</java:FechaActivacion>
            <java:RazonSocial>{$body/mx:requestIdse/mx:RazonSocial/text()}</java:RazonSocial>
            <java:RfcRegistroPatronal>{$body/mx:requestIdse/mx:RFC/text()}</java:RfcRegistroPatronal>
            <java:TipoPersona>{$body/mx:requestIdse/mx:TipoPersona/text()}</java:TipoPersona>
            <java:EstatusRP>2</java:EstatusRP>
            <java:UsuarioSubDel>PDigIMSS</java:UsuarioSubDel>
        </java:RegPatronBean>
    </mxIdse:iectBean>
    <mxIdse:idseBean>
        <java:CveDel>{$body/mx:requestIdse/mx:ClaveDelegacion/text()}</java:CveDel>
        <java:CveSub>{$body/mx:requestIdse/mx:ClaveSubdelegacion/text()}</java:CveSub>
