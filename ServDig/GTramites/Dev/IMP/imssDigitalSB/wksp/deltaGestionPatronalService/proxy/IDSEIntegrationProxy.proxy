          <con2:userNsDecl prefix="fwbm" namespace="fwbm:mx.gob.imss.ctirss.delta.framework.base.model"/>
          <con2:userNsDecl prefix="mx" namespace="http://mx.gob.imss.delta.global.service/"/>
          <con2:userNsDecl prefix="m" namespace="http://delta.global.services.utility/"/>
          <con2:userNsDecl prefix="sol" namespace="solicitud:mx.gob.imss.ctirss.delta.model.gestion.solicitud"/>
          <con2:userNsDecl prefix="gbl" namespace="gblModel:mx.gob.imss.ctirss.delta.global.model"/>
          <con2:userNsDecl prefix="cnrp" namespace="http://patrones.reing.ctirss.imss.gob.mx/"/>
          <con2:userNsDecl prefix="jgbl" namespace="java:mx.gob.imss.ctirss.delta.global.model"/>
        </con1:context>
        <con1:actions>
          <con6:assign varName="htmlContent" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config" xmlns:con4="http://www.bea.com/wli/sb/pipeline/config" xmlns:con5="http://www.bea.com/wli/sb/stages/publish/config" xmlns:con6="http://www.bea.com/wli/sb/stages/transform/config">
            <con2:id>_ActionId-4287923438254745191--6df46994.14229ca7b08.-7fe2</con2:id>
            <con6:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config"><![CDATA[<html>

  <body>
<div style="width: 95%; background-color: lightgray; padding: 40px;"> 
<div style="background-color: white; margin: 0px auto; height: auto;">

	<table align="center" style="width: 80%">
		<tr>
			<td align="center">
				<h2 style="font-size:30px;">Instituto Mexicano del Seguro Social</h2>
			</td>
		</tr>
		<tr>
			<td align="center">
				<a style="line-height:40px;
					font-size:11px;
					display:inline;
					margin-left:5px;
					color:#999;"
	 				href="http://www.imss.gob.mx" title="Portal IMSS">Visita 
						el portal oficial del Instituto Mexicano del Seguro Social
				</a>
			</td>
		</tr>
	 	<tr>
			<td>
				<p style="font-size: 16px !important; ">
					Felicidades!!!!, a partir de este momento usted puede acceder a los servicios que el Instituto Mexicano del Seguro Social le proporciona mediante su portal <b>IDSE</b>. Su nuevo registro patronal <b>{$nrpCompleto}</b> esta activo para realizar los trámites electrónicos que ponemos a su disposición.
      
				</p>
<br/><h3 align="center" style="font-family: sans-serif; font-size: 18px !important; ">{$mensajeNotificacion }</h3>
			</td>
		</tr>
		<tfoot style="width: 90%">
			<tr>
				<th width="50%">
						<div style="text-align: center; padding-bottom: 30px;"> 
<img title="Portal IMSS" src="http://deltadev.imss.gob.mx/delta/resources/imagenes/header70.jpg"/> 
<p style="text-align: center; font-size: 10px;"> Reforma 476, Col. Juárez, México DF - Tel 01 800 623 23 23 - <br/> ALGUNOS DERECHOS RESERVADOS IMSS - 2012 
</p> 
</div>
				</th>
			</tr>
		</tfoot>
	</table>
</div>
</div>
   </body>

</html>]]></con:xqueryText>
            </con6:expr>
          </con6:assign>
          <con5:route xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config" xmlns:con4="http://www.bea.com/wli/sb/pipeline/config" xmlns:con5="http://www.bea.com/wli/sb/stages/publish/config">
            <con2:id>_ActionId-4287923438254745191--6df46994.14229ca7b08.-7fe1</con2:id>
            <con5:service ref="deltaGestionPatronalService/proxy/mail/DynamicProxyServer" xsi:type="ref:ProxyRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
            <con5:outboundTransform>
              <con6:replace varName="body" contents-only="true" xmlns:con6="http://www.bea.com/wli/sb/stages/transform/config">
                <con2:id>_ActionId-4287923438254745191--6df46994.14229ca7b08.-7fe0</con2:id>
                <con6:location>
                  <con:xpathText xmlns:con="http://www.bea.com/wli/sb/stages/config">.</con:xpathText>
                </con6:location>
                <con6:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config"><![CDATA[<rmx:EmailPayload xmlns:rmx="http://mx.gob.imss.email.model">
    <rmx:FromAccountName>Portal IMSS Digital</rmx:FromAccountName>
    <rmx:To>{$email}</rmx:To>
    <rmx:ReplyToAddress></rmx:ReplyToAddress>
    <rmx:Subject>Bienvenido a IDSE!!!</rmx:Subject>
    <rmx:Content>{$htmlContent}</rmx:Content>
    <rmx:ContentType>text/html</rmx:ContentType>
    <rmx:Cc></rmx:Cc>
    <rmx:Bcc></rmx:Bcc>
</rmx:EmailPayload>]]></con:xqueryText>
                </con6:expr>
              </con6:replace>
              <con3:log>
                <con2:id>_ActionId-4287923438254745191--6df46994.14229ca7b08.-7fdf</con2:id>
                <con3:logLevel>error</con3:logLevel>
                <con3:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$body</con:xqueryText>
                </con3:expr>
                <con3:message>Request del correo de notificacion:::</con3:message>
              </con3:log>
            </con5:outboundTransform>
          </con5:route>
        </con1:actions>
      </con1:stage>
    </con1:pipeline>
    <con1:flow>
      <con1:pipeline-node name="Registar RP en IDSE">
        <con1:comment/>
        <con1:request>Registar RP en IDSE_request</con1:request>
