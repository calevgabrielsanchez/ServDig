        </con1:actions>
      </con1:stage>
      <con1:stage name="Invocar Servicios de IDSE">
        <con1:comment/>
        <con1:context>
          <con2:userNsDecl prefix="rp" namespace="rp:mx.gob.imss.ctirss.delta.global.model"/>
          <con2:userNsDecl prefix="fwbm" namespace="fwbm:mx.gob.imss.ctirss.delta.framework.base.model"/>
          <con2:userNsDecl prefix="m" namespace="http://delta.global.services.utility/"/>
          <con2:userNsDecl prefix="sol" namespace="solicitud:mx.gob.imss.ctirss.delta.model.gestion.solicitud"/>
          <con2:userNsDecl prefix="gbl" namespace="gblModel:mx.gob.imss.ctirss.delta.global.model"/>
          <con2:userNsDecl prefix="cnrp" namespace="http://patrones.reing.ctirss.imss.gob.mx/"/>
          <con2:userNsDecl prefix="jgbl" namespace="java:mx.gob.imss.ctirss.delta.global.model"/>
          <con2:varNsDecl prefix="mx" namespace="http://mx.gob.imss.delta.global.service/"/>
        </con1:context>
        <con1:actions>
          <con4:assign varName="ejecutar">
            <con2:id>_ActionId-2718038593477788971-55c8536f.145fcd232d2.-7f52</con2:id>
            <con4:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">'0'</con:xqueryText>
            </con4:expr>
          </con4:assign>
          <con4:ifThenElse>
            <con2:id>_ActionId-2718038593477788971-55c8536f.145fcd232d2.-7f5b</con2:id>
            <con4:case>
              <con4:condition>
                <con2:xqueryConditionExpr>
                  <con2:compExpr operator="=">
                    <con2:leftPath>$ejecutar</con2:leftPath>
                    <con2:rightPath>'1'</con2:rightPath>
                  </con2:compExpr>
                </con2:xqueryConditionExpr>
              </con4:condition>
              <con4:actions>
                <con4:wsCallout xmlns:con3="http://www.bea.com/wli/sb/stages/routing/config" xmlns:con5="http://www.bea.com/wli/sb/stages/logging/config" xmlns:http="http://www.bea.com/wli/sb/transports/http" xmlns:con6="http://www.bea.com/wli/sb/stages/publish/config">
                  <con2:id>_ActionId-2718038593477788971-55c8536f.145fcd232d2.-7f5a</con2:id>
                  <con4:service ref="deltaGestionPatronalService/businessService/AltaPatronalIDSEBusinessService" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
                  <con4:operation>registraOperacionIETC</con4:operation>
                  <con4:request>
                    <con4:body wrapped="false">$requestIDSE</con4:body>
                    <con4:header/>
                  </con4:request>
                  <con4:response>
                    <con4:body wrapped="false">responseIDSE</con4:body>
                    <con4:header/>
                  </con4:response>
                  <con4:requestTransform>
                    <con4:replace varName="body" contents-only="true">
                      <con2:id>_ActionId-2718038593477788971-55c8536f.145fcd232d2.-7f59</con2:id>
                      <con4:location>
                        <con:xpathText xmlns:con="http://www.bea.com/wli/sb/stages/config">.</con:xpathText>
                      </con4:location>
                      <con4:expr>
                        <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$requestIDSE</con:xqueryText>
                      </con4:expr>
                    </con4:replace>
                    <con5:log>
                      <con2:id>_ActionId-2718038593477788971-55c8536f.145fcd232d2.-7f58</con2:id>
                      <con5:logLevel>error</con5:logLevel>
                      <con5:expr>
                        <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$body</con:xqueryText>
                      </con5:expr>
                      <con5:message>Invoca IDSE:::</con5:message>
                    </con5:log>
                  </con4:requestTransform>
                  <con4:responseTransform>
                    <con5:log>
                      <con2:id>_ActionId-2718038593477788971-55c8536f.145fcd232d2.-7f57</con2:id>
                      <con5:logLevel>error</con5:logLevel>
                      <con5:expr>
                        <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$responseIDSE</con:xqueryText>
                      </con5:expr>
                      <con5:message>Respuesta primera fase idse:::::</con5:message>
                    </con5:log>
                  </con4:responseTransform>
                </con4:wsCallout>
                <con4:wsCallout>
                  <con2:id>_ActionId-2718038593477788971-55c8536f.145fcd232d2.-7f56</con2:id>
                  <con4:service ref="deltaGestionPatronalService/businessService/AltaPatronalIDSEBusinessService" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
                  <con4:operation>registraOperacionIDSE</con4:operation>
                  <con4:request>
                    <con4:body wrapped="false">$regIdseRequest</con4:body>
                    <con4:header/>
                  </con4:request>
                  <con4:response>
                    <con4:body wrapped="false">regIdseResponse</con4:body>
                    <con4:header/>
                  </con4:response>
                  <con4:requestTransform>
                    <con3:log>
                      <con2:id>_ActionId-2718038593477788971-55c8536f.145fcd232d2.-7f55</con2:id>
                      <con3:logLevel>error</con3:logLevel>
                      <con3:expr>
                        <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$regIdseRequest</con:xqueryText>
                      </con3:expr>
                      <con3:message>Request registrar idse::::</con3:message>
                    </con3:log>
                    <con4:replace varName="body" contents-only="true">
                      <con2:id>_ActionId-2718038593477788971-55c8536f.145fcd232d2.-7f54</con2:id>
                      <con4:location>
                        <con:xpathText xmlns:con="http://www.bea.com/wli/sb/stages/config">.</con:xpathText>
                      </con4:location>
                      <con4:expr>
                        <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$regIdseRequest</con:xqueryText>
                      </con4:expr>
                    </con4:replace>
                  </con4:requestTransform>
                  <con4:responseTransform>
                    <con3:log>
                      <con2:id>_ActionId-2718038593477788971-55c8536f.145fcd232d2.-7f53</con2:id>
                      <con3:logLevel>error</con3:logLevel>
                      <con3:expr>
                        <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$regIdseResponse</con:xqueryText>
                      </con3:expr>
                      <con3:message>Datos Respuest Registrar IDSE</con3:message>
                    </con3:log>
                  </con4:responseTransform>
                </con4:wsCallout>
              </con4:actions>
            </con4:case>
            <con4:default>
              <con3:log>
                <con2:id>_ActionId-2718038593477788971-55c8536f.145fcd232d2.-7f51</con2:id>
                <con3:logLevel>error</con3:logLevel>
                <con3:expr>
