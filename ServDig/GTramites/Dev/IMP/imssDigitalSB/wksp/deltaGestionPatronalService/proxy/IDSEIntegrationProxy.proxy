                </con3:expr>
                <con3:message>No se ejecuto sincronizacion de versión 1:::</con3:message>
              </con3:log>
            </con4:default>
          </con4:ifThenElse>
        </con1:actions>
      </con1:stage>
      <con1:stage name="Notificar Registro de IDSE">
        <con1:comment/>
        <con1:context>
