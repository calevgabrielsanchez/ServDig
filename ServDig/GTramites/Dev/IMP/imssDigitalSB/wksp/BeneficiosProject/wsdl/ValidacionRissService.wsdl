<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://mx.gob.imss.delta.global.service/"
	xmlns="http://schemas.xmlsoap.org/wsdl/" targetNamespace="http://mx.gob.imss.delta.global.service/"
	name="ValidacionRissService">
	<types>
		<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
			targetNamespace="http://mx.gob.imss.delta.global.service/">
			<xsd:element name="validacionRissRequest">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="rfc" type="xsd:string" />
						<xsd:element name="curp" nillable="true" type="xsd:string" />
						<xsd:element name="nss" nillable="true" type="xsd:string" />
						<xsd:element name="cveAsignacion" nillable="true" type="xsd:long" />
						<xsd:element name="registrosPatronales">
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="nrp" minOccurs="1" maxOccurs="unbounded"
										nillable="true" type="xsd:string" />
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
						<xsd:element name="tipoPersona" type="xsd:string" />
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="validacionRissResponse">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="indicadorDerechoBeneficio" type="xsd:boolean" />
						<xsd:element name="tipoApartadoBeneficio" type="xsd:string" />
						<xsd:element name="fechaRif" type="xsd:string" />
						<xsd:element name="motivoDeRechazo" type="xsd:string" />
						<xsd:element name="exito" type="xsd:int" />
						<xsd:element name="claveError" type="xsd:int" />
						<xsd:element name="descripcion" type="xsd:string" />
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
		</xsd:schema>
	</types>
	<message name="request">
		<part name="validacionRissRequest" element="tns:validacionRissRequest" />
	</message>
	<message name="response">
		<part name="validacionRissResponse" element="tns:validacionRissResponse" />
	</message>
	<portType name="ValidacionRissService">
		<operation name="validar">
			<input message="tns:request" />
			<output message="tns:response" />
		</operation>
	</portType>
	<binding name="ValidacionRissServicePortBinding" type="tns:ValidacionRissService">
		<soap:binding transport="http://schemas.xmlsoap.org/soap/http"
			style="document" />
		<operation name="validar">
			<soap:operation soapAction="" />
			<input>
				<soap:body use="literal" />
			</input>
			<output>
				<soap:body use="literal" />
			</output>
		</operation>
	</binding>
	<service name="ValidacionRissService">
		<port name="ValidacionRissServicePort" binding="tns:ValidacionRissServicePortBinding">
			<soap:address
				location="http://localhost:7002/ValidacionRissService/ValidacionRissService" />
		</port>
	</service>
</definitions>