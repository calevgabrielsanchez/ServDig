            </con3:expr>
          </con3:assign>
          <con3:assign varName="motivRechazoResp">
            <con1:id>_ActionId-4620114698667468896-c11a0ae.145e146d065.-7fa6</con1:id>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">""</con:xqueryText>
            </con3:expr>
          </con3:assign>
          <con3:assign varName="exitoResp">
            <con1:id>_ActionId-4620114698667468896-c11a0ae.145e146d065.-7fa5</con1:id>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">""</con:xqueryText>
            </con3:expr>
          </con3:assign>
          <con3:assign varName="cveErrorResp">
            <con1:id>_ActionId-4620114698667468896-c11a0ae.145e146d065.-7fa4</con1:id>
            <con3:expr>
