                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$validarApartadoAResponse/mx:motivoDeRechazo/text()</con:xqueryText>
                </con3:expr>
              </con3:assign>
              <con3:assign varName="exitoResp">
                <con1:id>_ActionId-7756141520690072863-7c80175e.145e2d1a840.-7fca</con1:id>
                <con3:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$validarApartadoAResponse/mx:exito/text()</con:xqueryText>
                </con3:expr>
              </con3:assign>
              <con3:assign varName="cveErrorResp">
