      </con:stage>
      <con:stage name="consultarSATStage">
        <con:comment>Se llama al servicio del SAT para poder validar si cuenta con el régimen y si ha cumplido con todas las validaciones dentro del SAT. También nos dice si es apartado C</con:comment>
        <con:context>
          <con1:varNsDecl prefix="mx" namespace="http://mx.gob.imss.delta.global.service/"/>
        </con:context>
        <con:actions>
          <con2:log>
            <con1:id>_ActionId-4620114698667468896-c11a0ae.145e146d065.-7ff3</con1:id>
            <con2:logLevel>error</con2:logLevel>
            <con2:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$rfc</con:xqueryText>
            </con2:expr>
            <con2:message>Se va a consultar al SAT con el siguiente RFC:</con2:message>
          </con2:log>
          <con3:wsCallout>
            <con1:id>_ActionId-4620114698667468896-c11a0ae.145e146d065.-7ff2</con1:id>
            <con3:service ref="BeneficiosProject/proxy/ValidacionSatServiceProxy" xsi:type="ref:ProxyRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
            <con3:request>
              <con3:payload wrapped="false">$validarRifSatRequest</con3:payload>
            </con3:request>
            <con3:response>
              <con3:payload wrapped="false">validarRifSatResponse</con3:payload>
            </con3:response>
            <con3:requestTransform>
              <con3:assign varName="validarRifSatRequest">
                <con1:id>_ActionId-4620114698667468896-c11a0ae.145e146d065.-7ff1</con1:id>
                <con3:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config"><![CDATA[<mx:validarRifSatRequest xmlns:mx="http://mx.gob.imss.delta.global.service/">
    <mx:rfc>{$rfc}</mx:rfc>
    <mx:indicadorInstitucionConsulta>{$indInstConsulta}</mx:indicadorInstitucionConsulta>
</mx:validarRifSatRequest>]]></con:xqueryText>
                </con3:expr>
              </con3:assign>
            </con3:requestTransform>
            <con3:responseTransform>
              <con2:log>
                <con1:id>_ActionId-4620114698667468896-c11a0ae.145e146d065.-7ff0</con1:id>
                <con2:logLevel>error</con2:logLevel>
                <con2:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$validarRifSatResponse</con:xqueryText>
                </con2:expr>
                <con2:message>LA RESPUESTA DEL SAT ES:</con2:message>
              </con2:log>
              <con3:assign varName="indError">
                <con1:id>_ActionId-4620114698667468896-c11a0ae.145e146d065.-7fb8</con1:id>
                <con3:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$validarRifSatResponse/mx:exito/text()</con:xqueryText>
                </con3:expr>
              </con3:assign>
              <con3:assign varName="rfcVigente">
                <con1:id>_ActionId-816129164228649134-32f85c25.1461efc9c28.-7fd8</con1:id>
                <con3:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$validarRifSatResponse/mx:rfcVigente/text()</con:xqueryText>
                </con3:expr>
              </con3:assign>
              <con2:log>
                <con1:id>_ActionId-9073002872389677899-14e89f74.145f65dc55b.-7f32</con1:id>
                <con2:logLevel>error</con2:logLevel>
                <con2:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$indError</con:xqueryText>
                </con2:expr>
                <con2:message>Código error -></con2:message>
              </con2:log>
              <con4:ifThenElse xmlns:con="http://www.bea.com/wli/sb/typesystem/config" xmlns:con1="http://www.bea.com/wli/sb/pipeline/config" xmlns:con2="http://www.bea.com/wli/sb/stages/config" xmlns:con3="http://www.bea.com/wli/sb/stages/logging/config" xmlns:con4="http://www.bea.com/wli/sb/stages/transform/config">
                <con2:id>_ActionId-9073002872389677899-14e89f74.145f65dc55b.-7f41</con2:id>
                <con4:case>
                  <con4:condition>
                    <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$indError != "0"</con:xqueryText>
                  </con4:condition>
                  <con4:actions>
                    <con3:log>
                      <con2:id>_ActionId-9073002872389677899-14e89f74.145f65dc55b.-7f40</con2:id>
                      <con3:logLevel>error</con3:logLevel>
                      <con3:expr>
                        <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$indError</con:xqueryText>
                      </con3:expr>
                      <con3:message>La respuesta del servicio ValidacionSatService no fue exitosa, codigoError -></con3:message>
                    </con3:log>
                    <con4:assign varName="exitoResp">
                      <con2:id>_ActionId-9073002872389677899-14e89f74.145f65dc55b.-7f3f</con2:id>
                      <con4:expr>
                        <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$indError</con:xqueryText>
                      </con4:expr>
                    </con4:assign>
                    <con4:assign varName="cveErrorResp">
                      <con2:id>_ActionId-9073002872389677899-14e89f74.145f65dc55b.-7f3e</con2:id>
                      <con4:expr>
                        <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$validarRifSatResponse/mx:claveError/text()</con:xqueryText>
                      </con4:expr>
                    </con4:assign>
                    <con4:assign varName="descErrorResp">
                      <con2:id>_ActionId-9073002872389677899-14e89f74.145f65dc55b.-7f3d</con2:id>
                      <con4:expr>
                        <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">fn:concat('El SAT informa que "', $validarRifSatResponse/mx:descripcion/text(),'"')</con:xqueryText>
                      </con4:expr>
                    </con4:assign>
                  </con4:actions>
                </con4:case>
                <con4:default>
                  <con5:log xmlns:con="http://www.bea.com/wli/sb/pipeline/config" xmlns:con1="http://www.bea.com/wli/sb/stages/config" xmlns:con2="http://www.bea.com/wli/sb/stages/logging/config" xmlns:con3="http://www.bea.com/wli/sb/stages/transform/config" xmlns:con5="http://www.bea.com/wli/sb/stages/logging/config">
                    <con6:id xmlns:con6="http://www.bea.com/wli/sb/stages/config">_ActionId-816129164228649134-32f85c25.1461efc9c28.-7fd9</con6:id>
                    <con5:logLevel>error</con5:logLevel>
                    <con5:expr>
                      <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">fn:concat('CHECANDO SI EL RFC [', $rfc, '] ES IGUAL AL RFC VIGENTE [', $rfcVigente, '] DEVUELTO POR EL SAT')</con:xqueryText>
                    </con5:expr>
                    <con5:message/>
                  </con5:log>
                  <con4:ifThenElse>
                    <con2:id>_ActionId-816129164228649134-32f85c25.1461efc9c28.-7fe2</con2:id>
                    <con4:case>
                      <con4:condition>
                        <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$rfc != $rfcVigente</con:xqueryText>
                      </con4:condition>
                      <con4:actions>
                        <con5:log xmlns:con="http://www.bea.com/wli/sb/pipeline/config" xmlns:con1="http://www.bea.com/wli/sb/stages/config" xmlns:con2="http://www.bea.com/wli/sb/stages/logging/config" xmlns:con3="http://www.bea.com/wli/sb/stages/transform/config" xmlns:con5="http://www.bea.com/wli/sb/stages/logging/config">
                          <con6:id xmlns:con6="http://www.bea.com/wli/sb/stages/config">_ActionId-816129164228649134-32f85c25.1461efc9c28.-7fd5</con6:id>
                          <con5:logLevel>error</con5:logLevel>
                          <con5:expr>
                            <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">fn:concat('RFC [', $rfc, '] ES DIFERENTE AL RFC VIGENTE [', $rfcVigente, ']')</con:xqueryText>
                          </con5:expr>
                          <con5:message/>
                        </con5:log>
                        <con4:assign varName="exitoResp">
                          <con2:id>_ActionId-816129164228649134-32f85c25.1461efc9c28.-7fd4</con2:id>
                          <con4:expr>
                            <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">'1'</con:xqueryText>
                          </con4:expr>
                        </con4:assign>
                        <con4:assign varName="cveErrorResp">
                          <con2:id>_ActionId-816129164228649134-32f85c25.1461efc9c28.-7fd3</con2:id>
                          <con4:expr>
                            <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">'001'</con:xqueryText>
                          </con4:expr>
                        </con4:assign>
                        <con4:assign varName="descErrorResp">
                          <con2:id>_ActionId-816129164228649134-32f85c25.1461efc9c28.-7fd2</con2:id>
                          <con4:expr>
                            <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">'El RFC que se tiene en el Instituto es distinto al RFC vigente en el SAT'</con:xqueryText>
                          </con4:expr>
                        </con4:assign>
                      </con4:actions>
                    </con4:case>
                    <con4:default>
                      <con3:assign varName="indDerechoBeneficioSat" xmlns:con="http://www.bea.com/wli/sb/pipeline/config" xmlns:con1="http://www.bea.com/wli/sb/stages/config" xmlns:con2="http://www.bea.com/wli/sb/stages/logging/config" xmlns:con3="http://www.bea.com/wli/sb/stages/transform/config">
                        <con5:id xmlns:con5="http://www.bea.com/wli/sb/stages/config">_ActionId-816129164228649134-32f85c25.1461efc9c28.-7fe0</con5:id>
                        <con3:expr>
                          <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$validarRifSatResponse/mx:indicadorDerechoBeneficio/text()</con:xqueryText>
                        </con3:expr>
                      </con3:assign>
                      <con3:assign varName="indApartadoC" xmlns:con="http://www.bea.com/wli/sb/pipeline/config" xmlns:con1="http://www.bea.com/wli/sb/stages/config" xmlns:con2="http://www.bea.com/wli/sb/stages/logging/config" xmlns:con3="http://www.bea.com/wli/sb/stages/transform/config">
                        <con5:id xmlns:con5="http://www.bea.com/wli/sb/stages/config">_ActionId-816129164228649134-32f85c25.1461efc9c28.-7fdf</con5:id>
                        <con3:expr>
                          <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$validarRifSatResponse/mx:indicadorApartadoC/text()</con:xqueryText>
                        </con3:expr>
                      </con3:assign>
                      <con3:assign varName="fechaRif" xmlns:con="http://www.bea.com/wli/sb/pipeline/config" xmlns:con1="http://www.bea.com/wli/sb/stages/config" xmlns:con2="http://www.bea.com/wli/sb/stages/logging/config" xmlns:con3="http://www.bea.com/wli/sb/stages/transform/config">
                        <con5:id xmlns:con5="http://www.bea.com/wli/sb/stages/config">_ActionId-816129164228649134-32f85c25.1461efc9c28.-7fde</con5:id>
                        <con3:expr>
                          <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$validarRifSatResponse/mx:fechaInicioRIF/text()</con:xqueryText>
                        </con3:expr>
                      </con3:assign>
                      <con5:log xmlns:con="http://www.bea.com/wli/sb/pipeline/config" xmlns:con1="http://www.bea.com/wli/sb/stages/config" xmlns:con2="http://www.bea.com/wli/sb/stages/logging/config" xmlns:con3="http://www.bea.com/wli/sb/stages/transform/config" xmlns:con5="http://www.bea.com/wli/sb/stages/logging/config">
                        <con6:id xmlns:con6="http://www.bea.com/wli/sb/stages/config">_ActionId-816129164228649134-32f85c25.1461efc9c28.-7fdd</con6:id>
                        <con5:logLevel>error</con5:logLevel>
                        <con5:expr>
                          <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$indDerechoBeneficioSat</con:xqueryText>
                        </con5:expr>
                        <con5:message>El RFC es candidato al RIF</con5:message>
                      </con5:log>
                    </con4:default>
                  </con4:ifThenElse>
                </con4:default>
              </con4:ifThenElse>
            </con3:responseTransform>
          </con3:wsCallout>
        </con:actions>
      </con:stage>
    </con:pipeline>
    <con:pipeline name="PipelinePairNode2_response" type="response"/>
    <con:pipeline name="PipelinePairNode3_request" type="request">
      <con:stage name="validacionesApartadoAStage">
        <con:comment/>
        <con:context>
          <con1:varNsDecl prefix="mx" namespace="http://mx.gob.imss.delta.global.service/"/>
        </con:context>
        <con:actions>
          <con2:log>
            <con1:id>_ActionId-7756141520690072863-7c80175e.145e2d1a840.-7fef</con1:id>
