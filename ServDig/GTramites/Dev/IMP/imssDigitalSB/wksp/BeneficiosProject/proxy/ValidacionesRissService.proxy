      </con:stage>
    </con:pipeline>
    <con:pipeline name="PipelinePairNode6_request" type="request">
      <con:stage name="validacionesApartadoBStage">
        <con:comment/>
        <con:context>
          <con1:userNsDecl prefix="m" namespace="http://servicios.imss.gob.mx/beneficio/riss"/>
          <con1:varNsDecl prefix="mx" namespace="http://mx.gob.imss.delta.global.service/"/>
        </con:context>
        <con:actions>
          <con2:log>
            <con1:id>_ActionId-9073002872389677899-14e89f74.145f65dc55b.-7fd8</con1:id>
            <con2:logLevel>error</con2:logLevel>
            <con2:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$rfc</con:xqueryText>
            </con2:expr>
            <con2:message>Se va validar como apartado B al RFC</con2:message>
          </con2:log>
          <con3:wsCallout>
            <con1:id>_ActionId-9073002872389677899-14e89f74.145f65dc55b.-7fd7</con1:id>
            <con3:service ref="BeneficiosProject/proxy/ValidarApartadoBProxy" xsi:type="ref:ProxyRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
            <con3:request>
              <con3:payload wrapped="false">$validarApartadoBRequest</con3:payload>
            </con3:request>
            <con3:response>
              <con3:payload wrapped="false">validarApartadoBResponse</con3:payload>
            </con3:response>
            <con3:requestTransform>
              <con3:assign varName="validarApartadoBRequest">
                <con1:id>_ActionId-9073002872389677899-14e89f74.145f65dc55b.-7fd6</con1:id>
                <con3:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config"><![CDATA[<mx:validacionApartadoBRequest xmlns:mx="http://mx.gob.imss.delta.global.service/">
	<mx:rfc>{$rfc}</mx:rfc>
	<mx:registrosPatronales>{$nrps/*}</mx:registrosPatronales>
	<mx:indicadorApartadoC>{$indApartadoC}</mx:indicadorApartadoC>
</mx:validacionApartadoBRequest>]]></con:xqueryText>
                </con3:expr>
              </con3:assign>
            </con3:requestTransform>
            <con3:responseTransform>
              <con2:log>
                <con1:id>_ActionId-9073002872389677899-14e89f74.145f65dc55b.-7fd5</con1:id>
                <con2:logLevel>error</con2:logLevel>
                <con2:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$validarApartadoBResponse</con:xqueryText>
                </con2:expr>
                <con2:message>La respuesta de las validaciones como apartado B es:</con2:message>
              </con2:log>
              <con3:assign varName="indDerechoApartadoB">
                <con1:id>_ActionId-9073002872389677899-14e89f74.145f65dc55b.-7fb3</con1:id>
                <con3:expr>
                  <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$validarApartadoBResponse/mx:indDerechoBeneficioApartadoB/text()</con:xqueryText>
                </con3:expr>
              </con3:assign>
            </con3:responseTransform>
          </con3:wsCallout>
        </con:actions>
      </con:stage>
    </con:pipeline>
    <con:pipeline name="PipelinePairNode7_response" type="response"/>
    <con:pipeline name="PipelinePairNode10_response" type="response"/>
    <con:pipeline name="PipelinePairNode1_response" type="response">
      <con:stage name="prepararRespuestaStage">
        <con:comment/>
        <con:context>
          <con1:varNsDecl prefix="mx" namespace="http://mx.gob.imss.delta.global.service/"/>
        </con:context>
        <con:actions>
          <con3:replace varName="body" contents-only="true">
            <con1:id>_ActionId-4620114698667468896-c11a0ae.145e146d065.-7fb3</con1:id>
            <con3:location>
              <con:xpathText xmlns:con="http://www.bea.com/wli/sb/stages/config">.</con:xpathText>
            </con3:location>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config"><![CDATA[<validacionRissResponse>
	<indicadorDerechoBeneficio>{$indDerechoBeneficioResp}</indicadorDerechoBeneficio>
	<tipoApartadoBeneficio>{$tipoApartadoBeneficioResp}</tipoApartadoBeneficio>
	<fechaRif>{$fechaRif}</fechaRif>
	<motivoDeRechazo>{$motivRechazoResp}</motivoDeRechazo>
	<exito>{$exitoResp}</exito>
	<claveError>{$cveErrorResp}</claveError>
	<descripcion>{$descErrorResp}</descripcion>
</validacionRissResponse>]]></con:xqueryText>
            </con3:expr>
          </con3:replace>
          <con2:log>
            <con1:id>_ActionId-9073002872389677899-14e89f74.145f65dc55b.-7f0c</con1:id>
            <con2:logLevel>error</con2:logLevel>
            <con2:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$body</con:xqueryText>
            </con2:expr>
            <con2:message>RESPUESTA!!!!!!!!!!!!!</con2:message>
          </con2:log>
        </con:actions>
      </con:stage>
    </con:pipeline>
    <con:pipeline name="PipelinePairNode5_request" type="request">
      <con:stage name="sinDerechoStage">
        <con:comment>Etapa que pone los valores de respuesta necesarios cuando el SAT informa que no se es sujeto al beneficio</con:comment>
        <con:context>
          <con1:varNsDecl prefix="mx" namespace="http://mx.gob.imss.delta.global.service/"/>
        </con:context>
        <con:actions>
          <con2:log>
            <con1:id>_ActionId-4620114698667468896-c11a0ae.145e146d065.-7fa9</con1:id>
            <con2:logLevel>error</con2:logLevel>
            <con2:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">$rfc</con:xqueryText>
            </con2:expr>
            <con2:message>Sin derecho RFC:</con2:message>
          </con2:log>
          <con3:assign varName="indDerechoBeneficioResp">
            <con1:id>_ActionId-4620114698667468896-c11a0ae.145e146d065.-7fa2</con1:id>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">"false"</con:xqueryText>
            </con3:expr>
          </con3:assign>
          <con3:assign varName="motivRechazoResp">
            <con1:id>_ActionId-4620114698667468896-c11a0ae.145e146d065.-7fa1</con1:id>
            <con3:expr>
              <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">fn:concat('El SAT informa que "El RFC ', $rfc, ' no es sujeto al beneficio"')</con:xqueryText>
            </con3:expr>
          </con3:assign>
        </con:actions>
      </con:stage>
    </con:pipeline>
    <con:pipeline name="PipelinePairNode4_response" type="response"/>
    <con:pipeline name="PipelinePairNode6_response" type="response"/>
    <con:pipeline name="PipelinePairNode8_response" type="response"/>
    <con:flow>
      <con:pipeline-node name="PipelinePairNode1">
        <con:request>PipelinePairNode1_request</con:request>
        <con:response>PipelinePairNode1_response</con:response>
      </con:pipeline-node>
      <con:branch-node type="condition" name="tieneDerechoBeneficio">
        <con:comment/>
        <con:branch-table variable="indDerechoBeneficioSat">
          <con:branch name="Con derecho">
            <con:operator>equals</con:operator>
            <con:value>"true"</con:value>
            <con:flow>
              <con:pipeline-node name="PipelinePairNode2">
                <con:request>PipelinePairNode2_request</con:request>
                <con:response>PipelinePairNode2_response</con:response>
              </con:pipeline-node>
              <con:branch-node type="condition" name="identificarApartado">
                <con:comment/>
                <con:branch-table variable="apartadoPersona">
                  <con:branch name="APARTADO A">
                    <con:operator>equals</con:operator>
                    <con:value>"A"</con:value>
                    <con:flow>
                      <con:pipeline-node name="PipelinePairNode3">
                        <con:request>PipelinePairNode3_request</con:request>
                        <con:response>PipelinePairNode3_response</con:response>
                      </con:pipeline-node>
                    </con:flow>
                  </con:branch>
                  <con:branch name="APARTADO B">
                    <con:operator>equals</con:operator>
                    <con:value>"B"</con:value>
                    <con:flow>
                      <con:pipeline-node name="PipelinePairNode4">
                        <con:request>PipelinePairNode4_request</con:request>
                        <con:response>PipelinePairNode4_response</con:response>
                      </con:pipeline-node>
                    </con:flow>
                  </con:branch>
                  <con:branch name="APARTADO AB">
                    <con:operator>equals</con:operator>
                    <con:value>"AB"</con:value>
                    <con:flow>
                      <con:pipeline-node name="PipelinePairNode6">
                        <con:request>PipelinePairNode6_request</con:request>
                        <con:response>PipelinePairNode6_response</con:response>
                      </con:pipeline-node>
                      <con:branch-node type="condition" name="conDerechoApartadoB">
                        <con:comment/>
                        <con:branch-table variable="indDerechoApartadoB">
                          <con:branch name="CON DERECHO APARTADO B">
                            <con:operator>equals</con:operator>
                            <con:value>"true"</con:value>
                            <con:flow>
                              <con:pipeline-node name="PipelinePairNode7">
                                <con:request>PipelinePairNode7_request</con:request>
                                <con:response>PipelinePairNode7_response</con:response>
                              </con:pipeline-node>
                            </con:flow>
                          </con:branch>
                          <con:branch name="SIN DERECHO APARTADO B">
                            <con:operator>equals</con:operator>
                            <con:value>"false"</con:value>
                            <con:flow>
                              <con:pipeline-node name="PipelinePairNode8">
                                <con:request>PipelinePairNode8_request</con:request>
                                <con:response>PipelinePairNode8_response</con:response>
                              </con:pipeline-node>
                            </con:flow>
                          </con:branch>
                          <con:default-branch>
                            <con:flow>
                              <con:pipeline-node name="PipelinePairNode9">
                                <con:request>PipelinePairNode9_request</con:request>
                                <con:response>PipelinePairNode9_response</con:response>
                              </con:pipeline-node>
                            </con:flow>
                          </con:default-branch>
                        </con:branch-table>
                      </con:branch-node>
                    </con:flow>
                  </con:branch>
                  <con:default-branch>
                    <con:flow/>
                  </con:default-branch>
                </con:branch-table>
              </con:branch-node>
            </con:flow>
          </con:branch>
          <con:branch name="Sin derecho">
            <con:operator>equals</con:operator>
            <con:value>"false"</con:value>
            <con:flow>
              <con:pipeline-node name="PipelinePairNode5">
                <con:request>PipelinePairNode5_request</con:request>
                <con:response>PipelinePairNode5_response</con:response>
              </con:pipeline-node>
            </con:flow>
          </con:branch>
          <con:default-branch>
            <con:flow>
              <con:pipeline-node name="PipelinePairNode10">
                <con:request>PipelinePairNode10_request</con:request>
                <con:response>PipelinePairNode10_response</con:response>
              </con:pipeline-node>
            </con:flow>
          </con:default-branch>
        </con:branch-table>
      </con:branch-node>
    </con:flow>
  </ser:router>
</xml-fragment>