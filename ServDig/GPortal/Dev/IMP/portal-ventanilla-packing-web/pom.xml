<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>mx.gob.imss.ctirss.delta.portal</groupId>
	<artifactId>portal-ventanilla-packing-web</artifactId>
	<version>1.0-SNAPSHOT</version>
	<name>Modulo Empaquetador de Aplicaciones Web de Ventanilla DELTA</name>
	<url>http://maven.apache.org</url>
	<packaging>ear</packaging>

	<parent>
		<artifactId>portal</artifactId>
		<groupId>mx.gob.imss.ctirss.delta.portal</groupId>
		<version>2.2-SNAPSHOT</version>
	</parent>

	<dependencies>
		<!-- INICIO DE LAS DEPENDENCIAS DE LAS APLICACIONES WEB DELTA -->

		<!-- Modulo WEB de individuos -->
		<dependency>
			<groupId>mx.gob.imss.ctirss.delta.gestion.individuo.web</groupId>
			<artifactId>gestionIndividuo-consulta-web-ventanilla</artifactId>
			<type>war</type>
			<version>${delta.personas}</version>
		</dependency>

		<!-- Modulo WEB de domicilios -->
		<dependency>
			<groupId>mx.gob.imss.ctirss.delta.gestion.domicilio</groupId>
			<artifactId>gestionDomicilios-web-ventanilla</artifactId>
			<type>war</type>
			<version>${delta.domicilios}</version>
		</dependency>

		<!-- War de Patrones -->
		<dependency>
			<groupId>mx.gob.imss.ctirss.delta.gestion.patronal</groupId>
			<artifactId>delta-gestionPatronal-web-ventanilla</artifactId>
			<version>${gestion.patronal.version}</version>
			<type>war</type>
		</dependency>
		
		<!-- War de Cuestionarios -->
		<dependency>
			<groupId>mx.gob.imss.ctirss.delta.gestion.seguroVoluntario</groupId>
			<artifactId>gestionSeguroVoluntario-web-ventanilla</artifactId>
			<version>${delta.seguroVoluntario}</version>
			<type>war</type>
		</dependency>
		
		<!-- FIN DE LAS DEPENDENCIAS DE LAS APLICACIONES WEB DELTA -->
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>2.3.2</version>
				<configuration>
					<source>1.6</source>
					<target>1.6</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-ear-plugin</artifactId>
				<version>2.6</version>
				<configuration>
					<version>5</version>
					<defaultLibBundleDir>lib</defaultLibBundleDir>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>properties-maven-plugin</artifactId>
				<version>1.0-alpha-1</version>
				<executions>
					<execution>
						<phase>initialize</phase>
						<goals>
							<goal>read-project-properties</goal>
						</goals>
						<configuration>
							<files>
								<file>configuracion-local.properties</file>
							</files>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Habilita los facets y natures para que el eclipse reconoza el proyecto 
				como de tipo de EAR. -->
			<plugin>
				<artifactId>maven-eclipse-plugin</artifactId>
				<configuration>
					<additionalBuildcommands>
						<buildCommand>
							<name>org.eclipse.jdt.core.javabuilder</name>
						</buildCommand>
						<buildCommand>
							<name>org.eclipse.wst.common.project.facet.core.builder</name>
						</buildCommand>
						<buildCommand>
							<name>org.eclipse.wst.validation.validationbuilder</name>
						</buildCommand>

					</additionalBuildcommands>
					<additionalProjectnatures>
						<projectnature>org.eclipse.wst.common.project.facet.core.nature</projectnature>
						<projectnature>org.eclipse.jdt.core.javanature</projectnature>
						<projectnature>org.eclipse.wst.common.modulecore.ModuleCoreNature</projectnature>
						<projectnature>org.eclipse.jem.workbench.JavaEMFNature</projectnature>
					</additionalProjectnatures>
					<additionalConfig>
						<file>
							<name>.settings/org.eclipse.wst.common.project.facet.core.xml</name>
							<content>
							<![CDATA[
								<faceted-project>
									<runtime name="Weblogic Runtime" />
									<fixed facet="jst.ear" />
									<fixed facet="jst.java" />
									<installed facet="jst.java" version="6.0" />
									<installed facet="jst.ear" version="5.0" />
									<installed facet="wls.ear" version="10.3.4" />
								</faceted-project>
							]]>
							</content>
						</file>
						<file>
							<name>.settings/org.eclipse.wst.common.component</name>
							<content>
							<![CDATA[
								<project-modules id="moduleCoreId" project-version="1.5.0">
									<wb-module deploy-name="${project.artifactId}">
										<wb-resource deploy-path="/" source-path="/src/main/java" />
										<wb-resource deploy-path="/" source-path="/src/main/resources" />
										<property name="java-output-path" value="target/classes" />
									</wb-module>
								</project-modules>
							]]>
							</content>
						</file>
					</additionalConfig>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
