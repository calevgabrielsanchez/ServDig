<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<artifactId>gestionIndividuo</artifactId>
		<groupId>mx.gob.imss.ctirss.delta.gestion.individuo</groupId>
		<version>2.4</version>
	</parent>

	<groupId>mx.gob.imss.ctirss.delta.gestion.individuo.packing</groupId>
	<artifactId>gestionIndividuo-packing-web</artifactId>
	<packaging>ear</packaging>
	<name>gestionIndividuo-packing-web</name>
	<url>http://maven.apache.org</url>

	<dependencies>

		<!-- WAR'S DE OTROS MODULOS. MEDIOS DE CONTACTO. -->
		<dependency>
			<groupId>mx.gob.imss.ctirss.delta.gestion.medio.contacto</groupId>
			<artifactId>gestionMediosContacto-web</artifactId>
			<version>${delta.medioscontacto}</version>
			<type>war</type>
		</dependency>

		<!-- WAR'S DE OTROS MODULOS. DOMICILIOS -->
		<dependency>
			<groupId>mx.gob.imss.ctirss.delta.gestion.domicilio</groupId>
			<artifactId>gestionDomicilios-web</artifactId>
			<version>${delta.domicilios}</version>
			<type>war</type>
		</dependency>
		
		<!-- DEPENDENCIAS DE GESTION-INDIVIDUO-->
		<dependency>
			<groupId>mx.gob.imss.ctirss.delta.gestion.individuo.web</groupId>
			<artifactId>gestionIndividuo-web</artifactId>
			<type>war</type>
			<version>${delta.personas}</version>
		</dependency>
		
		<!-- DEPENDENCIAS DEL MÓDULO CONSULTA WEB -->
		<dependency>
			<groupId>mx.gob.imss.ctirss.delta.gestion.individuo.web</groupId>
			<artifactId>gestionIndividuo-consulta-web</artifactId>
			<type>war</type>
			<version>${delta.personas}</version>
		</dependency>
		
		<!-- WAR'S DE OTROS MODULOS. DOCUMENTOS PROBATORIOS -->
		<dependency>
			<groupId>mx.gob.imss.ctirss.delta.gestion.documento.probatorio</groupId>
			<artifactId>gestionDocumentoProbatorio-web</artifactId>
			<version>${delta.documentos.probatorios}</version>
			<type>war</type>
		</dependency>
		
		<!-- WAR'S DE OTROS MODULOS. SOLICITUD -->
		<dependency>
			<groupId>mx.gob.imss.ctirss.delta.gestion.solicitud</groupId>
			<artifactId>gestionSolicitud-web</artifactId>
			<version>${gestion.solicitud.version}</version>
			<type>war</type>
		</dependency>
		
	</dependencies>

	<build>	
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-ear-plugin</artifactId>
				<version>2.6</version>
				<configuration>
					<version>5</version>
					<defaultLibBundleDir>lib</defaultLibBundleDir>
				</configuration>
			</plugin>

			<!-- Habilita los facets y natures para que el eclipse reconoza el proyecto 
				como de tipo de EAR. -->
			<plugin>
				<artifactId>maven-eclipse-plugin</artifactId>
				<configuration>
					<additionalBuildcommands>
						<buildCommand>
							<name>org.eclipse.jdt.core.javabuilder</name>
						</buildCommand>
						<buildCommand>
							<name>org.eclipse.wst.common.project.facet.core.builder</name>
						</buildCommand>
						<buildCommand>
							<name>org.eclipse.wst.validation.validationbuilder</name>
						</buildCommand>
			
					</additionalBuildcommands>
					<additionalProjectnatures>
						<projectnature>org.eclipse.wst.common.project.facet.core.nature</projectnature>
						<projectnature>org.eclipse.jdt.core.javanature</projectnature>
						<projectnature>org.eclipse.wst.common.modulecore.ModuleCoreNature</projectnature>
						<projectnature>org.eclipse.jem.workbench.JavaEMFNature</projectnature>
					</additionalProjectnatures>
					<additionalConfig>
						<file>
							<name>.settings/org.eclipse.wst.common.project.facet.core.xml</name>
							<content>
							<![CDATA[
								<faceted-project>
									<runtime name="Weblogic Runtime" />
									<fixed facet="jst.ear" />
									<fixed facet="jst.java" />
									<installed facet="jst.java" version="6.0" />
									<installed facet="jst.ear" version="5.0" />
									<installed facet="wls.ear" version="10.3.4" />
								</faceted-project>
							]]>
							</content>
						</file>
						<file>
							<name>.settings/org.eclipse.wst.common.component</name>
							<content>
							<![CDATA[
								<project-modules id="moduleCoreId" project-version="1.5.0">
									<wb-module deploy-name="${project.artifactId}">
										<wb-resource deploy-path="/" source-path="/src/main/java" />
										<wb-resource deploy-path="/" source-path="/src/main/resources" />
										<property name="java-output-path" value="target/classes" />
									</wb-module>
								</project-modules>
							]]>
							</content>
						</file>
					</additionalConfig>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<profiles>
				<!-- Perfil para el deployment de los servicios -->
		<profile>
			<id>dev-deploy-view</id>
			<activation>
				<property>
					<name>dev-deploy</name>
					<value>view</value>
				</property>
			</activation>
			<build>
				<plugins>
					<!-- Weblogic Deployment Plug-In -->
			<plugin>
				<groupId>com.oracle.weblogic</groupId>
				<artifactId>weblogic-maven-plugin</artifactId>
				<version>10.3.4</version>
				<configuration>
					<adminurl>t3://localhost:7001</adminurl>
					<user>weblogic</user>
					<password>weblogic1</password>
					<upload>false</upload>
					<action>deploy</action>
					<remote>false</remote>
					<verbose>true</verbose>
					<source>${project.build.directory}/${project.build.finalName}.${project.packaging}</source>
					<name>${project.build.finalName}</name>
					<targets>AdminServer</targets>
					<nostage>true</nostage>
				</configuration>

				<executions>
					<execution>
						<phase>install</phase>
						<goals>
							<goal>deploy</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
				</plugins>			
			</build>
		</profile>
	
		<!-- Perfil para el deployment de los servicios REMOTO -->
		<profile>
			<id>dev-deploy-all-deprecated</id>
			<activation>
				<property>
					<name>dev-deploy-all-deprecated</name>
				</property>
			</activation>
			<build>
				<plugins>
					<!-- Weblogic Deployment Plug-In -->
			<plugin>
				<groupId>com.oracle.weblogic</groupId>
				<artifactId>weblogic-maven-plugin</artifactId>
				<version>10.3.4</version>
				<configuration>
					<adminurl>t3://172.24.116.38:11000</adminurl>
					<user>admin_wldldev</user>
					<password>wldldev_admin</password>
					<upload>true</upload>
					<action>deploy</action>
					<remote>true</remote>
					<verbose>true</verbose>
					<source>${project.build.directory}/${project.build.finalName}.${project.packaging}</source>
					<name>${project.build.finalName}</name>
					<nostage>true</nostage>
					<targets>c_dlweb</targets>
				</configuration>

				<executions>
					<execution>
						<phase>install</phase>
						<goals>
							<goal>deploy</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
				</plugins>			
			</build>
		</profile>
		
		
		<!-- Perfil para Remover los deploys en el ambiente de Desarrollo IMSS -->
		<profile>
			<id>dev-remove-all-deprecated</id>
			<activation>
				<property>
					<name>dev-remove-all-deprecated</name>
				</property>
			</activation>
			<build>
				<plugins>
					<!-- Weblogic Deployment Plug-In -->
			<plugin>
				<groupId>com.oracle.weblogic</groupId>
				<artifactId>weblogic-maven-plugin</artifactId>
				<version>10.3.4</version>
				<configuration>
					<adminurl>t3://172.24.116.38:11000</adminurl>
					<user>admin_wldldev</user>
					<password>wldldev_admin</password>
					<name>${project.build.finalName}</name>
					<targets>c_dlweb</targets>
				</configuration>

				<executions>
					<execution>
						<phase>install</phase>
						<goals>
							<goal>undeploy</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
				</plugins>			
			</build>
		</profile>
	</profiles>
</project>
