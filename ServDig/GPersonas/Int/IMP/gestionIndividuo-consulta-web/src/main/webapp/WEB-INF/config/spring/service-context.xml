  		<property name="businessInterface" value="mx.gob.imss.ctirss.delta.gestion.individuo.service.business.ComplementarCalificacionPersonaFisicaServiceBusinessRemote"/>
  		<property name="jndiTemplate" ref="serviceRepository" />
	</bean>
	
	<!-- Servicio de complementar las calificaciones de la persona fisica.  -->
	<bean id="localizarPersonaFisicaEnEntidadesExternasServiceBusiness" class="org.springframework.ejb.access.SimpleRemoteStatelessSessionProxyFactoryBean">
  		<property name="jndiName" value="localizarPersonaFisicaEnEntidadesExternasServiceBusiness#mx.gob.imss.ctirss.delta.gestion.individuo.service.business.LocalizarPersonaFisicaEnEntidadesExternasServiceBusinessRemote"/>
  		<property name="businessInterface" value="mx.gob.imss.ctirss.delta.gestion.individuo.service.business.LocalizarPersonaFisicaEnEntidadesExternasServiceBusinessRemote"/>
  		<property name="jndiTemplate" ref="serviceRepository" />
	</bean>
	
	<!-- Servicio para obtener las calificaciones vigentes de una persona fisica -->
	<bean id="calificacionesPersonaBusinessService" class="org.springframework.ejb.access.SimpleRemoteStatelessSessionProxyFactoryBean">
  		<property name="jndiName" value="calificacionesPersonaBusinessService#mx.gob.imss.ctirss.delta.gestion.individuo.service.business.CalificacionesPersonaBusinessServiceRemote"/>
  		<property name="businessInterface" value="mx.gob.imss.ctirss.delta.gestion.individuo.service.business.CalificacionesPersonaBusinessServiceRemote"/>
  		<property name="jndiTemplate" ref="serviceRepository" />
	</bean>

	<!-- PERONA MORAL -->
	
	<!-- Servicio de consulta de personas MORAL.  -->
