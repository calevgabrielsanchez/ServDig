	<bean id="localizarPersonaMoralEnEntidadesExternasServiceBusiness" class="org.springframework.ejb.access.SimpleRemoteStatelessSessionProxyFactoryBean">
  		<property name="jndiName" value="localizarPersonaMoralEnEntidadesExternasServiceBusiness#mx.gob.imss.ctirss.delta.gestion.individuo.service.business.LocalizarPersonaMoralEnEntidadesExternasServiceBusinessRemote"/>
  		<property name="businessInterface" value="mx.gob.imss.ctirss.delta.gestion.individuo.service.business.LocalizarPersonaMoralEnEntidadesExternasServiceBusinessRemote"/>
  		<property name="jndiTemplate" ref="serviceRepository" />
	</bean>
	
	<bean id="personaMoralBusiness" class="org.springframework.ejb.access.SimpleRemoteStatelessSessionProxyFactoryBean">
		<property name="jndiName" value="personaMoralBusiness#mx.gob.imss.ctirss.gestionpersonas.servicios.business.PersonaMoralBusinessRemote" />
		<property name="businessInterface" value="mx.gob.imss.ctirss.gestionpersonas.servicios.business.PersonaMoralBusinessRemote" />
		<property name="jndiTemplate" ref="serviceRepository" />
	</bean>
	
