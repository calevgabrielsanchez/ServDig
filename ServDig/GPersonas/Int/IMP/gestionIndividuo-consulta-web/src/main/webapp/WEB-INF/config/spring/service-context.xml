		<property name="businessInterface" value="mx.gob.imss.ctirss.gestionpersonas.servicios.business.SolicitudPersonaBusinessRemote" />
		<property name="jndiTemplate" ref="serviceRepository" />
	</bean>

	<!-- Servicios afiliacion patrones-->
	<bean id="solicitudBusiness" class="org.springframework.ejb.access.SimpleRemoteStatelessSessionProxyFactoryBean">
		<property name="jndiName" value="solicitudBusiness#mx.gob.imss.ctirss.delta.gestion.solicitud.service.interfaces.SolicitudBusinessRemote" />
		<property name="businessInterface" value="mx.gob.imss.ctirss.delta.gestion.solicitud.service.interfaces.SolicitudBusinessRemote" />
