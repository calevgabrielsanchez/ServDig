	</bean>
	
	<!-- Servicio de complementar las calificaciones de la persona fisica.  -->
	<bean id="complementarCalificacionPersonaFisicaServiceBusiness" class="org.springframework.ejb.access.SimpleRemoteStatelessSessionProxyFactoryBean">
