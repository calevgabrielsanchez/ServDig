<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>mx.gob.imss.ctirss.delta.gestion.asegurado</groupId>
	<artifactId>gestionAsegurados-packing-web</artifactId>
	<version>2.2</version>

	<name>gestionAsegurados-packing-web</name>
	<url>http://maven.apache.org</url>
	<packaging>ear</packaging>

	<parent>
		<artifactId>gestionAsegurados</artifactId>
		<groupId>mx.gob.imss.ctirss.delta.gestion.asegurado</groupId>
		<version>2.2</version>
	</parent>

	<dependencies>
		<!-- Aplicacion Web (Front) -->
		<dependency>
			<groupId>mx.gob.imss.ctirss.delta.gestion.asegurado</groupId>
			<artifactId>gestionAsegurados-web</artifactId>
			<version>${delta.asegurados}</version>
			<type>war</type>
		</dependency>

		<!-- Aplicacion Web Externo(Front) -->
		<dependency>
			<groupId>mx.gob.imss.ctirss.delta.gestion.asegurado</groupId>
			<artifactId>gestionAsegurados-web-externo</artifactId>
			<version>${delta.asegurados}</version>
			<type>war</type>
		</dependency>

		<!-- WAR'S DE OTROS MODULOS. MEDIOS DE CONTACTO. -->
		<dependency>
			<groupId>mx.gob.imss.ctirss.delta.gestion.medio.contacto</groupId>
			<artifactId>gestionMediosContacto-web</artifactId>
			<version>${delta.medioscontacto}</version>
			<type>war</type>
		</dependency>

		<!-- WAR'S DE OTROS MODULOS. DOMICILIOS -->
		<dependency>
			<groupId>mx.gob.imss.ctirss.delta.gestion.domicilio</groupId>
			<artifactId>gestionDomicilios-web</artifactId>
			<version>${delta.domicilios}</version>
			<type>war</type>
		</dependency>

		<!-- DEPENDENCIAS DE GESTION-INDIVIDUO -->
		<dependency>
			<groupId>mx.gob.imss.ctirss.delta.gestion.individuo.web</groupId>
			<artifactId>gestionIndividuo-web</artifactId>
			<type>war</type>
			<version>${delta.personas}</version>
		</dependency>

		<dependency>
			<groupId>mx.gob.imss.ctirss.delta.gestion.individuo.web</groupId>
			<artifactId>gestionIndividuo-consulta-web</artifactId>
			<type>war</type>
			<version>${delta.personas}</version>
		</dependency>

		<!-- WAR DE GESTION SOLICITUD -->
		<dependency>
			<groupId>mx.gob.imss.ctirss.delta.gestion.solicitud</groupId>
			<artifactId>gestionSolicitud-web</artifactId>
			<version>${gestion.solicitud.version}</version>
			<type>war</type>
		</dependency>
	</dependencies>

	<build>
		<plugins>

			<!-- Maven EAR Plug-In -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-ear-plugin</artifactId>
				<version>2.6</version>
				<configuration>
					<version>5</version>
					<defaultLibBundleDir>lib</defaultLibBundleDir>
				</configuration>
			</plugin>

			<!-- Maven Properties Plug-In -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>properties-maven-plugin</artifactId>
				<version>1.0-alpha-1</version>
				<executions>
					<execution>
						<phase>initialize</phase>
						<goals>
							<goal>read-project-properties</goal>
						</goals>
						<configuration>
							<files>
								<file>configuracion-local.properties</file>
							</files>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Habilita los facets y natures para que el eclipse reconoza el proyecto 
				como de tipo de EAR. -->
			<plugin>
				<artifactId>maven-eclipse-plugin</artifactId>
				<configuration>
					<additionalBuildcommands>
						<buildCommand>
							<name>org.eclipse.jdt.core.javabuilder</name>
						</buildCommand>
						<buildCommand>
							<name>org.eclipse.wst.common.project.facet.core.builder</name>
						</buildCommand>
						<buildCommand>
							<name>org.eclipse.wst.validation.validationbuilder</name>
						</buildCommand>
					</additionalBuildcommands>

					<additionalProjectnatures>
						<projectnature>org.eclipse.wst.common.project.facet.core.nature</projectnature>
						<projectnature>org.eclipse.jdt.core.javanature</projectnature>
						<projectnature>org.eclipse.wst.common.modulecore.ModuleCoreNature</projectnature>
						<projectnature>org.eclipse.jem.workbench.JavaEMFNature</projectnature>
					</additionalProjectnatures>

					<additionalConfig>
						<file>
							<name>.settings/org.eclipse.wst.common.project.facet.core.xml</name>
							<content>
							<![CDATA[
								<faceted-project>
									<runtime name="Weblogic Runtime" />
									<fixed facet="jst.ear" />
									<fixed facet="jst.java" />
									<installed facet="jst.java" version="6.0" />
									<installed facet="jst.ear" version="5.0" />
									<installed facet="wls.ear" version="10.3.4" />
								</faceted-project>
							]]>
							</content>
						</file>

						<file>
							<name>.settings/org.eclipse.wst.common.component</name>
							<content>
							<![CDATA[
								<project-modules id="moduleCoreId" project-version="1.5.0">
									<wb-module deploy-name="${project.artifactId}">
										<wb-resource deploy-path="/" source-path="/src/main/java" />
										<wb-resource deploy-path="/" source-path="/src/main/resources" />
										<property name="java-output-path" value="target/classes" />
									</wb-module>
								</project-modules>
							]]>
							</content>
						</file>
					</additionalConfig>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Perfil para el deployment de los servicios -->
		<profile>
			<id>dev-deploy-view</id>
			<activation>
				<property>
					<name>dev-deploy</name>
					<value>view</value>
				</property>
			</activation>
			<build>
				<plugins>
					<!-- Weblogic Deployment Plug-In -->
					<plugin>
						<groupId>com.oracle.weblogic</groupId>
						<artifactId>weblogic-maven-plugin</artifactId>
						<version>10.3.4</version>
						<configuration>
							<adminurl>t3://172.24.116.38:11000</adminurl>
							<user>admin_wldldev</user>
							<password>wldldev_admin</password>
							<upload>true</upload>
							<action>deploy</action>
							<remote>true</remote>
							<verbose>true</verbose>
							<source>${project.build.directory}/${project.build.finalName}.${project.packaging}</source>
							<name>${project.build.finalName}</name>
							<targets>c_dlweb_03</targets>
							<nostage>true</nostage>
						</configuration>

						<executions>
							<execution>
								<phase>install</phase>
								<goals>
									<goal>deploy</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- Perfil para el deployment en QA -->
		<profile>
			<id>qa-deploy-view</id>
			<activation>
				<property>
					<name>qa-deploy-view</name>
				</property>
			</activation>
			<build>
				<plugins>
					<!-- Weblogic Deployment Plug-In -->
					<plugin>
						<groupId>com.oracle.weblogic</groupId>
						<artifactId>weblogic-maven-plugin</artifactId>
						<version>10.3.4</version>
						<configuration>
							<adminurl>t3://172.24.116.37:11050</adminurl>
							<user>admin_wlmovpat</user>
							<password>wlmovpat_admin</password>
							<upload>true</upload>
							<action>deploy</action>
							<remote>true</remote>
							<verbose>true</verbose>
							<source>${project.build.directory}/${project.build.finalName}.${project.packaging}</source>
							<name>${project.build.finalName}</name>
							<targets>s_wlmovpat_01,s_wlmovpat_02</targets>
						</configuration>

						<executions>
							<execution>
								<phase>install</phase>
								<goals>
									<goal>deploy</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>



		<!-- Perfil para el deployment de los servicios REMOTO -->
		<profile>
			<id>prod-deploy-all</id>
			<activation>
				<property>
					<name>prod-deploy-all</name>
				</property>
			</activation>
			<build>
				<plugins>
					<!-- Weblogic Deployment Plug-In -->
					<plugin>
						<groupId>com.oracle.weblogic</groupId>
						<artifactId>weblogic-maven-plugin</artifactId>
						<version>10.3.4</version>
				
				
						
						<configuration>
					<adminurl>t3://172.24.116.47:11000</adminurl>
					<user>admin_clasificacion</user>
					<password>clasificacion_admin</password>
					<upload>true</upload>
					<action>deploy</action>
					<remote>true</remote>
					<verbose>true</verbose>
					<source>${project.build.directory}/${project.build.finalName}.${project.packaging}</source>
					<name>${project.build.finalName}</name>
					<targets>c_clasificacion_01</targets>
					<nostage>true</nostage>
				</configuration>

						<executions>
							<execution>
								<phase>install</phase>
								<goals>
									<goal>deploy</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- Perfil para Remover los deploys en el ambiente de Desarrollo IMSS -->
		<profile>
			<id>prod-remove-all</id>
			<activation>
				<property>
					<name>prod-remove-all</name>
				</property>
			</activation>
			<build>
				<plugins>
					<!-- Weblogic Deployment Plug-In -->
					<plugin>
						<groupId>com.oracle.weblogic</groupId>
						<artifactId>weblogic-maven-plugin</artifactId>
						<version>10.3.4</version>
					
						<configuration>
							<adminurl>t3://172.24.116.47:11000</adminurl>
							<user>admin_clasificacion</user>
							<password>clasificacion_admin</password>
							<name>${project.build.finalName}</name>
							<targets>c_clasificacion_01</targets>
						</configuration>

						<executions>
							<execution>
								<phase>install</phase>
								<goals>
									<goal>undeploy</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
