<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>mx.gob.imss.ctirss.delta.gestion.asegurado</groupId>
  <artifactId>gestionAsegurados</artifactId>
  <packaging>pom</packaging>
  <version>2.2-SNAPSHOT</version>
  <name>Modulo Gestion de Asegurados Delta IMSS</name>
  <url>http://11.254.14.212/gestionAsegurados-web</url>

  <properties>
    <skipTests>false</skipTests>
    <project.build.sourceEncoding>iso-8859-1</project.build.sourceEncoding>
    <org.hibernate.version>3.6.9.Final</org.hibernate.version>
    <org.slf4j.version>1.6.1</org.slf4j.version>
    <org.log4j.version>1.2.16</org.log4j.version>
    <junit.version>4.8.2</junit.version>
    <org.springframework.version>3.0.5.RELEASE</org.springframework.version>
    <tiles.framework.version>2.2.1</tiles.framework.version>
	<org.cometd.java.version>2.5.1</org.cometd.java.version>

    <!-- DEPENDENCIAS DE OTROS PROYECTOS -->
	<delta.framework.version>2.6-SNAPSHOT</delta.framework.version>
	<delta.framework.comboSelect>2.0-SNAPSHOT</delta.framework.comboSelect>
    <delta.medioscontacto>2.3-SNAPSHOT</delta.medioscontacto>
    <delta.documentos.probatorios>2.4-SNAPSHOT</delta.documentos.probatorios>
    <delta.domicilios>2.4-SNAPSHOT</delta.domicilios>
    <delta.personas>2.4-SNAPSHOT</delta.personas>
    <gestion.solicitud.version>2.2-SNAPSHOT</gestion.solicitud.version>
	<delta.clasificacion.empr>2.4-SNAPSHOT</delta.clasificacion.empr>
	<delta.asegurados>2.2-SNAPSHOT</delta.asegurados>
	<gestion.patronal.version>2.4-SNAPSHOT</gestion.patronal.version>
	<delta.dhabiente>2.2-SNAPSHOT</delta.dhabiente>
  </properties>

  <build>
    <!-- To define the plugin version in your parent POM -->
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>3.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <skipTests>true</skipTests>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- for use JVM 1.6 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <source>1.6</source>
          <target>1.6</target>
          <encoding>${project.build.sourceEncoding}</encoding>
        </configuration>
      </plugin>

      <!-- Relase Plugin-->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-release-plugin</artifactId>
        <version>2.3.2</version>
        <configuration>
          <tagBase>http://11.254.16.21/svn/base_arquitectura_delta/codigo/tags/</tagBase>
          <tag>${project.artifactId}-${project.version}</tag>
        </configuration>
      </plugin>
      
      
 
      
    </plugins>

    <!--Extension necesaria para el deploy (instalacion) de los
      componentes en el repositorio central -->
    <extensions>
      <extension>
        <groupId>org.apache.maven.wagon</groupId>
        <artifactId>wagon-ftp</artifactId>
      </extension>
      <extension>
        <groupId>org.apache.maven.wagon</groupId>
        <artifactId>wagon-webdav</artifactId>
      </extension>
    </extensions>
  </build>

  <repositories>
    <repository>
      <id>ctirss</id>
      <name>CTIRSS repository</name>
      <layout>default</layout>
      <url>http://172.16.5.134:8080/repository/repo/</url>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>ctirss</id>
      <name>CTIRSS repository</name>
      <url>http://172.16.5.134:8080/repository/repo/</url>
      <layout>default</layout>
      <snapshots> </snapshots>
      <releases>
        <updatePolicy>never</updatePolicy>
      </releases>
    </pluginRepository>
  </pluginRepositories>

  <distributionManagement>
    <!-- use the following if you're not using a snapshot version. -->
    <repository>
      <id>ctirss-archiva</id>
      <name>CTIRSS Repository Name</name>
      <url>dav:http://172.16.5.134:8080/repository/repo/</url>
    </repository>
    <snapshotRepository>
      <id>ctirss-archiva</id>
      <name>CTIRSS Repository Name</name>
      <url>dav:http://172.16.5.134:8080/repository/repo/</url>
    </snapshotRepository>
  </distributionManagement>

  <scm>
    <connection>scm:svn:http://11.254.16.21/svn/base_arquitectura_delta/codigo/trunk/gestion_domicilios/</connection>
    <developerConnection>scm:svn:http://11.254.16.21/svn/base_arquitectura_delta/codigo/trunk/gestion_domicilios/</developerConnection>
    <url>http://11.254.16.21/svn/base_arquitectura_delta/codigo/trunk/gestion_domicilios/</url>
  </scm>

  <profiles>
    
    <profile>
      <id>development-back</id>
      <activation>
        <property>
          <name>back</name>
        </property>
      </activation>
      <modules>
        <module>gestionAsegurados-interfaces-negocio</module>
        <module>gestionAsegurados-servicios-negocio-ejb</module>
        <module>gestionAsegurados-packing</module>
      </modules>
    </profile>

    <profile>
      <id>development-front</id>
      <activation>
        <property>
          <name>front</name>
        </property>
      </activation>
      <modules>
        <module>gestionAsegurados-web</module>
                <module>gestionAsegurados-web-externo</module>
        <module>gestionAsegurados-packing-web</module>
      </modules>
    </profile>

    <profile>
      <id>production</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <modules>
        <module>gestionAsegurados-interfaces-negocio</module>
        <module>gestionAsegurados-servicios-negocio-ejb</module>
        <module>gestionAsegurados-web</module>
                <module>gestionAsegurados-web-externo</module>
        <module>gestionAsegurados-packing</module>
        <module>gestionAsegurados-packing-web</module>
      </modules>
    </profile>
    
    
    
    
    
	<!--Perfil para el despliegue en DESARROLLO de la capa de la vista -->    
     <profile>
      <id>dev-deploy-view</id>
      <activation>
      	<property>
      		<name>dev-deploy</name>
      		<value>view</value>
      	</property>
      	</activation>
            <modules>
      		<module>gestionAsegurados-packing-web</module>
      </modules>
    </profile>
    
    <!--Perfil para el despliegue en DESARROLLO de la capa de los servicios  -->   
     <profile>
      <id>dev-deploy-services</id>
      <activation>
      	<property>
      		<name>dev-deploy</name>
      		<value>services</value>
      	</property>
      	</activation>
            <modules>
      			<module>gestionAsegurados-packing</module>
      		</modules>
    </profile>
    
    
    
    <!--Perfil para el despliegue en QA del proyecto  -->   
     <profile>
      <id>qa-deploy</id>
      <activation>
      	<property>
      		<name>qa-deploy</name>
      		
      	</property>
      	</activation>
            <modules>
      			<module>gestionAsegurados-packing</module>
      			<module>gestionAsegurados-packing-web</module>
      		</modules>
    </profile>

		<profile>
			<id>dev-deploy-all</id>
			<activation>
				<property>
					<name>dev-deploy-all</name>
				</property>
			</activation>
			<modules>
				<module>gestionAsegurados-packing</module>
				<module>gestionAsegurados-packing-web</module>
			</modules>
		</profile>

		<!--Perfil para el BORRADO en DESARROLLO de los despliegues -->
		<profile>
			<id>dev-deploy-remove</id>
			<activation>
				<property>
					<name>dev-remove-all</name>
					
				</property>
			</activation>
			<modules>
				<module>gestionAsegurados-packing</module>
				<module>gestionAsegurados-packing-web</module>
			</modules>
		</profile>
  </profiles>
</project>
