		<dependency>
			<groupId>mx.gob.imss.ctirss.delta.gestion.solicitud</groupId>
			<artifactId>gestionSolicitud-interfaces-negocio</artifactId>
			<version>${gestion.solicitud.version}</version>
		</dependency>
		
		<dependency>
              <groupId>mx.gob.imss.cit.clienteswebservices.boveda</groupId>
              <artifactId>WsBovedaLegadaIMSS-IPICYT</artifactId>
              <version>1.0</version>
		</dependency>

		
